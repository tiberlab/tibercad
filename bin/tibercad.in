#!/bin/bash

export TIBERCADROOT=@abs_top_builddir@

usage () {
  echo ""
  echo "Usage: tibercad [-d] [-g] <inputfile>"
  echo ""
  echo "   -d : run debug version"
  echo "   -g : run in debugger"
  echo ""
}

executable=tibercad
usegdb=0
n_mpi_procs=1

OPTERR=0
opts="dgn:"
while getopts $opts flag
do
  case "$flag" in
    d) executable=tibercad_dbg ;;

    g) usegdb=1 ;;

    n) n_mpi_procs=${OPTARG};
      : $(OMP_NUM_THREADS:-1);
      export OMP_NUM_THREADS ;;

    *) OPTIND=$(( $OPTIND - 1 )); break ;;
  esac
done

shift $(( $OPTIND - 1 ))

if [ $# -eq 0 ]
then
  usage
  exit 1
fi

if test "${MPI_HOSTFILE}x" != "x"
then
  mpi_opts=(--hostfile ${MPI_HOSTFILE})
fi


ARCH=`${TIBERCADROOT}/share/arch.sh`
SDKDIR=${TIBERCADROOT}/SDK

executable=${TIBERCADROOT}/${ARCH}/bin/${executable}
if [ ! -x ${executable} ]
then
  echo "${executable} does not exist"
  exit 1
fi

# stack size limit / VM may be too small ?
ulimit -v unlimited
ulimit -s unlimited
ulimit -c 0


if [ $usegdb -eq 1 ]
then
  gdb -nx -ex run --args ${executable} $@
else
  #${SDKDIR}/${ARCH}/bin/mpiexec -n ${n_mpi_procs} ${executable} $@
  @MPIEXEC@ -n ${n_mpi_procs} ${mpi_opts[*]}  ${executable} $@
fi
