#!/bin/bash

export TIBERCADROOT=@abs_top_builddir@

usage () {
  echo ""
  echo "Usage: tibercad [-d] [-g] <inputfile>"
  echo ""
  echo "   -d : run debug version"
  echo "   -g : run in debugger"
  echo ""
}

executable=tibercad
usegdb=0

OPTERR=0
opts="dg"
while getopts $opts flag
do
  case "$flag" in
    d) executable=tibercad_dbg ;;
    g) usegdb=1 ;;
    *) OPTIND=$(( $OPTIND - 1 )); break ;;
  esac
done

shift $(( $OPTIND - 1 ))

if [ $# -eq 0 ]
then
  usage
  exit 1
fi

ARCH=`${TIBERCADROOT}/share/arch.sh`

executable=${TIBERCADROOT}/${ARCH}/bin/${executable}
if [ ! -x ${executable} ]
then
  echo "${executable} does not exist"
  exit 1
fi

# stack size limit / VM may be too small ?
ulimit -v unlimited -s unlimited -c 0


if [ $usegdb -eq 1 ]
then
  gdb -nx -ex run --args ${executable} $@
else
  /usr/pack/tibercad_sdk-2.2-ma/build/petsc-3.0.0-p12/externalpackages/mpich2-1.0.8/bin/mpiexec -n 2 ${executable} $@
  #exec ${executable} $@
fi
