# SiN
#
# (copied from GaN)

structure = wz
dielectric = true

[lattice]
a = 0.3189
c = 0.5185

thermal_coefficient = 3.3e-6


[valenceband]
# One publication claims that GaN/SiN is type II
# E_v = 0.0
E_v = -1.8


[conductionband]
m_G = (0.202, 0.202, 0.206)


[bandgap]
# T = 0
Eg_G = 6

varshni_alpha_G = 0.909e-3
varshni_beta_G = 830


[kdotp]

A1 = -7.21
A2 = -0.44
A3 = 6.68
A4 = -3.46
A5 = -3.4
A6 = -4.9

delta_cr = 0.01
delta_s = 0.017


[deformation_potentials]
a_c = (-6.80, -6.80, -8.60)

D1 = -3.7
D2 = 4.5
D3 = 8.2
D4 = -4.1
D5 = -4.0
D6 = -5.5


[permittivity]
# static dielectric constant
permittivity = 7.5

# Optical dielectric constant @ 3.5 eV
optical_epsilon_x = 7.3
optical_epsilon_c = 7.3 




# stiffness data Ambacher theory1 
[elasticity]
C11 = 700.0
C12 = 270.0
C13 = 200.0
C33 = 810.0
C44 = 190.0

poisson = 0.27
young = 300

# piezoelectricity data  
[piezoelectricity]
e33 = 0
e31 = 0
e15 = 0

[pyroelectricity]
Pz = 0



#
# mobility
#

# constant ??
[mobility/constant]
mu_max = (100, 100.0)
exponent = (1.0, 2.1)


# doping dependent
[mobility/doping_dependent]
mobility_formula = 1
mumin1 = (85, 		33)
mumin2 = (75, 		0)
mu1    = (50, 		20)
Pc     = (6.5e15, 	5e15)
Cr     = (9.5e16, 	8e16)
Cs     = (7.2e19, 	8e20)
alpha  = (0.55, 	0.55)
beta   = (0.75, 	0.7)


# high field dependency
[mobility/field_dependent]
Vsat_Formula = 2
beta0    = (1.7, 	1.7)
A_vsat   = (1.9e+07, 	0.5000e+07)
B_vsat   = (0,		0)
vsat_min = (1.000e+07, 	1.000e+07)
betaexp  = (0,		0)


#
# recombination
#

# SRH recombination
[recombination/SRH]
Etrap  = 0.0
taumin = (0.0,		0.0)
taumax = (1.0e-9,	1.0e-9)
Nref   = (1.0e+16,	1.0e+16)
gamma  = (1,		1)
Talpha = (-1.5,		-1.5)
Tcoeff = (2.55,		2.55)


# direct
[recombination/direct]
C = 0.47e-10


[recombination/auger]
# R_Auger = ( C_n n + C_p p ) ( n p - ni_eff^2)
# with C_n,p = (A + B (T/T0) + C (T/T0)^2) (1 + H exp(-{n,p}/N0))
# The values below should be checked
A  = (1.0000e-34 ,	1.0000e-34)	# [cm^6/s]
B  = (0.0000e+00 ,	0.0000e+00)	# [cm^6/s]
C  = (0.0000e+00 ,	0.0000e+00)	# [cm^6/s]
H  = (0.0000e+00 ,	0.0000e+00)	# [1]
N0 = (1.0000e+18 ,	1.0000e+18)	# [cm^(-3)]



#Lattice thermal conductivity 
[thermal_conductivity/constant]
ThermCond = 20



#Atomistic structure informations
#
[atomistic_structure]
lattice_type = hexagonal

#Basis 

#Number of basis specie
n_basis_specie = 2
#Number of basis atoms for any specie
n_1 = 2
n_2 = 2
#Basis vectors T_"specie"_"#of atom"_"direction"
T_1_1_a = 0.333333
T_1_1_b = 0.666666
T_1_1_c = 0.0
T_1_2_a = 0.666666
T_1_2_b = 0.333333
T_1_2_c = 0.5
T_2_1_a = 0.333333
T_2_1_b = 0.666666
T_2_1_c = 0.375000
T_2_2_a = 0.666666
T_2_2_b = 0.333333
T_2_2_c = 0.875000

#Name of species
specie_1 = Si 
specie_2 = N

[densityfunctional_tb]

dataset = nitrides

