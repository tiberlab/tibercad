# AlSb-zb
#

structure = zb


# lattice constant
[lattice] # [1]
a = 0.61355


[valenceband] # [1]
E_v = -0.41


[conductionband] # [1]
m_G = 0.14
m_L_l = 1.64
m_L_t = 0.23
m_X_l = 1.357
m_X_t = 0.123



[bandgap] # [1]
# 0 K values
Eg_G = 2.386
Eg_L = 2.329
Eg_X = 1.696

varshni_alpha_G = 0.42e-3
varshni_beta_G =  140
varshni_alpha_X = 0.39e-3
varshni_beta_X =  140
varshni_alpha_L = 0.58e-3
varshni_beta_L =  140


[kdotp] # [1]
delta = 0.676

gamma1 = 5.18
gamma2 = 1.19
gamma3 = 1.97


[deformation_potentials] # [1]
a_c = -4.5 # [1]
abs_def_pot_L = -2.91  # [3]
abs_def_pot_X = 1.91  # [3]
uniax_def_pot_L = 15  # [3]
uniax_def_pot_X = 6  # [3]

a_v = 1.4
b = -1.35
d = -4.3


[permittivity] # [3]
# static dielectric constant
permittivity = 12.04

optical_epsilon = 10.24


# stiffness data
[elasticity] # [1]
C11 = 87.69
C12 = 43.41
C44 = 40.76

# piezoelectricity
[piezoelectricity]
e14 = -0.055  # [3]


# mobility
[mobility/constant]
mu_max = (200.0, 375.0) 
exponent = (1.5, 1.5) # dummy values

[mobility/doping_dependent] # [5]
mobility_formula = 2
mumin = (3.0e+03,	200.0)
am    = (0.0,	 	0.0)
mud   = (7.4e4,	 	500)
ad    = (-1.538,	-2.108)
N0    = (2.7e+17, 	7.0e+17)
aN    = (5.0,	 	3.45)
A     = (0.9187,	0.521)
aA    = (1.1061,	0.1077)


# high field dependency
[mobility/field_dependent] # dummy values
Vsat_Formula = 2
beta0    = (2.0, 	2.0)
betaexp  = (0,		0)
A_vsat   = (1.0e+07, 	1.0e+07)
B_vsat   = (0,		0)
vsat_min = (5.0e+05, 	5.0e+05)



# SRH recombination
[recombination/SRH] # dummy values
Etrap    = 0.0
taumin = (0.0, 		0.0)
taumax = (1.0e-9, 	1.0e-9)
Nref   = (1.0e+16, 	1.0e+16)
gamma  = (1, 		1)
Talpha = (0,		0)
Tcoeff = (0,		0)


# direct recombination
[recombination/direct] 
C = 1e-13 # [cm^3/s]


[recombination/auger] 
# R_Auger = ( C_n n + C_p p ) ( n p - ni_eff^2)
# with C_n,p = (A + B (T/T0) + C (T/T0)^2) (1 + H exp(-{n,p}/N0))
#
A	= (5.0000e-30 ,	5.0000e-30)	# [cm^6/s]
B	= (0.0000e+00 ,	0.0000e+00)	# [cm^6/s]
C	= (0.0000e+00 ,	0.0000e+00)	# [cm^6/s]
H	= (0.0000e+00 ,	0.0000e+00)	# 
N0	= (1.0000e+18 ,	1.0000e+18)	# [cm^(-3)]



[thermal_conductivity/constant] 
ThermCond = 0.7





