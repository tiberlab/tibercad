# NaCl 

structure = zb 

[lattice]
a = 0.56400

[valenceband] # 
E_v = -9 #prova


# (for now set it to the kp result)
m_dos = 3.0

[conductionband] # [3]
m_G = 5.6

[bandgap] # [3]
# T=0 K
Eg_G = 7.0 #prova



[permittivity] # [the engineering toolbox,internet]
permittivity = 11

# mobility
[mobility/constant]
mu_max   = (0.05,   0.05) # 
exponent = (   2.5,   2.2)

# radiative recombination
[recombination/direct]
C = 1.1e-14

# SRH recombination
[recombination/SRH]
Etrap  = 0.0
taumin = (0.0,		0.0)
taumax = (1.0e-5,	3.0e-6)
Nref   = (1.0e+16,	1.0e+16)
gamma  = (1,		1)
Talpha = (-1.5,		-1.5)
Tcoeff = (2.55,		2.55)

# Lattice thermal conductivity
[thermal_conductivity/constant]
ThermCond = 150.0 #w/m K

[sound_velocity/constant]
vg = 8.433e3 #m/s

[heat_capacity/constant]
C = 1.66E6 # j/m3K


#Thermoelectric power [V/k]
[thermoelectric_power/constant]
eTEpower = -0.001
hTEpower =  0.001


 #[3]  EEs 2012,5,5994
 #[4]  J.App.Phys. 90 5 2001
 #[5]  J.App.Phys. 90 5 2001 
 #

[atomistic_structure]
lattice_type = cubic 

#Number of basis specie
n_basis_specie = 2
#Name of species
specie_1 = Na 
specie_2 = Cl
 
#Number of basis atoms for any specie
n_1 = 4
n_2 = 4

#Basis vectors T_"specie"_"#of atom"_"direction"
T_1_1 = ( 0.0   0.0   0.0 )
T_1_2 = ( 0.50  0.50  0.0 )
T_1_3 = ( 0.0   0.50  0.50 )
T_1_4 = ( 0.50  0.0   0.50 )
T_2_1 = ( 0.50  0.0  0.0 )
T_2_2 = ( 0.0  0.50  0.0 )
T_2_3 = ( 0.0  0.0  0.50 )
T_2_4 = ( 0.50  0.50  0.50 )

