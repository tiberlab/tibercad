# GaSb-zb
#

structure = zb


# lattice constant
[lattice] # [1]
a = 0.60959


[valenceband] # [1]
E_v = -0.03


[conductionband] # [1]
m_G = 0.039
m_L_l = 1.3
m_L_t = 0.1
m_X_l = 1.51
m_X_t = 0.22



[bandgap] # [1]
# 0 K values
Eg_G = 0.812
Eg_L = 0.875
Eg_X = 1.141

varshni_alpha_G = 0.417e-3
varshni_beta_G =  140
varshni_alpha_X = 0.475e-3
varshni_beta_X =  94
varshni_alpha_L = 0.597e-3
varshni_beta_L =  140


[kdotp] # [1]
delta = 0.76

gamma1 = 13.4
gamma2 = 4.7
gamma3 = 6.0


[deformation_potentials] # [1]
a_c = -7.5 # [1]
abs_def_pot_L = -4.38  # [3]
abs_def_pot_X = -0.2  # [3]
uniax_def_pot_L = 15  # [3]
uniax_def_pot_X = 6.46  # [3]

a_v = 0.8 # [1]
b = -2.0
d = -4.7


[permittivity] # [3]
# static dielectric constant
permittivity = 15.69

optical_epsilon = 14.44


# stiffness data
[elasticity] # [1]
C11 = 88.42
C12 = 40.26
C44 = 43.22

# piezoelectricity
[piezoelectricity]
e14 = -0.172  # [3]


# mobility
[mobility/constant]
mu_max = (3000.0, 1000.0) # [4]
exponent = (1.5, 1.5) # dummy values

[mobility/doping_dependent] # [5]
mobility_formula = 2
mumin = (3.0e+03,	200.0)
am    = (0.0,	 	0.0)
mud   = (7.4e4,	 	500)
ad    = (-1.538,	-2.108)
N0    = (2.7e+17, 	7.0e+17)
aN    = (5.0,	 	3.45)
A     = (0.9187,	0.521)
aA    = (1.1061,	0.1077)


# high field dependency
[mobility/field_dependent] # dummy values
Vsat_Formula = 2
beta0    = (2.0, 	2.0)
betaexp  = (0,		0)
A_vsat   = (1.0e+07, 	1.0e+07)
B_vsat   = (0,		0)
vsat_min = (5.0e+05, 	5.0e+05)



# SRH recombination
[recombination/SRH] # dummy values
Etrap    = 0.0
taumin = (0.0, 		0.0)
taumax = (1.0e-9, 	1.0e-9)
Nref   = (1.0e+16, 	1.0e+16)
gamma  = (1, 		1)
Talpha = (0,		0)
Tcoeff = (0,		0)


# direct recombination
[recombination/direct] # [4]
C = 1e-10 # [cm^3/s]


[recombination/auger] # [4]
# R_Auger = ( C_n n + C_p p ) ( n p - ni_eff^2)
# with C_n,p = (A + B (T/T0) + C (T/T0)^2) (1 + H exp(-{n,p}/N0))
#
A	= (5.0000e-30 ,	5.0000e-30)	# [cm^6/s]
B	= (0.0000e+00 ,	0.0000e+00)	# [cm^6/s]
C	= (0.0000e+00 ,	0.0000e+00)	# [cm^6/s]
H	= (0.0000e+00 ,	0.0000e+00)	# 
N0	= (1.0000e+18 ,	1.0000e+18)	# [cm^(-3)]



[thermal_conductivity/constant] # [4]
ThermCond = 0.32



#Atomistic structure informations
#
[atomistic_structure]
lattice_type = fcc

#Basis 

#Number of basis specie
n_basis_specie = 2
#Number of basis atoms for any specie
n_1 = 1
n_2 = 1
#Basis vectors T_"specie"_"#of atom"_"direction"
T_1_1_a = 0.0
T_1_1_b = 0.0
T_1_1_c = 0.0
T_2_1_a = 0.25
T_2_1_b = 0.25
T_2_1_c = 0.25

#Name of species
specie_1 = Ga 
specie_2 = Sb 



