# Tight binding parameters sp3s*
# Klimeck-Boykin, Superlatt&Microstr 27 (2000), 749

# material type : 'simple' / 'binary' / 'ternary' / 'quaternary'

material type = 'binary'

# lattice type : 'face centered cubic' / 'hexagonal'

lattice type = 'face centered cubic'

# lattice parameters ( in Angtroms )

lattice parameters =   5.6532D0   5.6532D0   5.6532D0

# 0 = no internal strain / 1 = maximal internal strain

internal strain parameter = 0.00D0


# basis type : 'zinc-blende' / 'wurtzite'

basis type = 'zinc-blende'

number of ions = 2
ions = 'Al' 'As'
Al valence = 4 
As valence = 4

# spin orbit

number of spin-orbit parameters per ion = 1 1 

As spin orbit
'p' 0.09715D0

Al spin orbit
'p' 0.01051D0

# onsite ETB

number of orbitals per ion = 3 3  

# Al = c; As = a

As onsite
's'    -3.21537D0  1
'p'    -0.09711D0  3
's*'   12.05550D0  1

Al onsite
's'    -9.52462D0  1
'p'     4.97139D0  3
's*'    3.99445D0  1

# offset is used only to align the valence band-edge at 0.0 
Al offset = 0.D0
As offset = 0.D0


# strain coefficient for the d orbitals
Al b_d parameter = 0.000D0
As b_d parameter = 0.000D0

# ETB couplings

number of pairs = 1

pair 1 = 'As' 'Al' 10 1

As Al coupling 1
'sss'     -2.21065D0   3.76D0 
'sps'      1.04995D0   2.00D0
'pss'      5.71714D0   2.00D0
's*ps'     2.52553D0   2.00D0 
'ps*s'     1.99218D0   2.00D0
'pps'      2.12616D0   2.16D0
'ppp'     -1.06845D0   1.98D0
'ss*s'     0.00000D0   0.00D0
's*ss'     0.00000D0   0.00D0
's*s*s'    0.00000D0   0.00D0

As Al pair reference distance 1 = 2.447907D0

# sss = ss/4 
# sps = sp/4*sqrt(3)
# pss = ps/4*sqrt(3) 
# ppp = (xx - xy)/4
# pps = (xx + 2*xy)/4
# xx 3.008
# xy 6.535
# so = Delta/3
