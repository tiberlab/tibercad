# Tight binding parameters (c) Tan2016PRB
scheme = 'tan'

# material type : 'simple' / 'binary' / 'ternary' / 'quaternary'
material type = 'binary'

# lattice type : 'face centered cubic' / 'hexagonal'
lattice type = 'face centered cubic'

# lattice parameters ( in Angtroms )
lattice parameters =   6.0959D0   6.0959D0   6.0959D0

# 0 = no internal strain / 1 = maximal internal strain

#internal strain parameter = 0.60D0
internal strain parameter = 0.00D0


# basis type : 'zinc-blende' / 'wurtzite'
basis type = 'zinc-blende'

number of ions = 2
ions = 'Ga' 'Sb'

Ga valence = 4
Sb valence = 4

# spin orbit
number of spin-orbit parameters per ion = 2 2

Ga spin orbit
'p' 0.024372329325D0
'd' 0.000000000000D0

Sb spin orbit
'p' 0.287119937635D0
'd' 0.000000000000D0

# bare onsite ETB
number of orbitals per ion = 4 4

Ga onsite
's'    1.4880595906D0    1
'p'    8.6528182658D0    3
's*'   12.7318779333D0   1
'd'    13.5576147109D0   5

Sb onsite
's'    -2.3695080760D0   1
'p'     6.8993676092D0   3
's*'   12.6420868695D0   1
'd'    13.1316065371D0   5

#Common offset
Ga offset = -5.72484D0
Sb offset = -5.72484D0

# strain coefficient for the d orbitals
Ga b_d parameter = 0.370D0
Sb b_d parameter = 0.370D0

# ETB couplings

number of pairs = 1

pair 1 = 'Sb' 'Ga' 21 1

