Sb Al pair reference distance 1 = 2.447951D0


# onsite corrections: I, lambda_I
onsite correction 1 = 'Sb' 'Al' 8 1

Sb Al onsite correction 1
'sca'     3.9775D0   1.4438D0
'pca'     3.5125D0   1.3917D0
's*ca'    6.1929D0   0.8225D0
'dca'     3.4694D0   1.3307D0
'sac'     3.1709D0   1.5553D0
'pac'     2.9550D0   1.4960D0
's*ac'    6.5076D0   1.0632D0
'dac'     3.6241D0   1.4126D0


# SO correction
SO correction 1 = 'Sb' 'Al' 4 1

Sb Al SO correction 1
'pca'   0.0019D0
'dca'   0.0000D0
'pac'   0.0045D0
'dac'   0.0000D0


# Offset correction: O, lambda_O, delta_d
offset correction 1 = 'Sb' 'Al' 1 1

Sb Al offset correction 1
-2.7374D0   1.2930D0   -0.0081D0

# intra-atomic couplings

intra 1 = 'Sb' 'Al' 14 1
Sb Al intra 1
