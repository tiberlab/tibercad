# Tight binding parameters (c) Tan2016PRB
scheme = 'tan'

# material type : 'simple' / 'binary' / 'ternary' / 'quaternary'
material type = 'binary'

# lattice type : 'face centered cubic' / 'hexagonal'
lattice type = 'face centered cubic'

# lattice parameters ( in Angtroms )
lattice parameters =   6.4794D0   6.4794D0   6.4794D0

# 0 = no internal strain / 1 = maximal internal strain

#internal strain parameter = 0.60D0
internal strain parameter = 0.17D0
# follow Cousins1991

# basis type : 'zinc-blende' / 'wurtzite'
basis type = 'zinc-blende'

number of ions = 2
ions = 'In' 'Sb'

In valence = 4
Sb valence = 4

# spin orbit
number of spin-orbit parameters per ion = 2 2

In spin orbit
'p' 0.13006330281D0
'd' 0.0000D0

Sb spin orbit
'p' 0.287119937635D0
'd' 0.0000D0

# bare onsite ETB
number of orbitals per ion = 4 4
	
In onsite
's'     1.6787405569D0   1
'p'     8.9987817826D0   3
's*'   12.7742036183D0   1
'd'    13.5664716117D0   5

Sb onsite
's'    -2.3695080760D0   1
'p'     6.8993676092D0   3
's*'   12.6420868695D0   1
'd'    13.1316065371D0   5

In offset = -5.54573D0
Sb offset = -5.54573D0


# strain coefficient for the d orbitals
In b_d parameter = 0.302D0
Sb b_d parameter = 0.302D0

# ETB couplings

number of pairs = 1

pair 1 = 'Sb' 'In' 21 1

