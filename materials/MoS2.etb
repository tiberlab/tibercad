# Tight binding parameters PRB v69 p115201

# material type : 'simple' / 'binary' / 'ternary' / 'quaternary'
material type = 'binary'

# lattice type : 'face centered cubic' / 'hexagonal'
lattice type = 'hexagonal'

# lattice parameters ( in Angtroms )
lattice parameters =   3.16D0   3.16D0   10D0

# 0 = no internal strain / 1 = maximal internal strain
#internal strain parameter = 0.60D0
internal strain parameter = 0.00D0

# basis type : 'zinc-blende' / 'diamond' / 'wurtzite'
basis type = 'TMD'

number of ions = 2
ions = 'Mo' 'S'

Mo valence = 4
S valence = 4
# spin orbit

number of spin-orbit parameters per ion = 2 2

Mo spin orbit
'p' 0.0D0
'd' 0.0000D0


S spin orbit
'p' 0.0D0
'd' 0.0000D0
# onsite ETB

number of orbitals per ion = 5 3 

#paper: A tight-binding model for MoS2 monolayers (E Ridolfi et al.)
##simplified model(tabel 10)


Mo onsite
'dz2r2'  -11.683  1
'dyz'   -208.435  1
'dzx'   -208.435  1
'dxy'    -75.942  1
'dx2y2'  -75.942  1

Mo offset = 0.0


S onsite
'px'     -23.761  1
'py'     -23.761  1
'pz'     -35.968  1

S offset = 0.0


#strain coefficient for the d orbitals
S b_d parameter = 0.0D0
Mo b_d parameter = 0.0

# ETB couplings  integrals ##
##
number of pairs = 2  


# pair <number> = 'ion1' 'ion2' <number of ETB data> 
# <order of nearest neighbours>

pair 1 = 'Mo' 'S' 2 1 

Mo S coupling 1
'dps'   -56.738   0
'dpp'     1.318   0

Mo S pair reference distance 1 = 2.4072

pair 2 = 'Mo' 'Mo' 3 2 

Mo Mo coupling 2 
'dds'    -2.652   0
'ddp'     1.750   0
'ddd'     1.482   0

Mo Mo pair reference distance 2 = 3.16

Mo min cutoff = 0
Mo max cutoff = 1.3
S min cutoff = 1
S max cutoff = 1.5 


