# Ge

structure = zb


# lattice constant
[lattice]
a = 0.56579


[valenceband]
E_v = 1.76633



[conductionband]
m_G = 0.038
m_L_t = 0.0807
m_L_l = 1.57
m_X_t = 0.290
m_X_l = 1.350



[bandgap]
# T=0 K
Eg_G = 0.9
Eg_L = 0.74
Eg_X = 0.931

varshni_alpha_G = 0.4774e-3
varshni_beta_G =  235

varshni_alpha_X = 0.4774e-3
varshni_beta_X =  235

varshni_alpha_L = 0.4774e-3
varshni_beta_L = 235



[kdotp]
delta = 0.289

gamma1 = 13.38
gamma2 = 4.24
gamma3 = 5.69


[deformation_potentials]
a_c = -10.41
a_v = -0.35
b = -2.86
d = -5.28

abs_def_pot_X = 0.14
uniax_def_pot_X = 9.42
abs_def_pot_L = -4.35
uniax_def_pot_L = 15.13


[permittivity]
# static dielectric constant
permittivity = 16.2


# stiffness data
[elasticity]
C11 = 128.53
C12 = 48.26
C44 = 66.80

# piezoelectricity
[piezoelectricity]
e14 = 0.0


# mobility
[mobility/constant]
mu_max   = (3.9000e+03, 1.9000e+03)
exponent = (   1.6,   2.3)


# doping dependent
[mobility/doping_dependent]
mobility_formula = 2
mumin = (3.9000e+03,	1.9000e+03)
am    = (-1.6000e+00, 	-2.3000e+00)
mud   = (0.0, 		0.0)
ad    = (0.0,	 	0.0)
N0    = (1.0e+17, 	1.0e+17)
aN    = (0.0, 		0.0)
A     = (0.0, 		0.0)
aA    = (0.0, 		0.0)



# high field dependency
[mobility/field_dependent]
Vsat_Formula = 1
beta0   = (1.109,	1.213)
betaexp = (0.66,	0.17)
vsat0   = (7.4300e+06,	7.4300e+06)
vsatexp = (0.87,	0.52)


# SRH recombination  (same as Si)
[recombination/SRH]
Etrap  = 0.0
taumin = (0.0,		0.0)
taumax = (1.0e-5,	3.0e-6)
Nref   = (1.0e+16,	1.0e+16)
gamma  = (1,		1)
Talpha = (-1.5,		-1.5)
Tcoeff = (2.55,		2.55)


# Auger recombination (same as Si)
[recombination/auger]
# R_Auger = ( C_n n + C_p p ) ( n p - ni_eff^2)
# with C_n,p = (A + B (T/T0) + C (T/T0)^2) (1 + H exp(-{n,p}/N0))
# 
#         n		    p
A =  (6.7000e-32,	7.2000e-32)
B =  (2.4500e-31,	4.5000e-33)
C =  (-2.2000e-32,	2.6300e-32)
H =  (3.46667,		8.25688)
N0 = (1.0000e+18,	1.0000e+18)

# Lattice thermal conductivity
[thermal_conductivity/constant]
ThermCond = 166.667 


#Thermoelectric power [V/k]
[thermoelectric_power/constant]
eTEpower = -0.001
hTEpower =  0.001


tomistic structure informations
#
[atomistic_structure]
lattice_type = fcc

#Basis

#Number of basis specie
n_basis_specie = 2 
#Number of basis atoms for any specie
n_1 = 1
n_2 = 1 
#Basis vectors T_"specie"_"#of atom"_"direction"
T_1_1_a = 0.0
T_1_1_b = 0.0
T_1_1_c = 0.0
T_2_1_a = 0.25
T_2_1_b = 0.25
T_2_1_c = 0.25

#Name of species
specie_1 = Ge
specie_2 = Ge



[densityfunctional_tb]

dataset = pbc


