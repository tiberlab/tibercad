# graphene 

structure = wz


# lattice constant
[lattice] # [3]
a = 0.246
c = 1.0 
#Atomistic structure informations
#
[atomistic_structure]
lattice_type = hexagonal

#Basis 

#Number of basis specie
n_basis_specie = 1
#Number of basis atoms for any specie
n_1 = 2



#Basis vectors T_"specie"_"#of atom"_"direction"
T_1_1_a = 0.0
T_1_1_b = 0.0
T_1_1_c = 0.0
T_1_2_a = -0.333333333
T_1_2_b = 0.333333333
T_1_2_c = 0.0

#Name of species
specie_1 = C


[densityfunctional_tb]

dataset = pbc

