# GaP-zb

structure = zb


# lattice constant
[lattice] # [1]
a = 0.54505


[valenceband] # [1]
E_v = -1.27


[conductionband] # [1]
m_G = 0.13
m_L_l = 1.2
m_L_t = 0.15
m_X_l = 2.0
m_X_t = 0.253



[bandgap] # [1]
# 0 K values
Eg_G = 2.886
Eg_L = 2.72
Eg_X = 2.35

varshni_alpha_G = 0.5771e-3 # true dependence should be the analytic model
varshni_beta_G =  372       # given in [1]

varshni_alpha_X = 0.5771e-3
varshni_beta_X =  372

varshni_alpha_L = 0.5771e-3
varshni_beta_L =  372


[kdotp] # [1]
delta = 0.08

gamma1 = 4.05
gamma2 = 0.49
gamma3 = 1.25 # [3] 


[deformation_potentials]
a_c = -8.2 # [1]
abs_def_pot_L = -4.41   # [3]
abs_def_pot_X = 0.69    # [3]
uniax_def_pot_L = 11.35 # [3]
uniax_def_pot_X = 5.65  # [3]

a_v = 1.7 # [1] 
b = -1.6   # [1]
d = -4.6   # [1]


[permittivity] # [3]
# static dielectric constant
permittivity = 11.1

optical_epsilon = 9.075


# stiffness data
[elasticity] # [1]
C11 = 140.5
C12 = 62.03
C44 = 70.33

# piezoelectricity
[piezoelectricity] # [3]
e14 = -0.097


# mobility
[mobility/constant] # [2]
mu_max = (110.0, 75.0)
exponent = (1.5, 1.5)

[mobility/doping_dependent] # [2]
mobility_formula = 2
mumin = (110,		75.0)
am    = (-1.5,	 	-1.5)
mud   = (0.0,	 	0.0)
ad    = (0.0, 		0.0)
N0    = (1.0e+17, 	1.0e+17)
aN    = (0.0,	 	0.0)
A     = (0.0,	 	0.0)
aA    = (0.0,	 	0.0)


# high field dependency
[mobility/field_dependent] # [2]
Vsat_Formula = 2
beta0    = (2.0, 	2.0)
betaexp  = (0,		0)
A_vsat   = (1.0e+07, 	1.0e+07)
B_vsat   = (0,		0)
vsat_min = (5.0e+05, 	5.0e+05)



# SRH recombination
[recombination/SRH] # [2]
Etrap    = 0.0
taumin = (0.0, 		0.0)
taumax = (1.0e-9, 	1.0e-9)
Nref   = (1.0e+16, 	1.0e+16)
gamma  = (1, 		1)
Talpha = (0,		0)
Tcoeff = (0,		0)


# direct recombination
[recombination/direct] # [4]
C = 0.5e-13


[recombination/auger] # [2]
# R_Auger = ( C_n n + C_p p ) ( n p - ni_eff^2)
# with C_n,p = (A + B (T/T0) + C (T/T0)^2) (1 + H exp(-{n,p}/N0))
#
A	= (1.0000e-30 ,	1.0000e-30)	# [cm^6/s]
B	= (0.0000e+00 ,	0.0000e+00)	# [cm^6/s]
C	= (0.0000e+00 ,	0.0000e+00)	# [cm^6/s]
H	= (0.0000e+00 ,	0.0000e+00)	# [1]
N0	= (1.0000e+18 ,	1.0000e+18)	# [cm^(-3)]



[thermal_conductivity/constant] # [3]
ThermCond = 1.1




#Atomistic structure informations
#
[atomistic_structure]
lattice_type = fcc

#Basis 

#Number of basis specie
n_basis_specie = 2
#Number of basis atoms for any specie
n_1 = 1
n_2 = 1
#Basis vectors T_"specie"_"#of atom"_"direction"
T_1_1_a = 0.0
T_1_1_b = 0.0
T_1_1_c = 0.0
T_2_1_a = 0.25
T_2_1_b = 0.25
T_2_1_c = 0.25

#Name of species
specie_1 = Ga 
specie_2 = P 




