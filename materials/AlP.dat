# AlP-zb

structure = zb


# lattice constant
[lattice] # [1]
a = 0.54672


[valenceband] # [1]
E_v = -1.74


[conductionband] # [1]
m_G = 0.22
m_L_l = 2.68 # not given in [1]
m_L_t = 0.155 # not given in [1]
m_X_l = 2.68
m_X_t = 0.155



[bandgap] # [1]
# 0 K values
Eg_G = 3.63
Eg_L = 3.57
Eg_X = 2.52

varshni_alpha_G = 0.5771e-3 
varshni_beta_G =  372       

varshni_alpha_X = 0.318e-3
varshni_beta_X =  588

varshni_alpha_L = 0.318e-3
varshni_beta_L =  588


[kdotp] # [1]
delta = 0.07

gamma1 = 3.35
gamma2 = 0.71
gamma3 = 1.23 


[deformation_potentials]
a_c = -5.7 # [1]
abs_def_pot_L = -1.74   # [3]
abs_def_pot_X = 3.98    # [3]
uniax_def_pot_L = 11.35 # [3]
uniax_def_pot_X = 6.75  # [3]

a_v = 3 # [1]
b = -1.5   # [1]
d = -4.6   # [1]


[permittivity] # [3]
# static dielectric constant
permittivity = 9.8

optical_epsilon = 7.5385


# stiffness data
[elasticity] # [1]
C11 = 133
C12 = 63
C44 = 61.5

# piezoelectricity
[piezoelectricity] # [3]
e14 = 0.059


# mobility
[mobility/constant] # copied from GaP
mu_max = (110.0, 75.0)
exponent = (1.5, 1.5)

[mobility/doping_dependent] # copied from GaP
mobility_formula = 2
mumin = (110,		75.0)
am    = (-1.5,	 	-1.5)
mud   = (0.0,	 	0.0)
ad    = (0.0, 		0.0)
N0    = (1.0e+17, 	1.0e+17)
aN    = (0.0,	 	0.0)
A     = (0.0,	 	0.0)
aA    = (0.0,	 	0.0)


# high field dependency
[mobility/field_dependent] # copied from GaP
Vsat_Formula = 2
beta0    = (2.0, 	2.0)
betaexp  = (0,		0)
A_vsat   = (1.0e+07, 	1.0e+07)
B_vsat   = (0,		0)
vsat_min = (5.0e+05, 	5.0e+05)



# SRH recombination
[recombination/SRH] # copied from GaP
Etrap    = 0.0
taumin = (0.0, 		0.0)
taumax = (1.0e-9, 	1.0e-9)
Nref   = (1.0e+16, 	1.0e+16)
gamma  = (1, 		1)
Talpha = (0,		0)
Tcoeff = (0,		0)


# direct recombination
[recombination/direct] # copied from GaP
C = 0.5e-13


[recombination/auger] # copied from GaP
# R_Auger = ( C_n n + C_p p ) ( n p - ni_eff^2)
# with C_n,p = (A + B (T/T0) + C (T/T0)^2) (1 + H exp(-{n,p}/N0))
#
A	= (1.0000e-30 ,	1.0000e-30)	# [cm^6/s]
B	= (0.0000e+00 ,	0.0000e+00)	# [cm^6/s]
C	= (0.0000e+00 ,	0.0000e+00)	# [cm^6/s]
H	= (0.0000e+00 ,	0.0000e+00)	# [1]
N0	= (1.0000e+18 ,	1.0000e+18)	# [cm^(-3)]


[thermal_conductivity/constant] # copied from GaP
ThermCond = 1.1



#Atomistic structure informations
#
[atomistic_structure]
lattice_type = fcc

#Basis 

#Number of basis specie
n_basis_specie = 2
#Number of basis atoms for any specie
n_1 = 1
n_2 = 1
#Basis vectors T_"specie"_"#of atom"_"direction"
T_1_1_a = 0.0
T_1_1_b = 0.0
T_1_1_c = 0.0
T_2_1_a = 0.25
T_2_1_b = 0.25
T_2_1_c = 0.25

#Name of species
specie_1 = Al 
specie_2 = P 





