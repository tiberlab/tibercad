# $Id$

# Useful rules


.PHONY: $(subdirs)
$(subdirs):
	@$(MAKE) -C $@ $(target)

.%.d: %.C
	@$(CC) -MT $(basename $<).$(obj-suffix) -MM $(CPPFLAGS) $< > $@.$$$$; \
	sed 's,\($*\)\.$(obj-suffix)[ :]*,\1.$(obj-suffix) $@ : ,g' < $@.$$$$ > $@; \
	rm -f $@.$$$$


%.msh: %.geo
	@$(GMSH) -format msh -order $(ORDER) -$(DIM) -o $<.msh $<
	@$(topdir)/bin/renumber_msh $<.msh $@
	@rm $<.msh


