# $Id$

# Useful rules


src-clean:
	@rm -f *.o *~ .*.d *~

src-distclean:
	@rm -f *.o .*.d *~


.PHONY: $(subdirs)
$(subdirs):
	@$(MAKE) -C $@ $(MAKECMDGOALS)


.%.d: %.C
	@$(CC) -MT $(basename $<).$(obj-suffix) -MM $(CPPFLAGS) $< > $@.$$$$; \
	sed 's,\($*\)\.$(obj-suffix)[ :]*,\1.\*\.o $@ : ,g' < $@.$$$$ > $@; \
	rm -f $@.$$$$


%.msh: %.geo
	@$(GMSH) -format msh -order $(ORDER) -$(DIM) -o $<.msh $<
	@$(topdir)/bin/renumber_msh $<.msh $@
	@rm $<.msh

%.s: %.C .%.d
	@$(CXX) $(CPPFLAGS) $(CXXFLAGS) -S $<


ifneq ($(MAKECMDGOALS),clean)
ifneq (x$(srcfiles),x)
-include $(patsubst %,.%,$(srcfiles:.C=.d))
endif
endif

