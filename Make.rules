
# Useful rules

all: $(target)


.PHONY: clean distclean

clean: clean-recursive src-clean

distclean: distclean-recursive src-distclean



.PHONY: all-recursive clean-recursive distclean-recursive
all-recursive: $(subdirs)

clean-recursive: $(subdirs)

distclean-recursive: $(subdirs)


.PHONY: src-clean
src-clean:
	@echo -n "Cleaning up ."
	@echo `expr "$$PWD" : "$(topdir)\(.*\)"`
	-@rm -f *.o *~ *.d *~
	-@rm -rf .$(ARCH)

.PHONY: src-distclean
src-distclean:
	@echo -n "Cleaning up ."
	@echo `expr "$$PWD" : "$(topdir)\(.*\)"`
	-@rm -f *.so *.dll *.a *.o *.d *~
	-@rm -rf .$(ARCH)


.PHONY: $(subdirs)
$(subdirs):
	@$(MAKE) --no-print-directory -C $@ $(MAKECMDGOALS)



.$(ARCH)/%$(obj-suffix) : %.C $(filter-out $(wildcard .$(ARCH)), .$(ARCH))
	@echo "Compiling C++ (in "$(mode)" mode) "$<" ..."
	@$(CXX) $(CXXFLAGS) $(CPPFLAGS) -c $< -o $@


%.s : %.cpp
	@echo "Compiling C++ (in "$(mode)" mode) "$<" ..."
	@$(CXX) $(CXXFLAGS) $(CPPFLAGS) -S -c $<



.$(ARCH)/%$(obj-suffix) : %.cpp $(filter-out $(wildcard .$(ARCH)), .$(ARCH))
	@echo "Compiling C++ (in "$(mode)" mode) "$<" ..."
	@$(CXX) $(CXXFLAGS) $(CPPFLAGS) -c $< -o $@



.$(ARCH)/%$(obj-suffix): %.c $(filter-out $(wildcard .$(ARCH)), .$(ARCH))
	@echo "Compiling C (in "$(mode)" mode) "$<" ..."
	@$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@
	

.$(ARCH)/%$(obj-suffix): %.f $(filter-out $(wildcard .$(ARCH)), .$(ARCH))
	@echo "Compiling F77 (in "$(mode)" mode) "$<" ..."
	@$(FC) $(FCFLAGS) $(CPPFLAGS) -c $< -o $@
	
.$(ARCH):
	@mkdir -p .$(ARCH)
	

.$(ARCH)/%.d: %.cpp
	@mkdir -p .$(ARCH)
	@$(CC) -MG -MT .$(ARCH)/$(basename $<)$(obj-suffix) -MM $(CPPFLAGS) $(CXXFLAGS) $< > $@.$$$$ ; \
	 sed -e 's,\($*\)\$(obj-suffix)[ :]*,\1.\*\.o : $@ ,g' < $@.$$$$ > $@ ; \
	 sed -e 's/.*://' -e 's/\\$$//' < $@.$$$$ | fmt -1 \
	 | sed -e 's/^ *//' -e 's/$$/:/' >> $@ ; \
	 rm -f $@.$$$$



%.s: %.cpp %.d
	@$(CXX) $(CPPFLAGS) -S $<


ifeq (x$(findstring clean,$(MAKECMDGOALS)),x)
ifneq (x$(srcfiles),x)
srcfiltered=$(filter %.cpp, $(srcfiles))
include $(addprefix .$(ARCH)/,$(srcfiltered:.cpp=.d))
endif
endif

