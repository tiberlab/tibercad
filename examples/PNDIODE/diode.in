# pn-junction definition

dimension = 2
meshfile = diode_mdr.grd
format = ise

n_doping = 1e18
p_doping = 1e19
temperature = 300

statistics = B
searchpath = ../materials
material = Si


mesh_units = 1e-4

#start_voltage = -0.9
#stop_voltage = 0.9
#voltage_steps = 50
start_voltage = 0
stop_voltage = 1.0
voltage_steps = 10

#simulation_method = GUMMEL

nonlinear_tolerance = 1e-9
nonlinear_abs_tolerance = 1e-12
nonlinear_ls_maxstep = 0.025
ls_type = cubic
linear_tolerance = 1e-6
linear_abs_tolerance = 1e-15
nonlinear_max_it = 50
linear_max_it = 1000
integration_order = 2
discretization = fem


scaling = 1

#refinement_stop_criterion=1e-4
max_refinement_steps=0

uniform_refinement=0

refine_fraction=0.7
coarsen_fraction=0.3
max_ref_level=6


