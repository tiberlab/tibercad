# diode example

# Description of  the  device physical regions
$Device
{
   Region n_side 
   {
     reg_numb = 2
     mat = GaN
     structure = wz
     x = 0.8
     doping = 1e18 doping_type = donor
   }

   Region p_side 
   {
     reg_numb = 1
     mat = GaN
     x = 0.8
     structure = wz
     doping = 1e18 doping_type = acceptor
   }
}


# Definition of  Simulation Models  and associated Boundary Conditions 
$Models
{ 
  #model ddtest2
  model driftdiffusion
  { 
              
    options
    {
     simulation_name = driftdiffusion
     physical_regions = all
    }

     physical_model recombination
     { 
       model  =  srh
     }                

    BC_Regions  
    {
      BC_Region anode
      {
        BC_reg_numb = 1
        type = ohmic
      #  barrier_height = 0.8
        voltage = @Vb[1.5]
      }

      BC_Region cathode
      {
        BC_reg_numb = 2
        type = ohmic
        voltage = 0.0
      }
 
    }   
  }  
}


# Definition of  Model-dependent Solver parameters
$Solver

{
  driftdiffusion
  {
    ksp_type = bcgsl
    nonlin_abs_tol = 1e-10
    nonlin_step_tol = 1e-2
    #nonlin_rel_tol = 1e-12
    lin_rel_tol = 1e-6
    nonlin_max_it = 30
    #local_density_scaling = true
    #ls_type = none
    discretization = fem
    ls_max_step = 10
    #pc_type = lu
    pc_type = composite
    integration_order = 2
    #relaxation_factor = 0.5
  }

  sweep
  {
    variable = Vb
    start = 0.0
    stop = 4.0
    steps = 80
    plotvariable = current
  }
}



# Definition of  Model dependent physical parameters
$Physics
{
 
  driftdiffusion 
  {
    model = unstrained
  }
}


# Definition of  model-indipendent parameters of the Simulation


$Simulation
{
  searchpath = ../materials
  meshfile = diode_mdr.grd
  dimension = 2
  temperature = 300
  solve = sweep
  #solve = driftdiffusion
  resultpath = output_2D
  #output_format = grace
  output_format = gmv
  plot = (Ec, Ev, QFermi_e, QFermi_h, eDensity, hDensity, eCurrent, hCurrent, Current, eMob, hMob, current)
}





