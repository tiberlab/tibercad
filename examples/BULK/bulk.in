
# Description of  the  device physical regions
$Device
{
   Region bulk 
   {
     reg_numb = 1
     mat = Si
     doping = 1e16 doping_type = donor
   }
}


# Definition of  Simulation Models  and associated Boundary Conditions 
$Models
{ 
  model driftdiffusion
  { 
              
     name driftdiffusion

     phys_regions = (1)


    BC_Regions  
    {
      BC_Region anode
      {
        BC_reg_numb = 2
        type = ohmic
        barrier_height = 0.8
        value = 0.5
      }

      BC_Region cathode
      {
        BC_reg_numb = 1
        type = ohmic
        value = 0.0
      }
 
    }   

  }  

}


# Definition of  Model-dependent Solver parameters
$Solver
{
  driftdiffusion
  {
    ksp_type = gmres
    nonlin_max_it = 50
    current_integration_method = rstf
  }


  sweep
  {
    #simulation = driftdiff
    boundary = anode
    start = 0.0
    stop = 1.0
    steps = 10
    plotvariable = current
  }
}



# Definition of  Model dependent physical parameters
$Physics
{
 
  driftdiffusion 
  {
    model = unstrained
  }
}


# Definition of  model-indipendent parameters of the Simulation


$Simulation
{
  searchpath = ../materials
  meshfile = bulk2Dtri.msh
  dimension = 2
  temperature = 300
  solve = sweep
  resultpath = output_tri
  output_format = ise
  plot = (Ec, Ev, QFermi_e, QFermi_h, ECurrent, AbsECurrent, current)
}





