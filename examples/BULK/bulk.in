# $Id$

$Options$

# a 3D piece of bulk semiconductor


n_doping = 1e16
p_doping = 1e14
temperature = 300

searchpath = ../materials

crystal_structure = zb
y-dir = [1,1,1]
x-dir = [-2,1,1]
#z-dir = [1,0,-1,0]
#x-dir = [-1,2,-1,0]
#y-dir = [0,0,0,1]
material = AlGaAs
molar_fraction = 0.05

substrate_material = GaAs
substrate_molar_fraction = 0.1

shape_steps = 0

statistics = B

dimension = 2
meshfile = bulk2D.msh

mesh_units = 1e-4

start_voltage = 0.0
stop_voltage = 0.1
voltage_steps = 1


nonlinear_tolerance = 1e-19
nonlinear_ls_maxstep = 0.05
min_voltage_step = 0.001
ls_type = cubic
linear_tolerance = 1e-6
nonlinear_max_it = 25
linear_max_it = 1000
integration_order = 2
ksp_type = bcgsl
pc_type = composite
discretization = fem
current_integration = new

scaling = 1

#refinement_stop_criterion=1e-4
max_refinement_steps=0

uniform_refinement=0

refine_fraction=0.7
coarsen_fraction=0.0
max_ref_level=10


$End$
