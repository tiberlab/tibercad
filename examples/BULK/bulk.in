
# Description of  the  device physical regions
$Device
{
   Region bulk 
   {
     reg_numb = 1
     mat = GaAs
     doping = 1e18 doping_type = donor
   }

}


# Definition of  Simulation Models  and associated Boundary Conditions 
$Models
{ 
  model driftdiffusion
  { 
              
     phys_regions = (1)

     physical_models
     { 
       recombination  =  SRH
       electron_mobility = constant
     }                

    BC_Regions  
    {
      BC_Region anode
      {
        BC_reg_numb = 2
        type = ohmic
        barrier_height = 0.8
        value = 0.5
      }

      BC_Region cathode
      {
        BC_reg_numb = 1
        type = ohmic
        value = 0.0
      }
 
    }   

  }  

}


# Definition of  Model-dependent Solver parameters
$Solver

{
  driftdiffusion
  {
    ksp_type = gmres
    nonlin_max_it = 50
    current_integration_method = rstf
  }

  sweep
  {
    boundary = anode
    start = 0.0
    stop = 1.0
    steps = 10
  }
}



# Definition of  Model dependent physical parameters
$Physics
{
 
  driftdiffusion 
  {
    model = unstrained
  }
}


# Definition of  model-indipendent parameters of the Simulation


$Simulation
{
  searchpath = ../materials
  meshfile = bulk1D.msh
  dimension = 1
  temperature = 300
  solve = sweep
}





