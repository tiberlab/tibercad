
# Description of  the  device physical regions
$Device
{
   Region bulk 
   {
     reg_numb = 1
     material = Si
     #structure = wz
     doping = 1e16 doping_type = donor
   }

}


# Definition of  Simulation Models  and associated Boundary Conditions 
$Models
{ 

  model driftdiffusion
  { 
              
    options
    {
     simulation_name = driftdiffusion
     #thermal_simulation = tt

     physical_regions = bulk
    }

    physical_model recombination
    {
      model = srh
    }

    physical_model electron_mobility
    {
      model = field_dependent
      low_field_model = doping_dependent
      #model = doping_dependent
      #model = constant
      #model = test
      E_max = 5e4
      #driving_force = efield
    }

    physical_model hole_mobility
    {
      model = field_dependent
      low_field_model = doping_dependent
      #model = doping_dependent
      #model = constant
      #model = test
      E_max = 5e4
      #driving_force = efield
    }


    BC_Regions  
    {
      BC_Region anode
      {
        #BC_reg_numb = (1,3)
        BC_reg_numb = 1
        type = ohmic
	#contact_resistance = 1e-3
        voltage = @Vb[0.5]
      }

      BC_Region cathode
      {
        BC_reg_numb = 2
        type = ohmic
        voltage = 0.0
      }

    }   

  }  

}


# Definition of  Model-dependent Solver parameters
$Solver
{
  driftdiffusion
  {
    #nonlinear_solver = tiber
    #linear_solver = pardiso
    ksp_type = bcgs
    nonlin_max_it = 30
    #nonlin_abs_tol = 1e-12
    nonlin_step_tol = 1e-9
    ls_max_step = 2
    pc_type = lu
    #current_integration_method = surfint
  }


  sweep
  {
    simulation = driftdiffusion
    variable = Vb
    start = 0.0
    stop = 1.0
    steps = 10
    plot_data = true
  }
}



# Definition of  Model dependent physical parameters
$Physics
{
 
  driftdiffusion 
  {
    model = unstrained
  }

}


# Definition of  model-indipendent parameters of the Simulation


$Simulation
{
  searchpath = ../../materials
  #searchpath = .
  meshfile = bulk2D.msh
  dimension = 2
  mesh_units = 1e-6
  temperature = 300
  #solve = driftdiffusion
  solve = sweep
  resultpath = output_2D
  output_format = grace
  #output_format = gmv
  #output_format = vtk
  plot = (Ec, Ev, QFermi_e, QFermi_h, eDensity, hDensity, eCurrent, hCurrent,  NetRecombination, Nd, Na, charge_density, ElPotential, EField, ContactCurrents, hMob, eMob)
}































