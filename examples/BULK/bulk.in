# $Id$

$Options$

# a 3D piece of bulk semiconductor

n_doping = 1e16
p_doping = 1e14
temperature = 3

searchpath = ../materials
material = Si
crystal_structure = zb
molar_fraction = 0.3

statistics = B

dimension = 1
meshfile = bulk1D.msh

mesh_units = 1e-4

start_voltage = 0.0
stop_voltage = 1.0
voltage_steps = 10


nonlinear_tolerance = 1e-9
nonlinear_ls_maxstep = 0.05
min_voltage_step = 0.001
ls_type = none
linear_tolerance = 1e-9
nonlinear_max_it = 20
linear_max_it = 1000
integration_order = 2
ksp_type = gmres
pc_type = jacobi
discretization = fem


scaling = 1

#refinement_stop_criterion=1e-4
max_refinement_steps=0

uniform_refinement=0

refine_fraction=0.7
coarsen_fraction=0.0
max_ref_level=10


$End$
