# $Id$
$Options

# mesfet example


meshfile=mesfet.msh

# units are um
mesh_units = 1e-4

statistics = B

# = 0 means solve only for electrons
# = 1 means solve electrons and holes
fully_coupled = 1

# calculate output characteristic (1) or
# transcharacteristic (0)
characteristic = 1

# for transcharacteristic
vds = 2;
vg_start = -1.0;
vg_stop =  0.1;
vg_steps = 11;
# for oyput characteristic
vds_stop = 4.0;
vds_steps = 80;

nonlinear_tolerance = 1e-12
nonlinear_ls_maxstep = 0.025
linear_tolerance = 1e-6
linear_max_it = 1000
nonlinear_max_it = 15
integration_order = 5

scaling = 1

$End
