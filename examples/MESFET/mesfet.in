# $Id$

$Options

# mesfet example


#meshfile=mesfet.msh
meshfile=mesfet_mdr.grd
format=ise

# units are um
mesh_units = 1e-4

statistics = B

# = 0 means solve only for electrons
# = 1 means solve electrons and holes
fully_coupled = 1

# apply unit scaling
scaling = 1

# calculate output characteristic (1) or
# transcharacteristic (0)
characteristic = 1

# for transcharacteristic
vds = 1.5;
vg_start = 0.0;
vg_stop =  0.0;
vg_steps = 1;
#vg_stop = 1.0;
#vg_steps = 50;
# for output characteristic
vds_stop = 1.0;
vds_steps = 10;

nonlinear_tolerance = 1e-12
nonlinear_ls_maxstep = 0.1
linear_tolerance = 1e-6
linear_max_it = 1000
nonlinear_max_it = 15
integration_order = 2

max_refinement_steps=0
refine_fraction=0.8
coarsen_fraction=0.4
max_ref_level=5


$End
