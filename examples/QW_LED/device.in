
# Description of  the  device physical regions
$Device
{

   Region nside
   {
     reg_numb = (1, 2, 4, 12, 13, 14)
     structure = wz
     z-growth-direction = (1,0,-1,0)
     x-growth-direction = (-1,2,-1,0)
     y-growth-direction = (0,0,0,1)
     mat = GaN
     doping = 1e18 doping_type = donor doping_level = 0.025
   }

   Region igan
   {
     reg_numb = (9, 11)
     structure = wz
     z-growth-direction = (1,0,-1,0)
     x-growth-direction = (-1,2,-1,0)
     y-growth-direction = (0,0,0,1)
     mat = GaN
     doping = 1e15 doping_type = donor doping_level = 0.025
   }



   Region pside 
   {
     reg_numb = (5, 8)
     structure = wz
     z-growth-direction = (1,0,-1,0)
     x-growth-direction = (-1,2,-1,0)
     y-growth-direction = (0,0,0,1)
     mat = GaN
     doping = 5e17 doping_type = acceptor doping_level = 0.17 g = 4
   }

   Region ppside 
   {
     reg_numb = 7
     structure = wz
     z-growth-direction = (1,0,-1,0)
     x-growth-direction = (-1,2,-1,0)
     y-growth-direction = (0,0,0,1)
     mat = GaN
     doping = 1e19 doping_type = acceptor doping_level = 0.17 g = 4
   }


   Region qw 
   {
     reg_numb = (3, 10)
     structure = wz
     z-growth-direction = (1,0,-1,0)
     x-growth-direction = (-1,2,-1,0)
     y-growth-direction = (0,0,0,1)
     mat = InGaN
     x = 0.05
     doping = 1e15 doping_type = donor doping_level = 0.025
   }

   Region air
   {
     reg_numb = 6
     mat = Air
   }

}


# Definition of  Simulation Models  and associated Boundary Conditions 
$Models
{ 

  model driftdiffusion
  { 

    options
    {
     simulation_name = driftdiffusion

     physical_regions = (7, 8, 9, 10, 11, 12, 13)
    }

    physical_model recombination
    {
      model = srh
    }

    physical_model recombination
    {
      model = direct
      C = 1.1e-8
    }

    #physical_model recombination
    #{
    #  model = exciton_generation
    #  C = 2e-7
    #}

    #physical_model recombination
    #{
    #  model = exciton_dissociation
    #  exciton_simulation = excitons
    #}



    physical_model electron_mobility
    {
      model = doping_dependent
    }

    physical_model hole_mobility
    {
      model = doping_dependent
    }


    BC_Regions  
    {
      BC_Region anode
      {
        #BC_reg_numb = 1
        type = ohmic
	zero_grad_fermi_e = true
	voltage = @Vb[0]
      }

      BC_Region cathode
      {
        #BC_reg_numb = 2
        type = ohmic
	#zero_grad_fermi_h = true
      }
 
    }   

  }  

  model thermal
  {
    options
    {
      simulation_name = tt
      physical_regions = (1, 6, 7, 8, 9, 10, 11, 12, 13, 14)
    }

    BC_Regions  
    {
      BC_Region thermal
      {
        #BC_reg_numb = 3
      }
    }
  }



#  model excitontransport
#  {
#    options
#    {
#     simulation_name = excitons
#
#     physical_regions = (4, 5, 6, 8)
#    }

#  }

  model macrostrain
  {
    options
    {
      simulation_name = strain
      physical_regions = (2, 3, 4, 5, 7, 8, 9, 10, 11, 12, 13)
    }

    BC_Regions  
    {
      BC_Region strain_substrate
      {
        #BC_reg_numb = 4
	type = substrate
        material = GaN
	structure = wz
	z-growth-direction = (1,0,-1,0)
	x-growth-direction = (-1,2,-1,0)
	y-growth-direction = (0,0,0,1)
      }
    }
  }


}


# Definition of  Model-dependent Solver parameters
$Solver
{
  driftdiffusion
  {
    #quasi_equilibrium = (cathode, anode)
    nonlin_max_it = 35
    #nonlin_rel_tol = 1e-9
    #nonlin_abs_tol = 1e-15
    nonlin_step_tol = 1e-3
    #ksp_type = bcgsl
    #pc_type = composite
    ls_max_step = 2
  }

  excitons
  {
    nonlin_max_it = 70
    pc_type = composite
    ksp_type = gmres
    ls_min_step = 1e-5
  }

  sweep
  {
    simulation = (driftdiffusion, thermal)
    #simulation = selfconsistent
    variable = Vb
    start = 0.0
    stop = 3.5
    steps = 70
    plotvariable = current
  }

 # selfconsistent
 # {
 #   simulations = (driftdiffusion, excitontransport)
 # }

  thermal
  {
    current_simulation = driftdiffusion
  }

  macrostrain
  {
    substrate = strain_substrate
  }

}



# Definition of  Model dependent physical parameters
$Physics
{
 
  driftdiffusion 
  {
    statistics = FD
    model = strained
    #model = unstrained
  }

  excitons
  {
    model = simple
    tau_rad = 1e-11
    tau_nonrad = 1.2e-9
    tau_diss = 6e-9
    R = 20.4e-3
    eff_mass = 1.02
    mobility = 1500
    generation_model = exciton_generation
  }
}


# Definition of  model-indipendent parameters of the Simulation


$Simulation
{
  searchpath = ../materials
  meshfile = device_mdr.grd
  mesh_units = 1e-6
  dimension = 2
  temperature = 300
  solve = (macrostrain, sweep)
  #solve = sweep
  resultpath = output
  #output_format = ise
  output_format = gmv
  plot = (Ec, Ev, QFermi_e, QFermi_h, eDensity, hDensity, eCurrent, hCurrent, Current, NetRecombination, eMob, hMob, T, strain, polarization)
  #plot = (Ec, Ev, QFermi_e, QFermi_h, eDensity, hDensity, eCurrent, hCurrent, Current, NetRecombination, eMob, hMob, xEffPot, xDensity, xMob, ExcitonRecombination, xCurrent, T)
}





