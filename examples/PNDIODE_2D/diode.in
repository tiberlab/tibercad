# pn-junction definition

n_side_doping = 1e18
p_side_doping = 1e18
temperature = 300

statistics = B

meshfile=diode_mdr.grd
mesh_units = 1e-4
scaling = 1
linearize = false

material = Si
electron_mobility = 283.8
hole_mobility = 160.3

# GaN
#recombination_time_n = 1e-11;
#recombination_time_p = 1e-11;
#direct_recombination = 1.1e-8;
# Si
recombination_time_n = 1e-7;
recombination_time_p = 3e-8;
direct_recombination = 0.0;

start_voltage = 0.0
stop_voltage = 1.2
voltage_steps = 24
#start_voltage = 0.0
#stop_voltage = 3.5
#voltage_steps = 70

#simulation_method = GUMMEL

nonlinear_tolerance = 1e-12
nonlinear_abs_tolerance = 1e-15
nonlinear_ls_maxstep = 1.1
linear_tolerance = 1e-8
linear_abs_tolerance = 1e-15
nonlinear_max_it = 10
min_voltage_step = 1e-5
linear_max_it = 1000
integration_order = 2

#refinement_stop_criterion=1e-4
max_refinement_steps=0

uniform_refinement=0

refine_fraction=0.7
coarsen_fraction=0.3
max_ref_level=6


