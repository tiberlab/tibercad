
# Description of  the  device physical regions
$Device
{
   Region substrate 
   {
     reg_numb = 1
     mat = Si
     doping = 1e18 doping_type = acceptor
   }
   
   Region contact
   {
     reg_numb = 2
     mat = Si
     doping = 1e19 doping_type = donor
   }

   Region oxide
   {
     reg_numb = 3
     mat = ZrO2
   }

}


# Definition of  Simulation Models  and associated Boundary Conditions 
$Models
{ 

  model driftdiffusion
  { 
              
    options
    {
     simulation_name = driftdiffusion

     physical_regions = all
    }

#    physical_model recombination
#    {
#      model = srh
#    }

    physical_model electron_mobility
    {
      model = field_dependent
      low_field_model = doping_dependent
    }


    BC_Regions  
    {
      BC_Region gate
      {
        BC_reg_numb = 2
        type = schottky
	barrier_height = 0.852
	zero_grad_fermi_e = true
	zero_grad_fermi_h = true
        voltage = @Vg[0.0]
      }

      BC_Region source
      {
        BC_reg_numb = 1
        type = ohmic
	zero_grad_fermi_h = true
        voltage = 0.0
      }
 
      BC_Region drain
      {
        BC_reg_numb = 3
        type = ohmic
	zero_grad_fermi_h = true
        voltage = @Vd[0.5]
      }
  
      BC_Region channel
      {
        BC_reg_numb = 4
        type = leakage_current
        outer_voltage = Vg
	#A = 5.67e-19
	A = 0
	c = 0.064
      }
 


    }   

  }  

}


# Definition of  Model-dependent Solver parameters
$Solver
{
  driftdiffusion
  {
    #nonlinear_solver = tiber
    coupling = electrons
    #ksp_type = bcgsl
    nonlin_max_it = 20
    nonlin_rel_tol = 1e-18
    #nonlin_abs_tol = 1e-15
    nonlin_step_tol = 1e-8
    #lin_rel_tol = 1e-6
    #lin_abs_tol = 1e-50
    ls_max_step = 2
    pc_type = ilu
    #pc_type = composite
  }


  sweep_1
  {
    simulation = driftdiffusion
    #simulation = sweep_2
    variable = Vg
    start = 0.0
    stop = 0.2
    steps = 1
    #steps = 5
    #stop = -2.0
    #steps = 40
    plotvariable = current
  }


  sweep_2
  {
    #simulation = driftdiffusion
    simulation = sweep_1
    variable = Vd
    start = 0.0
    #stop = 0.5
    #steps = 5
    stop = 2.0
    steps = 10
    #steps = 40
    plotvariable = current
  }
}



# Definition of  Model dependent physical parameters
$Physics
{
 
  driftdiffusion 
  {
    model = unstrained
    statistics = FD
  }

}


# Definition of  model-indipendent parameters of the Simulation


$Simulation
{
  searchpath = ../materials
  meshfile = mosfet.msh
  dimension = 2
  temperature = 300
  solve = sweep_2
  #solve = (sweep_2, sweep_1)
  #solve = (driftdiffusion, sweep)
  #resultpath = output_leaky
  resultpath = output
  #output_format = gmv
  output_format = vtk
  plot = (Ec, Ev, QFermi_e, QFermi_h, eDensity, hDensity, eCurrent, hCurrent,  NetRecombination, EField, ElPotential, eMob, hMob)
}




