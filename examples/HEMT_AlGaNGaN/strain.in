$Options

max_r_steps=0  

uniform_refinement=0

refine_fraction=0.2
coarsen_fraction=0.2
max_ref_level=10

max_shape_steps=0


initial_density=9

approx_order=FIRST

elem_shape=QUAD

tolerance=1e-8

read_regions_from_mesh=1

number_of_regions=2

dimension=2

calculate_atom_displacements=false

atom_structure_filename=atom_files/basis_test.xyz

atom_displacements_filename=atom_files/disp_test



grown_on_substrate=1

substrate_material=1

x-periodic=1
y-periodic=0
z-periodic=0

#-------Substrate boundary-----------

xmin_s=-1
xmax_s=1
ymin_s=-0.75
ymax_s=-0.7
zmin_s=0
zmax_s=0

stress = -0.0

fixed_point1 = (0.0 0.0 0.0)

fixed_point2 = (0.0 -0.5 0.0)

fixed_point3 = (1.0 0.0 1.0)

End
