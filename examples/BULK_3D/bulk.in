#simulation_method = GUMMEL

nonlinear_tolerance = 1e-12
nonlinear_ls_maxstep = 0.05
linear_tolerance = 1e-3
nonlinear_max_it = 15
linear_max_it = 1000
integration_order = 5

scaling = 1

#refinement_stop_criterion=1e-4
max_refinement_steps=0

uniform_refinement=0

refine_fraction=0.95
coarsen_fraction=0.0
max_ref_level=10


