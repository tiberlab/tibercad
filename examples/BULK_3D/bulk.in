# pn-junction definition


n_doping = 1e18
p_doping = 0
temperature = 300

#polarization_x = 0.0
#polarization_y = 0.0

#statistics = FD
#approximation_order = SECOND

meshfile=bulk.msh
mesh_units = 1e-4

