# pn-junction definition

meshfile = diode.msh

n_doping = 1e18
p_doping = 1e18
temperature = 300

statistics = B

mesh_units = 1e-4

start_voltage = -0.9
stop_voltage = 0.9
voltage_steps = 50
#start_voltage = 0
#stop_voltage = 0.1
#voltage_steps = 1

#simulation_method = GUMMEL

nonlinear_tolerance = 1e-9
nonlinear_abs_tolerance = 1e-12
nonlinear_ls_maxstep = 0.5
linear_tolerance = 1e-8
linear_abs_tolerance = 1e-15
nonlinear_max_it = 20
linear_max_it = 1000
integration_order = 2


scaling = 1

#refinement_stop_criterion=1e-4
max_refinement_steps=0

uniform_refinement=0

refine_fraction=0.7
coarsen_fraction=0.3
max_ref_level=6


