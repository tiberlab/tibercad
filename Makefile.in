# $Id: Makefile 126 2006-11-24 08:10:44Z maufder $
#

srcdir = @srcdir@

include Make.common

doxygen := @DOXYGEN@


MODULE_LIBS := -leigen_solver



export MODULE_LIBS

ifeq ($(target_os),darwin)
  DLLNAME := -Wl,-install_name,@rpath/$(relative_libdir)/$(dll_prefix)$(TIBERLIBNAME)$(shared_libext)
endif


all: core modules

. PHONY: core
core: $(libdir)/$(dll_prefix)$(TIBERLIBNAME)$(shared_libext)
	@$(MAKE) --no-print-directory -C src/tibercad tibercad


$(libdir)/$(dll_prefix)$(TIBERLIBNAME)$(shared_libext): src
	@echo "Linking $(dll_prefix)$(TIBERLIBNAME)$(shared_libext) ..."
	@$(CXX) -shared $(TIBER_OBJECTS) \
		-o $(libdir)/$(dll_prefix)$(TIBERLIBNAME)$(shared_libext) \
		$(MODULE_LIBS) $(DLLNAME) $(TENSORLIB) $(LDFLAGS)
		
#	@$(MAKE) --no-print-directory -C src all
#	@$(CXX) -shared $(CXXFLAGS) $(TIBER_OBJECTS) \
		-Wl,-soname,libtibercad.so.0 -o lib/libtibercad.so.0.0 \
		$(MODULE_LIBS) -lmkl_lapack $(LDFLAGS)
#	@cd lib && ln -f -s libtibercad.so.0.0 libtibercad.so.0 \
		&& ln -f -s libtibercad.so.0 libtibercad.so && cd ..


.PHONY: modules

modules: $(libdir)/$(dll_prefix)$(TIBERLIBNAME)$(shared_libext)
	@mkdir -p SDK/etc
	@cp share/modules.conf SDK/etc
	@$(MAKE) --no-print-directory -C src/SDK
	@$(MAKE) --no-print-directory -C src/core/modules

modules-clean:
	@$(MAKE) --no-print-directory -C src/SDK clean
	@$(MAKE) --no-print-directory -C src/core/modules clean


$(libdir)/libdl.a:
	@touch contrib/dlfcn-win32-r19/config.mak
	@$(MAKE) --no-print-directory -C contrib/dlfcn-win32-r19
	@cp contrib/dlfcn-win32-r19/libdl.a $(libdir)


clean: clean-src clean-doc
	@$(MAKE) --no-print-directory -C src/tibercad $(MAKECMDGOALS)
	@$(MAKE) --no-print-directory -C src/SDK $(MAKECMDGOALS)
	@$(MAKE) --no-print-directory -C src/core/modules $(MAKECMDGOALS)



distclean: clean-src clean-doc
	@$(MAKE) --no-print-directory -C manual $(MAKECMDGOALS)
	@$(MAKE) --no-print-directory -C src/tibercad $(MAKECMDGOALS)
	@$(MAKE) --no-print-directory -C src/SDK $(MAKECMDGOALS)
	@$(MAKE) --no-print-directory -C src/core/modules $(MAKECMDGOALS)
	@rm -rf $(ARCH)



.PHONY: src
src:
	@$(MAKE) --no-print-directory -C src all

clean-src:
	@$(MAKE) --no-print-directory -C src $(MAKECMDGOALS)

clean-doc:
	@$(MAKE) --no-print-directory -C src $(MAKECMDGOALS)


.PHONY: doc
doc:
	@$(MAKE) --no-print-directory -C doc



run_tests:
	@cd testsuite && ./run_tests -t all -v -i



.PHONY: manual
manual:
	@$(MAKE) --no-print-directory -C manual/Sphinx/Complete latexpdf



wininstaller linuxinstaller deb tgz tbz: manual SHAREDLIBS
	@$(MAKE) --no-print-directory -C installer $(MAKECMDGOALS)


sdk:
	@mkdir -p SDK/etc
	@cp share/modules.conf SDK/etc
	@./collect_headers
	@if test -e $(doxygen); then $(doxygen) share/Doxyfile_SDK; fi
	@tar jcf SDK.tbz SDK




SHAREDLIBS:
ifeq ($(target_os),win32)
	cp $$(find $$($(CC) -print-sysroot) -name *gcc_s*\.dll -o -name *gfortran*\.dll -o -name *stdc\+\+*\.dll -o -name *quadmath*\.dll) $(ARCH)/lib
endif


clean-dep:
	@find . -name "*.d" -exec rm -f {} \;


tags:
	@echo $(tibermodules)
	@rm h.tags C.tags
	@touch h.tags C.tags
	@for i in $(tibermodules); \
	do \
	  etags -a --members src/$$i/*.C -o C.tags ; \
	  etags -a --members include/$$i/*.h -o h.tags ; \
	done 


$(srcdir)/configure: configure.ac aclocal.m4
	cd '$(srcdir)' && autoconf


# autoheader might not change config.h.in, so touch a stamp file.
#$(srcdir)/config.h.in: stamp-h.in
$(srcdir)/stamp-h.in: configure.ac aclocal.m4
	echo timestamp > '$(srcdir)/stamp-h.in'
#	cd '$(srcdir)' && autoheader


config.h: stamp-h
stamp-h: config.h.in config.status
	./config.status

Makefile: Makefile.in Make.common.in config.status
	./config.status

config.status: configure VERSION
	./config.status --recheck


aclocal.m4: acinclude.m4
	aclocal -I /usr/share/aclocal
    
.PHONY: echo_cuda

echo_cuda:
	@echo $(have_cuda)


include Make.rules
