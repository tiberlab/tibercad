# $Id: Makefile 126 2006-11-24 08:10:44Z maufder $
#

srcdir = @srcdir@

include Make.common

doxygen := @DOXYGEN@


MODULE_LIBS := -leigen_solver



export MODULE_LIBS

ifeq ($(target_os),darwin)
  DLLNAME := -Wl,-install_name,@rpath/$(relative_libdir)/$(dll_prefix)$(TIBERLIBNAME)$(shared_libext)
endif


all: apps modules

apps: core
	@$(MAKE) --no-print-directory -C src/apps all


core: $(libdir)/$(dll_prefix)$(TIBERLIBNAME)$(shared_libext)


$(libdir)/$(dll_prefix)$(TIBERLIBNAME)$(shared_libext): core_obj
	@echo "Linking $(dll_prefix)$(TIBERLIBNAME)$(shared_libext) ..."
	@$(CXX) -shared $(TIBER_OBJECTS) \
		-o $(libdir)/$(dll_prefix)$(TIBERLIBNAME)$(shared_libext) \
		$(MODULE_LIBS) $(DLLNAME) $(LDFLAGS)

core_obj: include/tibercad/base/tiber_config.h
	@echo "Compiling tiberCAD core ..."
	@$(MAKE) --no-print-directory -C src


include/tibercad/base/tiber_config.h: config.h
	./tools/gen_tiber_config.sh


.PHONY: modules
modules: core
	@mkdir -p SDK/etc
	@cp share/modules.conf SDK/etc
	@$(MAKE) --no-print-directory -C modules

modules-clean:
	@$(MAKE) --no-print-directory -C modules clean


$(libdir)/libdl.a:
	@touch external/dlfcn-win32-r19/config.mak
	@$(MAKE) --no-print-directory -C external/dlfcn-win32-r19
	@cp external/dlfcn-win32-r19/libdl.a $(libdir)


clean: clean-src clean-doc
	@$(MAKE) --no-print-directory -C src/apps $(MAKECMDGOALS)
	@$(MAKE) --no-print-directory -C modules $(MAKECMDGOALS)



distclean: clean-src clean-doc
	@$(MAKE) --no-print-directory -C manual $(MAKECMDGOALS)
	@$(MAKE) --no-print-directory -C src/apps $(MAKECMDGOALS)
	@$(MAKE) --no-print-directory -C modules $(MAKECMDGOALS)
	@rm -rf $(ARCH)
	@rm -rf SDK


clean-src:
	@$(MAKE) --no-print-directory -C src $(MAKECMDGOALS)

clean-doc:
	@$(MAKE) --no-print-directory -C doc $(MAKECMDGOALS)


.PHONY: doc
doc:
	@$(MAKE) --no-print-directory -C doc



run_tests:
	@git submodule update --init --depth 1
	@if test -d testsuite; then \
	 cd testsuite && ./run_tests -t all -v -i ; \
	fi



.PHONY: manual
manual:
	@$(MAKE) --no-print-directory -C manual/Sphinx/Complete latexpdf



wininstaller linuxinstaller deb tgz tbz: manual SHAREDLIBS
	@$(MAKE) --no-print-directory -C installer $(MAKECMDGOALS)


sdk:
	@mkdir -p SDK/etc
	@cp share/modules.conf SDK/etc
	@./collect_headers
	@if test -e $(doxygen); then $(doxygen) share/Doxyfile_SDK; fi
	@tar jcf SDK.tbz SDK




SHAREDLIBS:
ifeq ($(target_os),win32)
	cp $$(find $$($(CC) -print-sysroot) -name *gcc_s*\.dll -o -name *gfortran*\.dll -o -name *stdc\+\+*\.dll -o -name *quadmath*\.dll) $(ARCH)/lib
endif


clean-dep:
	@find . -name "*.d" -exec rm -f {} \;


$(srcdir)/configure: configure.ac aclocal.m4
	cd '$(srcdir)' && autoconf


Makefile: Makefile.in Make.common.in config.status
	./config.status

aclocal.m4: acinclude.m4
	aclocal -I /usr/share/aclocal
    
config.h: config.h.in config.status
	./config.status

config.h.in:
	autoheader


include Make.rules
