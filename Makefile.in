# $Id: Makefile 126 2006-11-24 08:10:44Z maufder $
#

srcdir = @srcdir@


include Make.common



all: src
	@$(CXX) -shared -fPIC $(CXXFLAGS) \
		$(TIBER_OBJECTS) -o lib/libtibercad.so lib/libeigen_solver.so $(LIBS) $(LDFLAGS)
	@$(MAKE) -C src/tibercad tibercad


clean: src
	@$(MAKE) -C examples clean


distclean: src doc
	@$(MAKE) -C examples distclean
	@rm -f lib/*
	@rm -f bin/tibercad


.PHONY: src
src:
	@$(MAKE) -C src $(MAKECMDGOALS)



.PHONY: doc
doc:
	@$(MAKE) -C doc $(MAKECMDGOALS)




.PHONY: examples
examples: all
	@$(MAKE) -C examples




tags:
	@echo $(tibermodules)
	@rm h.tags C.tags
	@touch h.tags C.tags
	@for i in $(tibermodules); \
	do \
	  etags -a --members src/$$i/*.C -o C.tags ; \
	  etags -a --members include/$$i/*.h -o h.tags ; \
	done 


$(srcdir)/configure: configure.ac aclocal.m4
	cd '$(srcdir)' && autoconf


# autoheader might not change config.h.in, so touch a stamp file.
#$(srcdir)/config.h.in: stamp-h.in
$(srcdir)/stamp-h.in: configure.ac aclocal.m4
	echo timestamp > '$(srcdir)/stamp-h.in'
#	cd '$(srcdir)' && autoheader


config.h: stamp-h
stamp-h: config.h.in config.status
	./config.status

Makefile: Makefile.in Make.common.in config.status
	./config.status

config.status: configure
	./config.status --recheck


include Make.rules
