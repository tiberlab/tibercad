if test -e variables.sh
then
  . variables.sh
else
  echo "Cannot run build scripts without variables.sh file."
  exit 1
fi

target=@host_cpu@-@host_os@

# system
system=`uname -s`
case $system in
  CYGWIN_NT-* | MINGW*)
    SYSTEM=mingw
    ;;

  Linux)
    SYSTEM=linux-gnu
    ;;

  Darwin)
    SYSTEM=darwin
    ;;

  *)
    echo "$system is not supported"; exit 1 ;;
esac

# target system
case $target in
  *mingw* | *cygwin* )
    target_os=win32 ;;

  *darwin*)
    target_os=darwin ;;

  *linux* )
    target_os=linux ;;
esac

# architecture
march=`uname -m`

HOST=@host@
BUILD=@build@

TCBUILD=`${TOPDIR}/share/arch.sh`
TCHOST=`${TOPDIR}/share/arch.sh ${target}`
echo "*************************************************"
echo "* Host system :  $TCHOST"
echo "* Build system:  $TCBUILD"
echo "*************************************************"

if [ -d ${TOPDIR}/SDK/${TCHOST}/lib/gcc ]
then
  export PATH=${TOPDIR}/SDK/${TCHOST}/bin:${PATH}
  export LD_LIBRARY_PATH=${TOPDIR}/SDK/${TCHOST}/lib:${TOPDIR}/SDK/${TCHOST}/lib64
fi

CPP="@CPP@"
CC="@CC@"
CXX="@CXX@"
FC="@FC@"
#F90="${F90:-$FC}"
F77="${F77:-$FC}"
RANLIB="@RANLIB@"


export CC CXX F77 FC F90 RANLIB LD AR CPP

GNUFORTRAN=0
if command -v "$FC" >/dev/null 2>&1; then
  compiler_id=$("$FC" --version 2>/dev/null | head -n 1)
  if echo "$compiler_id" | grep -qi "GNU Fortran"; then
    GNUFORTRAN=1
  fi
fi



# compiler flags
CFLAGS="${CFLAGS} -fexceptions -fPIC"
FCFLAGS="${FCFLAGS} -fexceptions -fPIC"
if [ "$march" == "x86_64" ] &&  [ "${target_os}" != "win32" ] ; then
  CXXFLAGS="-fPIC ${CXXFLAGS}"
  CFLAGS="-fPIC ${CFLAGS}"
  FCFLAGS="-fPIC ${FCFLAGS}"
fi
#CXXFLAGS="${CXXFLAGS} -fPIC -std=gnu++17"
CXXFLAGS="${CXXFLAGS} -fPIC"

if [ ! "$GNUFORTRAN" = "1" ]; then
  FCFLAGS="${FCFLAGS} -gcc-name=$(which ${CC}) -gxx-name=$(which ${CXX}) -nofor-main"
fi

FFLAGS=${FCFLAGS}

export CXXFLAGS CFLAGS FFLAGS FCFLAGS


FORTRAN_LIBS="@FCLIBS@"

# then it is intel (for now we can only use gfortran ot intel ifort)
if [ "x$FORTRANDIR" != "x" ]; then
  case $march in
    x86_64) FLIBDIR=${FORTRANDIR}/lib/intel64 ;;
    i?86)   FLIBDIR=${FORTRANDIR}/lib/ia32 ;;
    *)      echo "FORTRANDIR cannot be used on architecture $march"; exit 1 ;;
  esac
  LDFLAGS="${LDFLAGS} -Wl,-rpath,${FLIBDIR}"
  FORTRAN_LIBS="${FORTRAN_LIBS} -Wl,-rpath,${FLIBDIR}"
  export LD_LIBRARY_PATH="${FLIBDIR}:${LD_LIBRARY_PATH}"
fi


export MPIDIR

if [ "${target_os}" = win32 ]
then
  CXXFLAGS="${CXXFLAGS} -I${MPIDIR}/Include"
  CFLAGS="${CFLAGS} -I${MPIDIR}/Include"
  FCFLAGS="${FCFLAGS} -I${MPIDIR}/Include"
  LDFLAGS="-L${MPIDIR}/Lib/x86"
  MPI_LIBS="-L${MPIDIR}/Lib/x86 -lmsmpifec -lmsmpi"
fi

# BLAS/LAPACK
if [ "$MKL" = y ]; then
  if [ $march = x86_64 ]; then
    LDFLAGS="${LDFLAGS} -L${MKLDIR}/lib/intel64 -Wl,-rpath,${MKLDIR}/lib/intel64"
    if [ "$GNUFORTRAN" = "1" ]; then
      LAPACKLIBS="--with-blas-lapack-lib=\"-Wl,--no-as-needed -Wl,-rpath,${MKLDIR}/lib/intel64 -L${MKLDIR}/lib/intel64 -lmkl_intel_lp64 -lmkl_gnu_thread -lmkl_core -lgomp -lm -lpthread\""
      LAPACK_LIBS="${LDFLAGS} -L${MKLDIR}/lib/intel64 -Wl,-rpath,${MKLDIR}/lib/intel64 -Wl,--no-as-needed -lmkl_intel_lp64 -lmkl_gnu_thread -lmkl_core -lgomp -lm -lpthread"
    else
      LAPACKLIBS="--with-blas-lapack-lib=\"-Wl,--no-as-needed -Wl,-rpath,${MKLDIR}/lib/intel64 -L${MKLDIR}/lib/intel64 -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core -liomp5 -lm -lpthread\""
      LAPACK_LIBS="${LDFLAGS} -L${MKLDIR}/lib/intel64 -Wl,-rpath,${MKLDIR}/lib/intel64 -Wl,--no-as-needed -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core -liomp5 -lm -lpthread"
    fi
 
  else
    LAPACKLIBS="--with-blas-lapack-lib=[-L${MKLDIR}/lib/32,-lmkl_intel,-lmkl_intel_thread,-lmkl_core,-liomp5,-lm,-lpthread]"
    LDFLAGS="${LDFLAGS} -L${MKLDIR}/lib/32 -Wl,-rpath,${MKLDIR}/lib/32"
    LAPACK_LIBS="${LDFLAGS} -L${MKLDIR}/lib/32 -Wl,-rpath,${MKLDIR}/lib/32"
  fi
else
  LAPACK_LIBS=$LAPACKLIBS
fi

export LAPACKLIBS LAPACK_LIBS

dll_libext=.so
dll_prefix=lib
if [ "${target_os}" = win32 ]
then
  dll_libext=.dll
  dll_prefix=
elif [ "${target_os}" = darwin ]
then
  dll_libext=.dylib
fi

