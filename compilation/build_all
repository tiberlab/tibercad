  fi
  if test ! -e "${SDKDIR}/x86_64-linux/lib/libboost_system-mt-x64.so"
  then
    echo "Build BOOST"
#  ./build_boost
  fi
  if test ! -e "${SDKDIR}/x86_64-linux/lib/libmesh_devel.so"
  then
    echo "Build BOOST"
