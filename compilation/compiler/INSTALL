#!/bin/bash
PACKAGER=ma
VERSION=4.6.0
PROD=gcc_mingw32

# SET THESE TO REASONABLE VALUES:
#PREFIX=/home/maufder/Programs
#EPREFIX=/home/maufder/Programs
#WORKDIR=/home/maufder/temp


. `dirname $0`/INSTALL.lib

#TARGET="i686-w64-mingw32 x86_64-w64-mingw32"
#SYSROOT=(i686-w64-mingw32 x86_64-w64-mingw32)
TARGET="i686-w64-mingw32"
SYSROOT=(i686-w64-mingw32)

i=0
for target in $TARGET
do
  echo "$target $i"
  mkdir -p ${EPREFIX}/${SYSROOT[$i]}
  i=$((i + 1))
done


#export CC=gcc-4.1.1
#export CXX=g++-4.1.1

GCCARCH=i686-pc-linux-gnu
#LIBSWITCH=
#if [ `uname -m` == "x86_64" ]
#then
#  GCCARCH=x86_64-unknown-linux-gnu
#  LIBSWITCH='%{!m32:64}%{m32:32}'
#fi

#cat <<PATCH >$WORKDIR/specs.patch
#--- ${ARCH}/lib/gcc/${GCCARCH}/${VERSION}/specs~	2005-05-11 18:34:14.000000000 +0200
#+++ ${ARCH}/lib/gcc/${GCCARCH}/${VERSION}/specs	2005-05-11 18:34:13.000000000 +0200
#@@ -93,7 +93,7 @@
# collect2
# 
# *link_libgcc:
#-%D
#+-rpath ${PREFIX}/${ARCH}/lib${LIBSWITCH} %D
# 
# *md_exec_prefix:
# 
#PATCH


export LD_LIBRARY_PATH=${EPREFIX}/lib
export LDFLAGS="-Wl,-rpath,${EPREFIX}/lib"

simplebuild http://ftp.sunet.se/pub/gnu/gmp gmp-5.0.2.tar.bz2 --enable-cxx --enable-mpbsd
simplebuild http://www.mpfr.org/mpfr-current mpfr-3.0.1.tar.bz2 --with-gmp=${EPREFIX}
simplebuild http://www.multiprecision.org/mpc/download mpc-0.9.tar.gz --with-gmp-include=${EPREFIX}/include --with-gmp-lib=${EPREFIX}/lib --with-mpfr-include=${PREFIX}/include --with-mpfr-lib=${EPREFIX}/lib
simplebuild http://www.cs.unipr.it/ppl/Download/ftp/releases/0.11.2/ ppl-0.11.2.tar.bz2 --with-libgmpxx-prefix=${EPREFIX} --with-cxxflags="-I ${PREFIX}/include"
export CXXFLAGS="-I ${PREFIX}/include"
export CFLAGS="-I ${PREFIX}/include"
export CPPLAGS="-I ${PREFIX}/include"
simplebuild ftp://gcc.gnu.org/pub/gcc/infrastructure cloog-ppl-0.15.11.tar.gz --with-ppl=${EPREFIX}/lib --with-gmp-library=${EPREFIX}/lib --with-gmp-include=${EPREFIX}/include


if prepare ftp://mirror.switch.ch/mirror/gnu/binutils/ binutils-2.21.tar.bz2
then
  
  cd ..
  i=0
  for target in $TARGET
  do
    mkdir -p build-binutils-$target
    cd build-binutils-$target

    ../binutils-2.21/configure --prefix=${PREFIX} --with-sysroot=${PREFIX}/${SYSROOT[$i]} \
      --exec-prefix=${EPREFIX} --target=$target --disable-nls
    make
    make install
    cd ..
    i=$((i + 1))
  done
  touch binutils-2.21.tar.bz2.ok
fi



MINGW_SRC=mingw-w64-v1.0-20110523
#if [ -e mingw-w64-v1.0-snapshot-20110523.tar.bz2 ] && [ ! -e mingw-w64-v1.0-snapshot-20110523.tar.bz2.ok ]
if prepare http://sourceforge.net/projects/mingw-w64/files/mingw-w64/mingw-w64-snapshot/ mingw-w64-v1.0-snapshot-20110523.tar.bz2
then
  #tar jxf mingw-w64-v1.0-snapshot-20110523.tar.bz2
  cd ..
  
  i=0
  for target in $TARGET
  do
    mkdir -p build_mingw-w64-$target
    cd build_mingw-w64-$target

    ../${MINGW_SRC}/mingw-w64-headers/configure --host=$target --build=$GCCARCH --prefix=${EPREFIX}
    #../${MINGW_SRC}/mingw-w64-headers/configure --host=$target --build=$GCCARCH --prefix=${PREFIX}/${SYSROOT[$i]}
    make install
    cd ..

    cd ${EPREFIX}/${SYSROOT[$i]}
    [ -e mingw ] || ln -s . mingw
    #mkdir -p $target/lib
    #cd $target
    #[ "x$(echo $target | grep x86_64)" != "x" ] && ln -f -s lib lib64
    i=$((i + 1))

    cd $WORKDIR
  done
fi




export PATH=${PREFIX}/bin:${PATH}

if prepare ftp://mirror.switch.ch/mirror/gnu/gcc/gcc-${VERSION} gcc-${VERSION}.tar.bz2
then

  cd ..
  i=0
  for target in $TARGET
  do
    [ -d build-gcc-$target ] && rm -rf build-gcc-$target
    mkdir -p build-gcc-$target
    cd build-gcc-$target

    #../${PROD}-${VERSION}/configure --prefix=${PREFIX} --with-sysroot=${PREFIX}/${SYSROOT[$i]} \
    ../gcc-${VERSION}/configure --prefix=${PREFIX} --with-headers=${EPREFIX}/${target}/include --with-libs=${EPREFIX}/${target}/lib --with-sysroot=${EPREFIX}/${SYSROOT[$i]} \
      --enable-languages=c,c++,fortran --enable-threads --exec-prefix=${EPREFIX} \
      --with-gmp-include=${EPREFIX}/include --with-gmp-lib="${EPREFIX}/lib -Wl,-rpath,${EPREFIX}/lib" \
      --with-mpfr-include=${PREFIX}/include --with-mpfr-lib="${EPREFIX}/lib -Wl,-rpath,${EPREFIX}/lib" \
      --with-ppl=${EPREFIX} --with-cloog="${EPREFIX}" \
      --target=$target --disable-multilib \
      --enable-sjlj-exceptions --enable-shared --disable-nls

    make all-gcc
    make install-gcc
    
  #cd ${PREFIX}
  #./${ARCH}/bin/gcc -dumpspecs > ${ARCH}/lib/gcc/${GCCARCH}/${VERSION}/specs
  #patch -p0 -l <${WORKDIR}/specs.patch

    cd ..
    [ -d build_crt-$target ] && rm -rf build_crt-$target
    mkdir -p build_crt-$target
    cd build_crt-$target
    #../${MINGW_SRC}/mingw-w64-crt/configure --host=$target --prefix=${PREFIX}/${SYSROOT[$i]} --with-sysroot=${PREFIX}/${SYSROOT[$i]}
    ../${MINGW_SRC}/mingw-w64-crt/configure --host=$target --prefix=${EPREFIX}
    make
    make install

    cd ../build-gcc-$target
    make
    make install
    cd ..
    i=$((i + 1))
  done

  touch gcc-${VERSION}.tar.bz2.ok
fi




