#!/bin/bash
PACKAGER=ma
VERSION=4.6.0
PROD=gcc

topdir=$(dirname $(dirname $PWD))

ARCH=$(${topdir}/share/arch.sh)
# You can set these to any reasonable value
#INSTALLPREFIX=${topdir}/SDK/gcc-$VERSION
#INSTALLEPREFIX=${INSTALLPREFIX}/$(${topdir}/share/arch.sh)
INSTALLPREFIX=${topdir}/SDK
INSTALLEPREFIX=${topdir}/SDK/$ARCH
WORKDIR=${topdir}/extern/gcc-4.6.0


. `dirname $0`/INSTALL.lib

PREFIX=$INSTALLPREFIX
EPREFIX=$INSTALLEPREFIX

export LD_LIBRARY_PATH=${EPREFIX}/lib
#export LDFLAGS="-Wl,-rpath-link,${EPREFIX}/lib -Wl,-rpath,'\$\$ORIGIN/../../../../../lib' -Wl,-rpath,'\$\$ORIGIN/../lib'"
export LD_RUN_PATH='$ORIGIN:$ORIGIN/../lib:$ORIGIN/../../../../lib'
echo $INSTALLEPREFIX
echo "$LD_RUN_PATH"

simplebuild http://ftp.sunet.se/pub/gnu/gmp gmp-5.0.2.tar.bz2 --enable-cxx --enable-mpbsd 
simplebuild http://www.mpfr.org/mpfr-3.0.1 mpfr-3.0.1.tar.bz2 --with-gmp=${EPREFIX} 
simplebuild http://www.multiprecision.org/mpc/download mpc-0.9.tar.gz --with-gmp-include=${EPREFIX}/include --with-gmp-lib=${EPREFIX}/lib --with-mpfr-include=${PREFIX}/include --with-mpfr-lib=${EPREFIX}/lib 
simplebuild http://bugseng.com/products/ppl/download/ftp/releases/0.11.2/ ppl-0.11.2.tar.bz2 --with-libgmp-prefix=${EPREFIX} --with-cxxflags="-I ${PREFIX}/include -I ${EPREFIX}/include" 
export CXXFLAGS="-I ${PREFIX}/include"
export CFLAGS="-I ${PREFIX}/include"
export CPPLAGS="-I ${PREFIX}/include"
simplebuild ftp://gcc.gnu.org/pub/gcc/infrastructure cloog-ppl-0.15.11.tar.gz --with-ppl=${EPREFIX}/lib --with-gmp-library=${EPREFIX}/lib --with-gmp-include=${EPREFIX}/include 


GCCARCH=i686-pc-linux-gnu
LIBSWITCH=
if [ `uname -m` == "x86_64" ]
then
  GCCARCH=x86_64-unknown-linux-gnu
  LIBSWITCH='%{!m32:64}%{m32:32}'

  cd ${EPREFIX}
  ln -s lib lib64
  cd ${WORKDIR}
fi

cat <<PATCH >$WORKDIR/specs.patch
--- lib/gcc/${ARCH}/${VERSION}/specs~	2005-05-11 18:34:14.000000000 +0200
+++ lib/gcc/${ARCH}/${VERSION}/specs	2005-05-11 18:34:13.000000000 +0200
@@ -93,7 +93,7 @@
 collect2
 
 *link_libgcc:
-%D
+-rpath ${PREFIX}/${ARCH}/lib${LIBSWITCH} %D
 
 *md_exec_prefix:
 
PATCH


if prepare ftp://mirror.switch.ch/mirror/gnu/${PROD}/${PROD}-${VERSION} ${PROD}-${VERSION}.tar.bz2
then

  cd ..
  mkdir -p build
  cd build
  #../${PROD}-${VERSION}/configure --prefix=${PREFIX} --enable-languages=c,c++,fortran --enable-__cxa_atexit --enable-threads --exec-prefix=${EPREFIX} --with-gmp-include=${DEPLIBS}/include --with-gmp-lib="${DEPLIBS}/lib -Wl,-rpath-link,${DEPLIBS}/lib" --with-mpfr-include=${DEPLIBS}/include --with-mpfr-lib="${DEPLIBS}/lib -Wl,-rpath-link,${DEPLIBS}/lib" --with-ppl-include=${DEPLIBS}/include --with-ppl-lib="${DEPLIBS}/lib -Wl,-rpath-link,${DEPLIBS}/lib"  --with-cloog-include=${DEPLIBS}/include --with-cloog-lib="${DEPLIBS}/lib -Wl,-rpath-link,${DEPLIBS}/lib"  
  ../${PROD}-${VERSION}/configure --prefix=${PREFIX} --enable-languages=c,c++,fortran --enable-__cxa_atexit --enable-threads --exec-prefix=${EPREFIX} --with-gmp-include=${EPREFIX}/include --with-gmp-lib="${EPREFIX}/lib" --with-mpfr-include=${PREFIX}/include --with-mpfr-lib="${EPREFIX}/lib" --with-ppl-include=${PREFIX}/include --with-ppl-lib="${EPREFIX}/lib"  --with-cloog-include=${PREFIX}/include --with-cloog-lib="${EPREFIX}/lib" --disable-multilib --disable-multiarch --with-fpmath=sse

  make all
  make install

  cd ${EPREFIX}
  ./bin/gcc -dumpspecs > lib/gcc/${GCCARCH}/${VERSION}/specs
  patch -p0 -l <${WORKDIR}/specs.patch

fi

echo "You might want to link ${HOME}/bin to ${EPREFIX}/bin and add ${HOME}/bin to your PATH"
