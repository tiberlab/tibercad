#!/bin/sh

GMSHVER=2.8.4

make_windows_package () {

  mkdir -m 0755 ${files}
  mkdir -p ${files}/doc
  mkdir -p ${files}/examples
  mkdir -p ${files}/materials
  #mkdir -p ${files}/lib

  # copy all files
  cp ${topdir}/${ARCH}/bin/tibercad.exe ${files}
  cp ${topdir}/${ARCH}/lib/*.dll ${files}
  cp ${topdir}/SDK/${ARCH}/lib/*.dll ${files}
  cp ${topdir}/SDK/${ARCH}/bin/*.dll ${files}
  cp -r ${topdir}/${ARCH}/modules ${files}
  cp ${topdir}/share/tibercad.ico ${files}
  cp ${topdir}/share/Copyright.txt ${files}
  cp ${topdir}/Changelog ${files}/Changelog.txt
  sed -e "s/<TIBERVERSION>/$version/" ${topdir}/share/Readme.txt > ${files}/Readme.txt
  #if test -e ${topdir}/manual/Sphinx/TiberCAD_Examples.pdf ; then
  #  cp ${topdir}/manual/Sphinx/TiberCAD_Examples.pdf ${files}/doc/Examples.pdf
  #fi
  #if test -e ${topdir}/manual/Sphinx/TiberCAD_MultiUsers.pdf ; then
  #  cp ${topdir}/manual/Sphinx/TiberCAD_MultiUsers.pdf ${files}/doc/MultiUsers.pdf
  #fi
  if test -e ${topdir}/manual/Sphinx/Complete/_build/latex/tiberCAD-manual.pdf
  then
    cp ${topdir}/manual/Sphinx/Complete/_build/latex/tiberCAD-manual.pdf ${files}/doc/UserManual.pdf
  fi
  cp -r ${topdir}/Tutorials/[^.]* ${files}/examples
  # for now:
  rm -rf ${files}/examples/Modules
  #rm -rf ${files}/examples/Example_1[7-9]
  #rm -rf ${files}/examples/Example_2[0-9]
  find ${files} -type d -name ".svn*" -exec rm -rf {} \;
  #find ${files}/examples -type d -name "reference" -exec rm -rf {} \;
  find ${files}/examples -name "test.conf" -exec rm -f {} \;
  cp ${topdir}/materials/*.txt ${files}/materials
  cp ${topdir}/materials/*.dat ${files}/materials
  cp ${topdir}/materials/*.etb ${files}/materials

  unix2dos=`which unix2dos`
  [ "x$unix2dos" == "x" ] && unix2dos=`which todos` ;
  curdir=`pwd`
  cd ${files}
  find ./materials -type f -exec $unix2dos {} \;
  # ATTENTION: do not process binary files with unix2dos!
  find ./examples -type f -not -name "*.tsv" -exec $unix2dos {} \;
  $unix2dos Copyright.txt
  $unix2dos Readme.txt
  $unix2dos Changelog.txt

  cd ${topdir}/contrib
  if [ ! -d gmsh-${GMSHVER} ]
  then
    mkdir gmsh-${GMSHVER}
    cd gmsh-${GMSHVER}
    wget http://www.geuz.org/gmsh/bin/Windows/gmsh-${GMSHVER}-Windows.zip
  fi
  if [ ! -f gmsh.pdf ]
  then
    wget http://www.geuz.org/gmsh/doc/texinfo/gmsh.pdf
  fi
  cd ${curdir}
  cd ${files}
  mkdir -p tools/gmsh
  cd tools/gmsh
  unzip ${topdir}/contrib/gmsh-${GMSHVER}/gmsh-${GMSHVER}-Windows.zip
  mv gmsh-${GMSHVER}-Windows/* .
  rmdir gmsh-${GMSHVER}-Windows
  cp ${topdir}/contrib/gmsh.pdf .

  cd $curdir

  return
}



