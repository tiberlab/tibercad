RequireReadme = 0
RequireLicense = 1
IconFile = @TIBERSHAREDIR@\share\tibercad.ico
HeaderTextColour = 0
; 
[Localization]
Entry0 = EnglishÂ¶Trutia AlexandruÂ¶@BINSTALLMAKERDIR@\Localization\English.ini
; 
[Folder]
Folder = @WININSTALLERDIR@\files
; 
[InstTasks]
fileassoc = ASSOCIATEEXTENSION¶tib¶TiberCAD input file¶<DefaultInstallPath>\tibercad.exe¶0
extract = RUN¶1¶1¶1¶<DefaultInstallPath>\data.exe¶¶
mklicdir = CREATEFOLDER¶<DefaultInstallPath>\license
; 
[UninstTasks]
; 
[uConfig]
RebootRequired = 0
UninstNorm = 0
UninstAll = 0
SkipExtString = 
IconExtUninst = 0
IconExtCustom = 0
IconExtPath = 
IconExtIndex = 0
; 
[iConfig]
RebootRequired = 0
PathChangeable = 1
DefaultPath = 
AutoCreateStartMenu = 1
