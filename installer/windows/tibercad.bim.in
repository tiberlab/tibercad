
; 
; Please do not modify this file by hand
; It may crash the program if mistakes are found
; Use BIM to modify it << Ha, see what we can do!!
; 
[Header]
FileID = Bytessence Install Maker
FileVersion = 2
; 
[GeneralInformation]
AppName = TiberCAD
Version = @TIBERVERSION@
CompanyName = TiberLab
Website = www.tibercad.org
Email = @PACKAGE_BUGREPORT@
OutPutFile = @WININSTALLERDIR@\tibercad_setup.exe
Compression = 1
W98 = 1
WME = 1
WNT = 1
W2K = 1
WXP = 1
WV = 1
DotNet = 0
RunIfDepNotFound = 
; 
[Look]
HeaderTextColour = 0
WizBitmap = @BINSTALLMAKERDIR@\Splash\Classic\Wizard.bmp
HeadBitmap = @BINSTALLMAKERDIR@\Splash\Classic\Header.bmp
IconFile = @TIBERSHAREDIR@\share\tibercad.ico
[FilesAndSettings]
ReadMe = @WININSTALLERDIR@\files\Readme.txt
License = @TIBERSHAREDIR@\Copyright.txt
RequireReadme = 1
RequireLicense = 1
; 
[Folder]
Folder = @WININSTALLERDIR@\files\
; 
[Localization]
Entry0 = English¶Bytessence/Michel Van Passel¶@BINSTALLMAKERDIR@\Localization\English@ascii.ini
;
[InstTasks]
fileassoc = ASSOCIATEEXTENSION¶tib¶TiberCAD input file¶<DefaultInstallPath>\tibercad.exe¶1
mklicdir = CREATEFOLDER¶<DefaultInstallPath>\license
assocgeo = ASSOCIATEEXTENSION¶geo¶GMSH geo file¶<DefaultInstallPath>/contrib/gmsh-2.2.0/gmsh.exe¶0
linkgmsh = NORMALLINK¶17¶gmsh¶<DefaultInstallPath>/contrib/gmsh-2.2.0/gmsh.exe¶0¶0¶GMSH 2.2.0
linkgmshmanual = NORMALLINK¶17¶GMSH manual¶<DefaultInstallPath>/contrib/gmsh-2.2.0/gmsh.pdf¶0¶0¶GMSH 2.2.0 Manual
linktibermanual = NORMALLINK¶17¶TiberCAD manual¶<DefaultInstallPath>/doc/manual.pdf¶0¶0¶TiberCAD Manual
; 
[UninstTasks]
; 
[uConfig]
RebootRequired = 0
SkipExtString = 
IconExtUninst = 0
IconExtCustom = 0
IconExtPath = 
IconExtIndex = 0
CreateUninstaller = 1
; 
[iConfig]
RebootRequired = 0
PathChangeable = 1
DefaultPath = 
AutoCreateStartMenu = 1
CreateUninstallLink = 1
CreateInternetLink = 1
ForceGroupCreation = 1
UninstOlderFirst = 1
; 
; EOF()
