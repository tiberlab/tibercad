#!/bin/sh

TIBERVER=@TIBERVERSION@

function install_gmsh {

  echo "Installing GMSH to ${instpath}/contrib/gmsh-2.2.0"
  cp -r contrib ${instpath}

  cat > ${instpath}/bin/gmsh <<EOF
#!/bin/sh

export TIBERCADROOT=$instpath

if [ -z \$LD_LIBRARY_PATH ]
then
  export LD_LIBRARY_PATH=\${TIBERCADROOT}/lib
else
  export LD_LIBRARY_PATH=\${TIBERCADROOT}/lib:\$LD_LIBRARY_PATH
fi

gmsh=\${TIBERCADROOT}/contrib/gmsh-2.2.0/gmsh
if [ -x \$gmsh ]
then
  exec \$gmsh \$@
else
  echo "Cannot execute \$gmsh. Perhaps broken installation?"
fi

EOF

  echo ""
  echo "Create a link to gmsh in "
  echo " 1. /usr/local/bin"
  echo " 2. /usr/bin"
  echo " 3. none"
  echo -n "Your choice [1]: "

  read answer

  bindir=/usr/local/bin
  case $answer in
    2) bindir=/usr/bin ;;
    3) bindir= ;;
    *) ;;
  esac

  if [ ! -z $bindir ]
  then
    here=`pwd`
    cd $bindir
    target=gmsh
    if [ -L gmsh ]
    then
      target=`ls -l gmsh | awk -F '>' '{print $2}' | grep "${instpath}/contrib"`
    fi

    if [ -f gmsh ] || [ -z $target ]
    then
      echo "GMSH seems already installed. I will not create the link."
    else
      rm -f gmsh
      ln -s ${instpath}/bin/gmsh gmsh
      echo "$bindir/gmsh" >> ${instpath}/files.lst
    fi
    cd $here
  fi

}


echo "###################################################"
echo "#      TiberCAD ver. $TIBERVER  installation      #"
echo "###################################################"

echo ""
echo -n "Provide installation directory [/usr/local/tibercad-$TIBERVER]: "
read instpath

echo ""

[ -z $instpath ] && instpath=/usr/local/tibercad-$TIBERVER

# try to create directory
if [ -f $instpath ]
then
  echo "$instpath is an existing file and not a directory!"
  exit 1
fi

if [ ! -d $instpath ]
then
  mkdir -p $instpath 2> /dev/null
fi

if [ $? -ne 0 ]
then
  echo "Could not create directory $instpath! Perhaps you don't have permissions?"
  exit 1
fi

# check if we can write to $instpath
mkdir $instpath/tibertestdir 2> /dev/null
if [ $? -ne 0 ]
then
  echo "I cannot write to $instpath!"
  exit 1
fi
rmdir  $instpath/tibertestdir


echo "Starting installation to $instpath"

# check if dir is empty
content=`ls -A $instpath`
if [ ! -z "$content" ]
then
  echo -n "Installation directory is not empty. Do you really want to proceed [n]? "
  read -e answer

  [ -z $answer ] && answer='n'
  case $answer in
    n|no) exit 0 ;;
    *) ;;
  esac
fi



cp -r bin materials examples license i386 doc share $instpath

#pathstring=`echo "$instpath" | sed -e 's/\//\\\\\//g'`
#sed -e "s/<INSTALLDIR>/$pathstring/g" ${instpath}/bin/tibercad.sh > ${instpath}/bin/tibercad.sh.tmp
#mv -f ${instpath}/bin/tibercad.sh.tmp ${instpath}/bin/tibercad.sh

cat > ${instpath}/bin/TiberCAD.sh <<EOF
#!/bin/sh

VER=$TIBERVER

# put your installation directory here (this is done automatically by the
# installation script)
export TIBERCADROOT=${instpath}

if [ -z \$LD_LIBRARY_PATH ]
then
  export LD_LIBRARY_PATH=\${TIBERCADROOT}/lib:\${TIBERCADROOT}/libtibermodels
else
  export LD_LIBRARY_PATH=\${TIBERCADROOT}/lib:\${TIBERCADROOT}/libtibermodels:\$LD_LIBRARY_PATH
fi

tibercad=\${TIBERCADROOT}/bin/tibercad
if [ -x \$tibercad ]
then
  exec \$tibercad \$@
else
  echo "Cannot execute \$tibercad. Perhaps broken installation?"
fi

EOF
chmod a+x ${instpath}/bin/TiberCAD.sh

cwd=`pwd`
cd ${instpath}/bin && ln -s TiberCAD.sh tibercad
cd $cwd


touch ${instpath}/files.lst
find ${instpath} -type f > ${instpath}/files.lst
cat > ${instpath}/bin/uninstall <<EOF
#!/bin/sh

instpath=${instpath}

echo -n "Do you really want to uninstall TiberCAD ver. $TIBERVER and all of its components [n]?"
read answer
[ -z \$answer ] && answer='n'
case \$answer in
  y|yes)
    rm -f \`cat \${instpath}/files.lst\`
    rm -f \${instpath}/bin/uninstall
    rm -r \${instpath}
    ;;

  *) ;;
esac
EOF
chmod a+x ${instpath}/bin/uninstall

echo ""
echo "Create a link to tibercad in "
echo " 1. /usr/local/bin"
echo " 2. /usr/bin"
echo " 3. none"
echo -n "Your choice [1]: "

read answer

bindir=/usr/local/bin
case $answer in
  2) bindir=/usr/bin ;;
  3) bindir= ;;
  *) ;;
esac

if [ ! -z $bindir ]
then
  here=`pwd`
  cd $bindir
  [ -L tibercad ] && rm -f tibercad
  ln -s ${instpath}/bin/tibercad tibercad
  echo "$bindir/tibercad" >> ${instpath}/files.lst
  cd $here
fi

echo ""
echo -n "Do you want to install GMSH version 2.2.0 [y]?"
read answer
[ -z $answer ] && answer='y'
case $answer in
  y|yes) install_gmsh ;;
  *) ;;
esac

echo ""
echo "Thank you for having installed TiberCAD."
echo "Please report bugs to support@tibercad.org"
echo ""
