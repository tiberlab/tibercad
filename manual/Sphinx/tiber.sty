\renewenvironment{notice}[2]{
  \def\py@noticetype{#1}
  \vspace{0.5cm}
  \begin{minipage}{1.2cm}
    \includegraphics[width=\linewidth]{#1.png}
  \end{minipage}
  \csname py@noticestart@#1\endcsname
  %\par\strong{#2}
}{\csname py@noticeend@\py@noticetype\endcsname\vspace{0.5cm}}


