PICFORMAT= *.fig *.png *.jpg

targets_eps := $(patsubst %.png, %.eps, $(wildcard *.png)) \
	       $(patsubst %.fig, %.eps, $(wildcard *.fig)) \
	       $(patsubst %.jpg, %.eps, $(wildcard *.eps)) 

targets_pdf := $(patsubst %.fig, %.pdf, $(wildcard *.fig)) \
	       $(patsubst %.eps, %.pdf, $(wildcard *.eps)) 


all: $(SUBDIRS) $(targets_pdf) $(targets_eps)


pdf: $(SUBDIRS) $(targets_pdf)


ps: $(SUBDIRS) $(targets_eps)


clean: $(SUBDIRS) clean-local

.PHONY: $(SUBDIRS)
$(SUBDIRS):
	@$(MAKE) -C  $@ ${MAKECMDGOALS}


%.eps: %.png
	convert -verbose $< $@

%.eps: %.jpg
	convert -verbose $< $@2 ; \
	mv $@2 $@

%.pdf: %.eps
	epstopdf $<

%.eps: %.fig
	fig2dev -L eps $< $@


clean-local:
	@for pic in *.eps; do { \
    if [ -r $${pic} ] ; then rm -f $${pic%.*}.pdf; fi; \
    }; done
	@for pic in *.fig *.jpg *.png; do { \
    if [ -r $${pic} ] ; then rm -f $${pic%.*}.eps; fi; \
    }; done


