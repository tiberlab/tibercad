# $Id$

# Common definitions for all Makefiles

##
##
## Path to packages we need
##
##

# $(tibermodules) are the subdirectories in $(topdir)/include
tibermodules := base/common base/io utils/Tensor
tibermodules += base/io/Read_ISE_grid
tibermodules += core/drift-diffusion core/macrostrain core/semiconductormodels
tibermodules += core/quantumEFAmodels core/solver-interfaces/petsc
tibermodules += core/classical-transport/excitons
tibermodules += utils/SLEPC

# libmesh can be found here
libmesh := /usr/pack/libmesh-0.5.0_20051010cvs-ma
include $(libmesh)/Make.common

# the spirit/boost libraries
spirit := /usr/pack/spirit-1.8.3-ma/boost
miniboost := /usr/pack/spirit-1.8.3-ma/boost/miniboost

# the GNU scientific library
gsl := /usr/pack/gsl-1.6-ma

# gmsh
GMSH := /usr/sepp/bin/gmsh-1.62.0-ma

##
##
## definitions
##
##

# some handy defaults
DIM := 2
ORDER := 1


# TIBERCAD includes
TIBER_INCLUDES += $(foreach module,$(tibermodules),-I$(topdir)/include/$(module))

ifdef PROFILE
  CXXFLAGS += -pg
endif

CXXFLAGS += $(TIBER_INCLUDES)
CXXFLAGS += -I$(miniboost) -I$(spirit)
CXXFLAGS += -I$(gsl)/include

LDFLAGS += -Wl,-rpath,$(gsl)/lib -L$(gsl)/lib -lgsl -lgslcblas
LDFLAGS += -Wl,-rpath,$(topdir)/lib -L$(topdir)/lib
LDFLAGS += $(topdir)/lib/libtensor.a

TIBER_OBJECTS := $(shell find $(topdir)/src -name "*.$(obj-suffix)")

vpath %.h $(TIBER_INCLUDES)


