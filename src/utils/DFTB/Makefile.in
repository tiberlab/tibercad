# $Id$

topdir = @abs_top_builddir@
include $(topdir)/Make.defs


CXXFLAGS = -fPIC -I $(topdir)/include/utils/DFTB


target := $(topdir)/libdftbpc$(shared_libext)


$(libdir)/libdftbpc$(shared_libext) :  DftbpWrapper$(obj-suffix) libdftbp.a
	@echo "Linking libdftbpc$(shared_libext) ..."
	@$(CXX) -shared -o $@ $< \
		-Wl,--version-script,export.map \
		-Wl,-Bsymbolic -Wl,-Bstatic \
		-L. libdftbp.a \
		-Wl,-Bdynamic



include $(topdir)/Make.rules
