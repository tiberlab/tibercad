# $Id$

topdir = @abs_top_builddir@
include $(topdir)/Make.defs
ARCH = $(shell uname -m)

CXXFLAGS = -fPIC -I $(topdir)/include/utils/UPTIGHT


target := $(libdir)/libuptight$(shared_libext)


$(libdir)/libuptight$(shared_libext) :  UptWrapper$(obj-suffix) libuptight_$(ARCH).a
	@echo "Linking libuptight$(shared_libext) ..."
	@$(CXX) -shared -o $@ $< \
		-Wl,--version-script,export.map \
		-Wl,-Bsymbolic -Wl,-Bstatic \
		-L. libuptight_$(ARCH).a \
		-Wl,-Bdynamic



include $(topdir)/Make.rules
