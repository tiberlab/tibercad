CFLAGS	   = 
CXXLAGS	   = 
FFLAGS     =
CPPFLAGS   = 
FPPFLAGS   =

PETSC_DIR  = @COMPLEX_PETSC_DIR@
PETSC_ARCH = @COMPLEX_PETSC_ARCH@

SLEPC_DIR  = @SLEPC_DIR@

CXX        = @CXX@


include $(SLEPC_DIR)/bmake/slepc_common_variables


CXXFLAGS += -fPIC $(CC_INCLUDES) -I ../../../include/utils/SLEPC



all: libeigen_solver.so


libeigen_solver.so:  Eigensolver.o
	@$(CXX) -shared -Wl,-soname,libeigen_solver.so \
		-Wl,--version-script,export.map \
		-o libeigen_solver.so Eigensolver.o  \
		-Wl,-Bsymbolic -Wl,-Bstatic \
		-L$(SLEPC_LIB_DIR) -lslepc -lslepcfortran \
		-L$(PETSC_LIB_DIR) -lmpiuni -lpetscts \
		  -lpetscksp -lpetscdm -lpetscmat -lpetscvec -lpetsc \
		$(ARPACK_LIB) \
		-L/usr/pack/mpich-1.2.7p1-ma/lib -lfmpich \
		-L/usr/pack/intel_fc-9.0-ma/lib -lifcore -lirc \
		-Wl,-Bdynamic
	@cp libeigen_solver.so ../../../lib



%.o: %.c
	@$(CXX) $(SLEPC_HAVE_ARPACK) $(CXXFLAGS) -c $<


clean:
	rm -f *.o libeigen_solver.so

distclean: clean


