CFLAGS	   = 
CXXLAGS	   = 
FFLAGS     =
CPPFLAGS   = 
FPPFLAGS   =

hostos     = @host_os@

PETSC_DIR  = @COMPLEX_PETSC_DIR@
PETSC_ARCH = @COMPLEX_PETSC_ARCH@

SLEPC_DIR  = @SLEPC_DIR@

CXX        = @CXX@


CXXFLAGS += -fPIC $(CC_INCLUDES) -I ../../../include/utils/SLEPC


# the default method is optimised
ifeq (x$(METHOD),x)
  METHOD := opt
endif

ifneq ($(METHOD), dbg)
PETSC_ARCH := $(PETSC_ARCH)-opt
else
CXXFLAGS += -g -DDEBUG -O0
endif


# shared library extension
shared_libext := so
ifeq ($(findstring cygwin,$(hostos)),cygwin)
  shared_libext := dll
endif



all: ../../../lib/libeigen_solver.$(shared_libext)


../../../lib/libeigen_solver.$(shared_libext):  EigenSolver.$(METHOD).o
	@echo "Linking libeigen_solver.$(shared_libext) ..."
	@$(CXX) -shared -o $@ $<  \
		-Wl,--version-script,export.map \
		-Wl,-Bsymbolic -Wl,-Bstatic \
		-L$(SLEPC_LIB_DIR) -lslepc \
		$(SLEPC_EXTERNAL_LIB) \
		-L$(PETSC_LIB_DIR) -lpetscts \
		  -lpetscksp -lpetscdm -lpetscmat -lpetscvec -lpetsc \
		-Wl,-Bdynamic $(PETSC_EXTERNAL_LIB_BASIC)



%.$(METHOD).o: %.C
	@echo "Compiling $< ..."
	@$(CXX) $(SLEPC_HAVE_ARPACK) $(CXXFLAGS) -c -o $@ $<


clean:
	@echo "cleaning up ./src/utils/SLEPC"
	@rm -f *.o

distclean: clean



include $(SLEPC_DIR)/bmake/slepc_common_variables
