# $Id$

topdir := ../..

include $(topdir)/Make.common

ADDITIONAL_LIBS = @LIBREADLINE@ $(topdir)/src/utils/license/liblicense.a
PACKAGEFLAGS = -Wl,-rpath,'$$ORIGIN/../$(relative_libdir)' -Wl,-rpath-link,$(libdir)

SUFF := .bin
ifeq ($(METHOD),dbg)
  SUFF := _dbg$(SUFF)
endif


ifeq ($(findstring cygwin,$(hostos)),cygwin)
  objects += tibercad_res.o
endif


all: tibercad

tibercad: $(objects) 
	@echo "Compiling tibercad executable ..."
	@$(CXX) $(CXXFLAGS) $(objects) $(PACKAGEFLAGS) -o $(topdir)/bin/tibercad$(SUFF) \
		-Wl,-export-dynamic -L$(libdir) \
		-l$(TIBERLIBNAME) $(ADDITIONAL_LIBS) $(PACKAGEFLAGS)


tibercad_static: $(objects)
	@echo "Compiling statically linked tibercad executable ..."
	@$(CXX) $(CXXFLAGS) $(objects) -o $(topdir)/bin/tibercad_static$(SUFF) \
		-Wl,-export-dynamic -L$(libdir) \
		-Wl,-rpath,$(libdir) -Wl,-Bstatic -ltibercad -Wl,-Bdynamic \
		$(ADDITIONAL_LIBS) \
		$(MODULE_LIBS) $(LDFLAGS) $(PACKAGEFLAGS)



tibercad_res.o : $(topdir)/share/tibercad.rc $(topdir)/share/tibercad.ico $(topdir)/include/base/common/tiber_config.h
	windres -I $(topdir)/share -I $(topdir)/include/base/common \
	  -O coff -D SVNREVISION=$(SVNREVISION) $< -o $@


include $(topdir)/Make.rules
