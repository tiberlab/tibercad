# $Id$

topdir := ../..

include $(topdir)/Make.common

ADDITIONAL_LIBS = @LIBREADLINE@ $(topdir)/src/utils/license/liblicense.a
PACKAGEFLAGS = -Wl,-rpath,$(topdir)/lib

#
# source files
srcfiles 	:= $(wildcard *.C)

#
# object files
objects		:= $(patsubst %.C, %.$(obj-suffix), $(srcfiles))

ifeq ($(findstring cygwin,$(hostos)),cygwin)
  objects += tibercad_res.o
endif


all: tibercad

tibercad: $(objects) 
	@echo "Compiling tibercad executable ..."
	@$(CXX) $(CXXFLAGS) $(objects) -o $(topdir)/bin/tibercad \
		-Wl,-export-dynamic -L$(topdir)/lib \
		-ltibercad $(ADDITIONAL_LIBS) $(PACKAGEFLAGS)



tibercad_res.o : $(topdir)/share/tibercad.rc
	windres -I $(topdir)/share $^ -o $@


include $(topdir)/Make.rules
