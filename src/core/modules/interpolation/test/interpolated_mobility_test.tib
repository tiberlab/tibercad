
# Description of  the  device physical regions
Device
{
  meshfile = bulk.msh
  mesh_units = 1e-9
  material = aNPD


   Region bulk 
   {
   }

   Region int_anode 
   {
   }

   Region int_cathode
   {
   }

}


Module dd_generic
{ 

  name = ddg
  plot = (ElPotential, QFermi, Density, RefEnergy, Mobility, CurrentDensity, Flux, NetRecombination, ContactCurrents)

  Physics
  {

    carrier electron
    {
      charge = -1

      density_of_states gauss
      {
        level = -2.2
        sigma = 0.13
        N0 = 9.6e20
      }
    }


    carrier hole
    {
      charge = 1

      density_of_states gauss
      {
        level = -5.5
        sigma = 0.13
        N0 = 9.6e20
      }
    }

    mmobility constant
    {
      carriers = (electron, hole)
      mu = 1e-6
    }

    mobility interpolated
    {
      carriers = (electron, hole)
      interpolation_module = interpolation
      model_name = mobility_bobbert
      temperature_var = temperature
      field_var = el_field
      density_var = density
    }

    recombination direct 
    {
      carriers = (electron, hole)
      C = 1e-11
    }

  }

  Contact anode
  {
    type = schottky
    metal_fermilevel = -5.0
    band = hole
    voltage = $Vb
    scott_malliaras = true
    #isolated_carriers = ()
  }

  Contact cathode
  {
    type = schottky
    metal_fermilevel = -3.5
    band = electron
    voltage = 0.0
    scott_malliaras = true
    #isolated_carriers = ()
  }

  Solver linesearch
  {
    max_iterations = 20
    step_tolerance = 1e-3 # 1e-12
    #absolute_tolerance = 1e-3 # 1e-12
    #relative_tolerance = 1e-5 # 1e-12
  }

}

Module interpolation
{
  model mobility_bobbert
  {
    file_name = aNPD_parameters.h5
    principal_variable = temperature
    variables = (el_field, density)
    log_data = true
    log_variables = (density)
  }
}

Module sweep
{
  solve = ddg
  variable = $Vb
  start = 0.0
  stop = 5.0
  steps = 50
  plot_data = true
}



Simulation
{
  temperature = 300
  solve = (ddg, sweep)
  resultpath = output/
  output_format = grace
}














