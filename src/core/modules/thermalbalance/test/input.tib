# diode example

$Device
{

  Options
  {
    meshfile = diode.msh
    dimension = 1
    material = Si
    mesh_units = 1e-6
  }

  Region Bulk
  {
    doping = 1e12
  }

}


# Definition of  Simulation Models  and associated Boundary Conditions 
$Models
{ 
 
  model thermalbalance
  {

   options
   {
    
    simulation_name = tt
    plot = (LatticeTemp,GRAY)
    physical_regions = Bulk
    #---MULTISCALE ERROR----
    ms_error = 1e-6
    ms_iter = 1
    fourier_guess = 0

   vg = 1e4
   custom_dir = 1
   n_dir = 1
   dir_1 = (1,0,0)
   }


   physical_model heat_transport
   {
     type = gray
     max_iter = 1
     max_error = 1e-6
   }

   BC_Regions  
   {

     BC_Region anode
     {
       type = heat_reservoir
       temperature = 0
     }

     BC_Region cathode
     {
       type = heat_reservoir
       temperature = 1
     }

   }
  }

}


# Definition of  Model-dependent Solver parameters

$Solver
{

}

# Definition of  model-indipendent parameters of the Simulation


$Simulation
{
  searchpath = .
  temperature = 300
  verbose = 3
  solve = (tt)
  resultpath = output
  output_format = grace
}





