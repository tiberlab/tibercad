Device
{
    dimension = 3 
    meshfile = mesh.msh
    mesh_units = 1e-9
    material = AlGaN
    x = 0.2
    x-growth-direction = (-1,0,1,0) 
    y-growth-direction = (-1,2,-1,0) 
    z-growth-direction = (0,0,0,1)
    Region Well  {material = GaN}
}

Module elasticity 
{

Physics
{
  BodyForce lattice_mismatch
  {
    x-growth-direction = (-1,0,1,0) 
    y-growth-direction = (-1,2,-1,0) 
    z-growth-direction = (0,0,0,1)
    reference_material = AlGaN
    x = 0.2 
  }

   Boundary Clamp{regions = Base}

  }

}

Simulation{solve = elasticity}





