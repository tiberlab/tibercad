Device
{
   meshfile = module.msh
   mesh_units = 0.01

   Region active { }

   Region P1 { }
   Region P2 { }
   Region P3 { }

}

Module pvmodule
{
  name = pvmodule_sim

  plot = (TopPotential, BottomPotential, CurrentDensity, ContactCurrent)

  voltage = $Vb[0]

  Physics
  {
    
    # assume ITO/cell/ITO with 10 Ohm/sq
    top_sheet_resistivity = 10
    bottom_sheet_resistivity = 10

    P2_resistivity = 0.001

    #elementary_cell list { }

  }

  Contact anode
  {
    type = source
    layer = bottom
  }

  Contact cathode
  {
    type = ground
    layer = bottom
  }

}

Module sweep
{
  solve = pvmodule_sim
  variable = $Vb

  values = (0:0.1:4.0)
  plot_data = (0:0.5:4.0)
}


Simulation
{
  verbose = 2

  solve = sweep

  # look here first for modules
  modellibpath = ../..

  temperature = 300
  
  
  resultpath = output
  searchpath = ./
}














