
# Description of  the  device physical regions
Device
{
   meshfile = module.msh

   Region active 
   {
   }

}

Module pvmodule
{

  Physics
  {

    top_sheet_resistivity = 5
    bottom_sheet_resistivity = 10
  }

}

Simulation
{
  verbose = 2

  # look here first for modules
  modellibpath = ../..

  temperature = 300
  
  solve = pvmodule
  
  resultpath = output
}














