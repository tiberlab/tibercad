
# Description of  the  device physical regions
Device
{
   meshfile = module.msh
   mesh_units = 0.01

   Region active 
   {
   }

}

Module pvmodule
{
  name = pvmodule_sim
  Physics
  {

    top_sheet_resistivity = 10
    bottom_sheet_resistivity = 5
  }

  Contact anode
  {
    type = source
    layer = top
  }

  Contact cathode
  {
    type = ground
    layer = bottom
  }

}

Simulation
{
  verbose = 2

  # look here first for modules
  modellibpath = ../..

  temperature = 300
  
  solve = pvmodule_sim
  
  resultpath = output
  searchpath = ./
}














