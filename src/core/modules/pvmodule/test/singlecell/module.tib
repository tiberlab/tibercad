
# Description of  the  device physical regions
Device
{
   meshfile = module.msh
   mesh_units = 0.01

   Region active 
   {
   }

}

Module pvmodule
{
  name = pvmodule_sim

  plot = (TopPotential, BottomPotential, CurrentDensity, ContactCurrent)

  voltage = $Vb[0]

  Physics
  {

    top_sheet_resistivity = 5
    bottom_sheet_resistivity = 5
  }

  Contact anode
  {
    type = source
    layer = top
  }

  Contact cathode
  {
    type = ground
    layer = bottom
  }

}


Module sweep
{
  solve = pvmodule_sim
  variable = $Vb
  values = (0:0.02:1.2)

  plot_data = (0.0, 1.1)
}

Simulation
{
  verbose = 2

  # look here first for modules
  modellibpath = ../..

  temperature = 300
  
  solve = sweep
  
  resultpath = output
  searchpath = ./
}














