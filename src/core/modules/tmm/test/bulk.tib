Device
{
  meshfile = bulk.msh 

  Region AIR 
  {
  Incoherency = 1
  material = Optic_Air
  optical_data = /home/pamiri/TiberCAD/materials/optics/Air_book
  }

  Region ITO 
  {
  Incoherency = 0
  material = Optic_ITO
  optical_data = /home/pamiri/TiberCAD/materials/optics/ITO-1.2E21_book.dat

  }

  Region PTAA
  {
  Incoherency = 0
  material = Optic_PTAA
  optical_data = /home/pamiri/TiberCAD/materials/optics/PTAA_Santbergen.dat
  }

  Region PSK
  {
  Incoherency= 0
  material = Optic_PSK
  optical_data = /home/pamiri/TiberCAD/materials/optics/PSK.dat
  }

  Region SnO
  {
  Incoherency = 0
  material = Optic_SnO2
  optical_data = /home/pamiri/TiberCAD/materials/optics/SnO2_book.dat
  }

}


Module tmm
{ 
  
  name = tmm_study 
  plot = (GenerationRate)
  
  reflectivity = 0
  incident_angle = 0
  up_lambda = 600
  down_lambda = 280

  Physics 
  {

  }

  Contact point1
  {
  type = incident_wave
  }

}



Simulation
{
  verbose = 2
  solve = tmm_study
  resultpath = output


}





