Device
{
  meshfile = bulk.msh 

  Region left 
  {
  material = Pt_test
  optical_data = /home/pamiri/TiberCAD/materials/optics/Pt_book.dat
  }

  Region middle
  {
  material = Si
  optical_data = /home/pamiri/TiberCAD/materials/optics/Si_book.dat
  }

  Region right 
  {
  material = Si
  optical_data = /home/pamiri/TiberCAD/materials/optics/Si_book.dat
  }
}


Module tmm
{ 

  name = tmm_study
  plot = (GenerationRate)
  wavelengths = $W_l[450.0]
  incident_angle = 0
  radiation = 1
  Physics
  {

  }
  Contact point1
  {
  type = incident_wave
  }

}

Module sweep
{
  name = sweep_wave_length
  solve = tmm_study
  variable = $W_l
  start = 250.0
  stop = 850.0
  steps = 10
  plot_data = true
}


Simulation
{
  verbose = 2
  solve = sweep_wave_length
  resultpath = output


}





