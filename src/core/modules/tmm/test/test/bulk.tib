Device
{
  meshfile = bulk.msh 

  illumination_spectrum  = /home/pamiri/TiberCAD/materials/optics/Sun1p5am.dat
  Region left 
  {
  #material = Pt_test
  material = Si
  optical_data = /home/pamiri/TiberCAD/materials/optics/Pt_book.dat
  }

  Region middle
  {
  material = Si
  optical_data = /home/pamiri/TiberCAD/materials/optics/Si_book.dat
  }

  Region right 
  {
  material = Si
  optical_data = /home/pamiri/TiberCAD/materials/optics/Si_book.dat
  }
}


Module tmm
{ 
  
  name = tmm_study
  
  plot = (GenerationRate)

  incident_angle = 0

  Physics
  {

  }
  Contact point1
  {
  type = incident_wave
  }
}



Simulation
{
  verbose = 2
  solve = tmm_study
  resultpath = output


}





