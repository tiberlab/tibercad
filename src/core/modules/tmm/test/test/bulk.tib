Device
{
  meshfile = bulk.msh 

  Region left 
  {
  material = Pt_test
  optical_data = /home/pamiri/TiberCAD/materials/optics/Pt_book.dat
  }

  Region middle
  {
  material = Si
  optical_data = /home/pamiri/TiberCAD/materials/optics/Si_book.dat
  }

  Region right 
  {
  material = Si
  optical_data = /home/pamiri/TiberCAD/materials/optics/Si_book.dat
  }
}


Module tmm
{ 

  name = tmm_study
  plot = (GenerationRate)
  wavelengths = 450
  incident_angle = 0
  radiation = 1
  Physics
  {

  }
  Contact point1
  {
  type = incident_wave
  }
}




Simulation
{
  verbose = 2
  solve = tmm_study
  resultpath = output


}





