  	Incoherency= 1
  	material = Glass
  }
  Region AIR2 
  {
  	Incoherency = 0
  	material = Air
  }
}


Module tmm
{ 
  
  name = tmm_study 
  plot = (X,GenerationRate,Intensity,ElectricField, Reflection,Transmission,Absorbtion)
