Device
{
  meshfile = Example_7.msh 
  mesh_units = 1e-9
  dimension = 1

  Region Air
  {
  Incoherency = 0
  material = Air
  }

}


Module tmm
{ 
  
  name = tmm_study 
  plot = (Internal_Source_ElectricField,Internal_Poynting,Internal_Power,Internal_Absorption)
  wavelengths = 450
  wave_number_steps = 200
  polarization = TM
  orientation = V
  wave_number_ratio = 1
  dipole_power = 0.2
  dipole_coordinate = 500

  Physics 
  {

  }

}



Simulation
{
  verbose = 2
  solve = tmm_study
resultpath = output/


}





