Device
{
  meshfile = Example_8.msh 
  mesh_units = 1e-9
  dimension = 1
  Region GaN
  {
  Incoherency = 0
  material = GaN_optic
  }
}


Module tmm
{ 
  
  name = tmm_study 
  plot = (Internal_Source_ElectricField,Internal_Poynting,Internal_Power,Internal_Absorption,Internal_Intensity)
  wavelengths = 300
  Emission-spectrum-file = Spectrum.dat
  wave_number_steps = 1
  polarization = TM
  orientation = H
  wave_number_ratio = 0
  dipole_power = 1
  dipole_coordinate = 500

  Physics 
  {

  }

}



Simulation
{
  verbose = 2
  solve = tmm_study
resultpath = output/
searchpath = ./

}





