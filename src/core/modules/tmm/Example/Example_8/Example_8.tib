Device
{
  meshfile = Example_8.msh 
  mesh_units = 1e-9
  dimension = 1
  Region GaN
  {
  Incoherency = 0
  material = GaN_optic
  }
}


Module tmm
{ 
  
  name = tmm_study 
  plot = (Internal_Source_ElectricField,Internal_Poynting,Internal_Power,Internal_Absorption)
  wavelengths = 300
  dipole_steps = 200
  dipole_ratio = 1
  polarization = 1
  orientation = 0
  dipole_power = 0.2
  dipole_coordinate = 500

  Physics 
  {

  }

}



Simulation
{
  verbose = 2
  solve = tmm_study
resultpath = output/


}





