Device
{
  meshfile = Example_10.msh 
  mesh_units = 1e-9
  dimension = 1

  Region Air
  {
  Incoherency = 0
  material = Air
  }
  Region GaN
  {
  Incoherency = 0
  material = GaN_optic
  }
  Region Ag
  {
  Incoherency = 0
  material = Ag
  }
}


Module tmm
{ 
  
  name = tmm_study 
  plot = (Internal_Source_ElectricField,Internal_Poynting,Internal_Power,Internal_Absorption)
  wavelengths = 800
  Emission-spectrum-file = Spectrum.dat
  wave_number_steps = 300
  polarization = TE
  orientation = H
  wave_number_ratio = 1
  dipole_power = 0.2
  dipole_coordinate = 350

  Physics 
  {

  }

}



Simulation
{
  verbose = 2
  solve = tmm_study
resultpath = output/
searchpath = ./

}





