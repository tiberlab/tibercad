Device
{
  meshfile = Example_1.msh 
  mesh_units = 1e-6
  dimension = 1

  Region AIR
  {
  Incoherency = 0
  material = Air
  }
  Region Ag 
  {
  Incoherency= 0
  material = Ag
  }



}


Module tmm
{ 
  
  name = tmm_study 
  plot = (GenerationRate,Intensity,External_Source_ElectricField, Reflection,Transmission,Absorbtion)
  
  back_reflectivity = 0
  incident_angle = 0
  wavelength_uper_lim = 950
  wavelength_lower_lim = 300
  wavelength_steps = 1

  Physics 
  {

  }
  Contact point1
  {
  type = incident_wave
  }

}



Simulation
{
  verbose = 2
  solve = tmm_study
  resultpath = output


}





