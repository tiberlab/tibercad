Device
{
  meshfile = Example_11.msh 
  mesh_units = 1e-9
  dimension = 1

  Region Air
  {
  Incoherency = 0
  material = Air
  }
  Region GaN
  {
  Incoherency = 0
  material = GaN_optic
  }
  Region Ag
  {
  Incoherency = 0
  material = Ag
  }
}


Module tmm
{ 
  
  name = tmm_study 
  plot = (Internal_Source_ElectricField,Internal_Poynting,Internal_Power,Internal_Absorption,Generation_regions)
  wavelengths = 800
  wave_number_steps = 300
  wave_number_ratio = 1
  polarization = TEM
  orientation = VH
  dipole_power = (0.5 0.4 0.3 0.2 0.1)
  dipole_coordinate = (350 400 450 500 550)

  Physics 
  {

  }

}



Simulation
{
  verbose = 2
  solve = tmm_study
resultpath = output/


}





