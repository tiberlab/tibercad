# $Id$

topdir := ../../../../..

include $(topdir)/Make.common

ifeq ($(have_cuda),yes)
  CUDACONF=--with-cuda=@CUDA_DIR@
endif

ifeq ($(have_mkl),yes)
  MKLCONF=--with-mkl=@MKL_DIR@ --with-thread-library=@THREAD_LIBRARY@
endif

ARCH = $(shell uname -m)

CXXFLAGS = -fPIC  

UPTREPO=https://github.com/tiberlab/uptight.git

target := libuptight$(shared_libext)


libuptight$(shared_libext) :  .$(ARCH)/UptWrapper$(obj-suffix) libuptight_$(ARCH).a
	@echo "Linking libuptight$(shared_libext) ..."
	@$(CXX) -shared -o $@ $< \
		-Wl,--version-script,export.map \
		-Wl,-Bsymbolic -Wl,-Bstatic \
		-L. libuptight_$(ARCH).a \
		-Wl,-Bdynamic
	
.$(ARCH)/UptWrapper$(obj-suffix) : libuptight_$(ARCH).a 

libuptight_$(ARCH).a: update
	echo "Compiling libuptight ..."; \
	cd uptight/src; \
	CC=$(CC) CXX=$(CXX) FC=$(FC) ./configure $(CUDACONF) $(MKLCONF) --with-subversion=$(SVN); \
	$(MAKE) -C api libuptight; 
	@mv uptight/src/api/libuptight_$(ARCH).a .	
	@cp uptight/src/api/fortran.h .
	@cp uptight/src/api/uptight.h . 

update: checkout
	cd uptight; git pull origin;
	
checkout:
	@if [ ! -e uptight ]; then \
		echo "Checkout libuptight ..."; \
		git clone $(UPTREPO); \
		cd $(topdir)/materials; \
		if [ -e ETB ]; then \
		  if [ ! -h ETB ]; then \
		    printf '%b\n' '\033[1;31m\e[1mmaterials/ETB already exists. Please resolve manually.\e[0m'; \
		    printf "%b\n" "\033[1;31m  --> should be a symbolic link to modules/etb/libuptight/uptight/parameters\e[0m"; \
		  fi \
		else \
		  ln -s src/core/modules/etb/libuptight/uptight/parameters ETB; \
		fi \
	fi
	

	

include $(topdir)/Make.rules
