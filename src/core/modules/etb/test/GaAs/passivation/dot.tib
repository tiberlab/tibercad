Device
{
  meshfile = dot.msh 
  mesh_units = 1e-10

  x-growth-direction = (1, 0, 0)
  y-growth-direction = (0, 1, 0)
  z-growth-direction = (0, 0, 1)

  material = GaAs


  Region dot
  {
  }

  Atomistic tb
  {
    reference_region = dot
    regions = dot
    passivation = yes
    periodicity = false
    cells_along_y = 2
    cells_along_z = 2
    print = (xyz)
  }

}


 
Module empirical_tb
{
  regions = dot
  name = tb
  atomistic_structure = tb
  Harrison_scaling = true
  relativistic = true
  
  plot = (tbstates)


  Solver
  {
    guess_valence = 0.0
    guess_conduction = 0.5
    num_valence_eigenvalues = 6
    num_conduction_eigenvalues = 4
  }

}

Module opticstb
{
  name = opt
  regions = dot 

  initial_state_model = tb
  final_state_model = tb

  skip_solve = true
  
  plot = (matrix_elements, optical_spectrum_k_0)
  output_format = grace

  Emin = 0.2
  Emax = 3.0
  dE = 0.001

}


Simulation
{
  solve = (tb, opt)
  resultpath =  output

}
