Device test
{
   meshfile = nanocolumn.msh
   mesh_units = 1e-9
   dimension = 3

   Region nside
   {
      material = PCBM-simple
      Doping {
         Nd = 1e17
         type = donor
      }
   }

   Region pside
   {
      material = P3HT-simple
      Doping {
         Nd = 1e17
         type = acceptor
      }
   }

   Region intrinsic
   {
      material = P3HT_PCBM
   }

}

Module driftdiffusion
{
   name = dd
   plot = (Ec, Ev, eQFermi, hQFermi)

   Solver
   { 
      nonlin_max_it = 100
   }
  
   Contact anode
   { 
     type = ohmic
     voltage = $Vb[1.0]
   }

   Contact cathode
   {
     type = ohmic
     voltage = 0.0 
   } 

   #save_state = true
   load_state = ./output/dd_Vb_1.tsv
}

Module poisson
{
   name = poiss
   plot = (ChargeDensity, Potential)
   
   Physics
   {
      charge_density 
      {
         charge_density = dd
         regions = (nside, pside)
      }
   }

   Boundary cathode
   {
     type = dirichlet 
     potential = dd
   }

   Boundary anode 
   {
     type = dirichlet 
     potential = dd
   }
}


Module kmc
{
  name = kmc
  regions = intrinsic  
  
  potential_simulation = poisson
  qfermi_simulation = dd
  Boundary int_anode{}
  Boundary int_cathode{}

  Solver
  {
     executable_name = "../../osc-sim/bin/osc"
     input_folder = "kmc_input"
     create_blend = false 
     blend_donor = P3HT-simple
     blend_acceptor = PCBM-simple
     constant_generation_rate = 0.0
     disorder = 0.010 
     simulation_time = 1e-4
     eps_r = 3.5     
     el_injection_rate = 1e10 
     max_el_collection_cathode = 100
     max_hl_collection_cathode = 100
     max_el_collection_anode = 100 
     max_hl_collection_anode = 100
  }

  plot = (elDensity, hlDensity, Potential)
}

Module sweep
{
  solve = dd
  variable = $Vb
  start = 0.9
  stop = 1.0
  steps = 10 
  plot_data = true
}


Simulation
{
   temperature = 300
   solve = (dd, poiss, kmc)
   resultpath = output
   database_path = .
   modellibpath = ..
   searchpath = .
   output_format = vtk
}
