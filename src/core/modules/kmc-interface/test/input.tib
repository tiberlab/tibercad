Device test
{
   meshfile = box_in_cube.msh
   mesh_units = 1e-9
   dimension = 3

   Region nside
   {
      material = PCBM-simple
      Doping {
         Nd = 1e17
         type = donor
      }
   }

   Region pside
   {
      material = P3HT-simple
      Doping {
         Nd = 1e17
         type = acceptor
      }
   }

   Region intrinsic
   {
      material = P3HT_PCBM
   }

}

Module driftdiffusion
{
   name = dd
   plot = (Ec, Ev, eQFermi, hQFermi, ElField, eDensity, hDensity, ChargeDensity, ElPotential)

   #Physics
   #{
   #  particle_density
   #  {
   #    quantum_density = kmc  # :(
   #  }
  # 
  # }

  
   Contact anode
   { 
     type = ohmic
     voltage = $Vb[0.5]
   }

   Contact cathode
   {
     type = ohmic
     voltage = 0.0 
   } 

   
}

Module poisson
{
   name = poiss
   plot = (ChargeDensity, Potential)
   
   Physics
   {
      charge_density 
      {
         charge_density = dd
         regions = (nside, pside)
      }
   }

   Boundary cathode
   {
     type = dirichlet 
     potential = dd
   }

   Boundary anode 
   {
     type = dirichlet 
     potential = dd
     #type = neumann 
     #displacement = dd 
   }
}



Module kmc
{
  name = kmc
  regions = intrinsic  
  
  potential_simulation = poisson
  qfermi_simulation = dd
  Boundary int_anode{}
  Boundary int_cathode{}

  Solver
  {
     executable_name = "../osc-sim/bin/osc"
     input_folder = "kmc_input"
     create_blend = false 
     blend_donor = P3HT-simple
     blend_acceptor = PCBM-simple
     constant_generation_rate = 100.0
     disorder = 0.010 
     simulation_time = 2e-6
     eps_r = 3.5     
  }

  plot = (elDensity)
}


Simulation
{
   temperature = 300
   solve = (dd, poiss, kmc)
   resultpath = output
   database_path = .
   modellibpath = ..
   searchpath = .
   output_format = vtk
}
