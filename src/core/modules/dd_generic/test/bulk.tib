
# Description of  the  device physical regions
Device
{
  meshfile = bulk.msh
  material = Si


   Region bulk 
   {
     Doping { Nd = 1e15 type = donor}
   }

   Region ndop 
   {
     Doping { Nd = 1e19 type = donor }
   }

   Region pdop 
   {
     Doping { Nd = 1e19 type = acceptor }
   }


}


Module dd_generic
{ 

  name = driftdiffusion
  plot = (ElPotential, QFermi, Density, RefEnergy, Mobility,
          IonizedDonors, Flux, NetRecombination)

  #Solver trustregion { max_step = 100 }

  Physics
  {
    doping
    {
      donor_reference_carrier = electron
      acceptor_reference_carrier = hole
    }

    carrier
    {
      name = eguest
      regions = bulk
      charge = -1

      density_of_states gauss
      {
        level = 1.9
        sigma = 0.15
        N0 = 1e18
      }
    }

    carrier
    {
      name = hguest
      regions = bulk
      charge = 1

      density_of_states gauss
      {
        level = 1.2
        sigma = 0.1
        N0 = 1e18
      }
    }



    carrier
    {
      name = electron
      #regions = (bulk, ndop)

      density_of_states bulk_kp
      {
        level = 2.1
        sigma = 0.13
        N0 = 1e19
      }
    }


    carrier
    {
      name = hole
      #regions = (bulk, pdop)

      density_of_states bulk_kp
      {
        level = 1.4
        sigma = 0.11
        N0 = 1e19
      }
    }

    mobility constant
    {
      carriers = (electron, hole)
      mu = 1000
    }

    mobility constant
    {
      carriers = (eguest, hguest)
      mu = 10
    }

    recombination direct 
    {
      carriers = (electron, hole)
      C = 1e-10
    }

#    recombination direct 
#    {
#      carriers = (gueste, guesth)
#      C = 1e-10
#    }

  }   


  Contact anode
  {
    type = ohmic
    voltage = $Vb
    #isolated_carriers = (gueste, guesth)
  }

  Contact cathode
  {
    type = ohmic
    voltage = 0.0
    #isolated_carriers = (gueste, guesth)
  }

}  



Module sweep
{
  solve = driftdiffusion
  variable = $Vb
  start = 0.0
  stop = 1
  steps = 10
  plot_data = true
}



Simulation
{
  temperature = 300
  solve = (driftdiffusion, sweep)
  resultpath = output
  output_format = grace
}














