
# Description of  the  device physical regions
Device
{
  meshfile = bulk.msh
  material = Si


   Region bulk 
   {
     Doping { Nd = 1e16 type = donor}
   }

   Region ndop 
   {
     Doping { Nd = 1e19 type = donor }
   }


}


Module dd_generic
{ 

  name = driftdiffusion
  plot = (ElPotential, QFermi, QFermi, Density, RefEnergy, Mobility,
          IonizedDonors)

  local_scaling = false

  Physics
  {
    doping
    {
      donor_reference_carrier = electron
      acceptor_reference_carrier = hole
    }

    carrier
    {
      name = pippo
      charge = -1

      density_of_states bulk_kp
      {
      }
    }

    carrier
    {
      name = electron

      density_of_states bulk_kp
      {
      }
    }


    carrier
    {
      name = hole

      density_of_states bulk_kp
      {
      }
    }

    mobility constant
    {
      carriers = (electron, hole)
      mu = 1000
    }

    mobility constant
    {
      carriers = (pippo)
      mu = 1000
    }
    #recombination srh {}

  }   


  Contact anode
  {
    type = ohmic
    voltage = $Vb
  }

  Contact cathode
  {
    type = ohmic
    voltage = 0.0
  }

}  



Module sweep
{
  solve = driftdiffusion
  variable = $Vb
  start = 0.0
  stop = 1
  steps = 10
  plot_data = true
}



Simulation
{
  temperature = 300
  solve = sweep #driftdiffusion #sweep
  resultpath = output
  output_format = grace
}














