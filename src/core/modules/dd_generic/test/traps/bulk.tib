
# Description of  the  device physical regions
Device
{
  meshfile = bulk.msh
  material = GaAs


   Region bulk 
   {
     Doping { Nd = 1e15 type = donor}
   }

   Region ndop 
   {
     Doping { Nd = 1e19 type = donor }
   }

   Region pdop 
   {
     Doping { Nd = 1e19 type = acceptor }
   }


}


Module dd_generic
{ 

  name = driftdiffusion
  plot = (ElPotential, QFermi, Density, RefEnergy, Mobility,
          IonizedDonors, Flux, NetRecombination, ContactCurrent)

  Solver
  {
    #step_tolerance = 0.01
    max_iterations = 20
  }

  Physics
  {
    doping
    {
      donor_reference_carrier = electron
      acceptor_reference_carrier = hole
    }


    carrier electron
    {
      #regions = (bulk, ndop)

      #density_of_states gauss
      #{
      #  level = 3.5
      #  sigma = 0.13
      #  N0 = 1e19
      #}
    }


    carrier hole
    {
      #regions = (bulk, pdop)

      #density_of_states bulk
      #{
      #  level = 0.0
      #  sigma = 0.11
      #  N0 = 1e19
      #}
    }

    mobility constant
    {
      carriers = (electron, hole)
      mu = 1000
    }



    recombination direct 
    {
      carriers = (electron, hole)
      C = 1e-9
    }

    trap eNeutral #fixed_charge
    {
      Nt = 1e17
      Et = 0.1
      reference = m
      carriers = (electron, hole)
      sigma_e = 1e-12
      sigma_h = 1e-12
      recombination_center = true
    }

    recombination optical
    {
      regions = bulk
      carriers = (electron, hole)
      multiplier = $x[0]
      generation = 1e21
      plot_name = "optical"
    }

  }   


  Contact anode
  {
    type = ohmic
    voltage = $Vb
    isolated_carriers = electron
  }

  Contact cathode
  {
    type = ohmic
    voltage = 0.0
    isolated_carriers = hole
  }

}  



Module sweep
{
  solve = driftdiffusion
  variable = $Vb
  start = 0.0
  stop = 1.5
  steps = 15
  #plot_data = true
}


Module sweep
{
  name = sweep_back
  solve = driftdiffusion
  variable = $Vb
  start = 1.5
  stop = 0
  steps = 30
  plot_data = true
}


Module sweep
{
  name = sweep_gen
  solve = driftdiffusion
  variable = $x
  type = log
  start = 1e-18
  stop = 1
  #plot_data = true
}



Simulation
{
  temperature = 300
  solve = (driftdiffusion, sweep, sweep_gen, sweep_back)
  resultpath = output
  output_format = grace
}














