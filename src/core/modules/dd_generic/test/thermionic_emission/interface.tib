Device
{
  meshfile = interface.msh
  material = Si  # Alq3


  Region left {
    Doping {
      density = 1e17 type = donor
      #incomplete_ionization = false
      reference_carrier = electron
    }
  }

  Region right {
    Doping {
      density = 1e20 type = donor
      incomplete_ionization = false
      #reference_carrier = elr
    }
  } 
}

Module dd_generic
{
  name = ddg
  plot = (Ec, Ev, ElPotential, QFermi, RefEnergy, Density, Mobility, 
            CurrentDensity, Flux, NetRecombination, ContactCurrents, ElField)

  current_integration_method = compact_rstf

  Solver
  {
    step_tolerance = 1e-4 
    
  }


  Physics
  {

    #----------------------------------------

    # SEMICONDUCTOR

    #----------------------------------------


    carrier electron
    {
      regions = (left)
      charge = -1

      density_of_states bulk  { level = 0.0  }
    }


    carrier elr
    {
      regions = (right)
      charge = -1

      density_of_states bulk
      {

         level = -0.86  # -0.835  #-0.8

      }
    }

    #----------------------------------------

    mobility constant
    {
      regions = (left)
      carriers = (electron)
     }

    mobility constant
    {
      regions = (right)
      carriers = ( elr)
     }


    # BAND COUPLING 

    recombination direct
    {
      regions = (left/right)
      carriers = (electron, elr)
      C = 1.15e7
    }


 }

  Contact anode
  {
    type = ohmic
    band = electron
    voltage = 0.0 
  }

  Contact cathode
  {
    type = ohmic  
    band = elr
    voltage = $Vb  
  }
}


Module sweep
{
  name = sweep_back
  solve = ddg
  variable = $Vb
  start = 0.0
  stop = -1.0
  #values = (0.0:0.05:3.0)
  steps = 50
  plot_data = true
}

Module sweep
{
  name = sweep_fw
  solve = ddg
  variable = $Vb
  start = 0.0
  stop = 1.0
  values = (0.0:0.02:1.0)
  #steps = 60
  plot_data = true
}

Module sweep
{
  name = sweep_tot
  solve = ddg
  variable = $Vb
  start = -1.0
  stop = 1.0
  #values = (0.0:0.05:3.0)
  steps = 100
  plot_data = true
}


Simulation
{
  temperature = 300
  solve = (ddg, sweep_back)#  sweep_1, sweep_2)
  resultpath = output
}

