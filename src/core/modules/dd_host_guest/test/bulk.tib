
# Description of  the  device physical regions
Device
{
  meshfile = bulk.msh
  material = Si
  mesh_units = 1e-7


   Region bulk 
   {
     Doping { Nd = 1e16 type = acceptor}
   }

   Region ndop 
   {
     material = Si_n
     Doping { Nd = 1e18 type = donor }
   }

   Region pdop 
   {
     material = Si_p
     Doping { Nd = 1e18 type = acceptor }
   }


}


Module dd_host_guest
{ 

  name = driftdiffusion
  plot = (eCurrentDensity, hCurrentDensity, eCurrentDensityG, hCurrentDensityG, Ec, Ev, EcG, EvG, eQFermi, hQFermi, eQFermiG, hQFermiG, Density, NetRecombination, ContactCurrents)

  Solver 
  { 
    max_iterations = 100
  }


  Physics
  {
    background_conductivity = 1e-6

    band_properties
    {
      density_of_states bulk
      {
      }
    }

 
    conduction_band_guest
    {
      regions = bulk
      density_of_states gauss
      {
        level = 2.0
        N0 = 1e18
        sigma = 0.1
      }
    }

    valence_band_guest
    {
      regions = bulk
      density_of_states gauss
      {
        level = 1.0
        N0 = 1e16
        sigma = 0.1
      }
    }

    conduction_band_guest
    {
      regions = (ndop, pdop)
      density_of_states gauss
      {
        level = 2.5
        N0 = 1e19
      }
    }

    valence_band_guest
    {
      regions = (ndop, pdop)
      density_of_states gauss
      {
        level = 0.3
        N0 = 1e19
      }
    }


    recombination srh { tau_n = 1e-7 tau_p = 1e-7 }
    #recombination direct { C = 1e-12 }
    recombination direct { coupling = HG C = 1e-10 }
    recombination host_guest { C = 1e-10 }
    recombination host_guest { bands = h C = 1e-10 }

    mobility
    {
      mu = 1e-4
    }
  }   


  Contact anode
  {
    type = ohmic
    voltage = $Vb
    rec_velocity_n = 1e6
  }

  Contact cathode
  {
    type = ohmic
    voltage = 0.0
    rec_velocity_p = 1e6
  }

}  



Module sweep
{
  solve = driftdiffusion
  variable = $Vb
  start = 0.0
  stop = 1
  steps = 50
  plot_data = true
}



Simulation
{
  temperature = 300
  searchpath = .
  solve = sweep
  resultpath = output
  output_format = grace
}














