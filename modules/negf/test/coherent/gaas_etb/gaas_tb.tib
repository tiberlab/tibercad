
# Description of  the  device physical regions
Device
{

  Parallel
  {  
   mpi_processes_per_mesh = 1
  }

  meshfile = bulk.msh  
  mesh_units = 1e-9

  material = GaAs 

   Doping { Nd = 1e15  type = donor  } 

   Region dd_source_region
   {
   }


   Region bulk
   {
   }

   Region dd_drain_region
   {
   }


   Quantum_contact c_source
   {
    regions = bulk  
    length = 0.565 
   }
   
   Quantum_contact c_drain
   {
    regions = bulk 
    length = 0.565
   }

   Atomistic str 
   {
      reference_region = bulk 
      regions = (c_source, bulk, c_drain)
      passivation = no 
      # fold_into_box = true

 
      #z_length = 6 
      #y_length = 6
      
      print = (xyz, tgn)
  }

}

# Definition of  Simulation Models  and associated Boundary Conditions 
Module driftdiffusion
{
  regions=(dd_source_region, bulk, dd_drain_region)
  # is default
  # statistics = fermidirac

  # we solve only for electrons
  #coupling = electrons

  #save_state = true
  
  plot = (Ec, Ev, eQFermi, eQFermi, eDensity, hDensity,
          eCurrentDensity, hCurrentDensity, NetRecombination,
          ElField, ElPotential, ContactCurrent)

  Physics
  {
   particle_density
   { 
      statistics =  fermidirac
   }
  }

  Contact drain
  {
    voltage = $Vd[0.00]
  }

  Contact source
  {
    voltage = 0.0
  }
 
}

Module empirical_tb
{
  regions = (c_source, bulk, c_drain)
  name = tb
  atomistic_structure = str 
  Harrison_scaling = false 
  potential_simulation = driftdiffusion
  relativistic = false

  parallel_as_mesh = true


  plot = (tbstates)

  Solver
  {
    num_valence_eigenvalues = 2   
    num_conduction_eigenvalues = 2   
    #guess_valence = -3.0
    #guess_conduction = -0.2
    #long_tolerance = 1e-4
  }

}


Module negf
{
  plot = (elDensity)
  # plot = (Current, LDOS)
  regions = bulk

  potential_simulation = driftdiffusion
  Boundary c_source{}
  Boundary c_drain{}

  disable_contact_calculation = false

  Solver
  {
    parallel_k_groups = 1

    # General settings
    delta = 1e-7  # Important for converging on real axis (needs to be small enough)
    verbosity = 70
    number_of_PL = 5

    # For density
    #Np_contour = (30,100)
    #Npoles = 0
    Np_real = 300
    deltaEc = 0.14
    n_kT = 15

    # For current
    Emin = 0.14
    Emax = 0.45
    Estep = 0.05
  }

  Physics
  {
     hamiltonian etb {simulation = tb}
  }

  k_integration_current
  {
    verbose = 3
    #gamma_point_calculation = true
    quadrature_rule = trapezoidal
    #k_max = 0.50
    number_of_elements = (2,2)
  }

  k_integration_density
  {
    verbose = 1 
    #gamma_point_calculation = true
    quadrature_rule = trapezoidal
    number_of_elements = (2,2)
  }

}

# Definition of  model-independent parameters of the Simulation
Simulation
{
  temperature = 300
  solve = (driftdiffusion,negf) 
  resultpath = output
  output_format = grace 
}

