Device
{
  meshfile = Example_9.msh 
  mesh_units = 1e-9
  dimension = 1

  Region Air
  {
  Incoherency = 0
  material = Air
  }

  Region GaN
  {
  Incoherency = 0
  material = GaN_optic
  }
}


Module tmm
{ 
  
  name = tmm_study 
  plot = (Internal_Source_ElectricField,Internal_Poynting,Internal_Power,Internal_Absorption)
  wavelengths = 450
  Emission-spectrum-file = Spectrum.dat
  wave_number_steps = 0
  polarization = TE
  orientation = H
  wave_number_ratio = 0.5
  dipole_power = 0.2
  dipole_coordinate = 800

  Physics 
  {

  }

}



Simulation
{
  verbose = 2
  solve = tmm_study
resultpath = output/
searchpath = ./

}





