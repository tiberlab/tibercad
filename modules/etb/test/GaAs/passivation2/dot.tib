Device
{
  meshfile = dot.msh 
  mesh_units = 1e-9

  x-growth-direction = (1, 0, 0)
  y-growth-direction = (0, 1, 0)
  z-growth-direction = (0, 0, 1)

  material = GaAs


  Region dot
  {
  }

  Atomistic tb
  {
    reference_region = dot
    regions = dot
    passivation = yes
    periodicity = (0, 0, 0)
    #minimal_cell = true  # if projection is not rectangular
    #use_primitive_cell = true
    print = (xyz)
  }

}


 
Module empirical_tb
{
  regions = dot
  name = tb
  atomistic_structure = tb
  Harrison_scaling = true
  relativistic = true
  
  plot = (tbstates)


  Solver
  {
    guess_valence = 0.0
    guess_conduction = 0.5
    num_valence_eigenvalues = 6
    num_conduction_eigenvalues = 4
  }

}


Simulation
{
  solve = (tb)
  resultpath =  output

}
