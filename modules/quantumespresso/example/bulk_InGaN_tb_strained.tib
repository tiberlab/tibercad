Module sweep
{
  name = sweep_bias1
  solve = (dd)#, spectrum)
  variable = $bias
  start = 0.2
  stop = 2.0 # 3.0
  steps = 18 # 14
  #min_step = 1e-3
  plot_data = true
}



Module sweep
{
  name = sweep_bias
  solve = (dd, tb, opticstb) #spectrum)
  variable = $bias
  start = 2.0
  stop = 3.4
  steps = 14
  #min_step = 1e-3
  plot_data = true
}




 

Simulation
{  
   
  temperature = 300
  verbose = 5
  solve = (strain, vff, quantumespresso, tb)   
  #solve = (sweep_bias, sweep_gen, quantum_efa, spectrum)   
  #solve = (strain, vff, sweep_bias1, sweep_bias)
  #solve = (strain, vff, dd, tb, opticstb)
  #solve = (sweep_bias1)
  #resultpath = "output_random/output_"INCONT"_@INDEX@"
  resultpath = rnd_test
  output_format = grace

}
