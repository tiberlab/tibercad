Device
{
  meshfile = nin.msh
  material = GaAs


   Region intrinsic 
   {
     Doping { Nd = 1e15 type = donor}
   }

   Region ndop 
   {
     Doping { Nd = 1e19 type = donor }
   }

   Region pdop 
   {
     Doping { Nd = 1e19 type = donor }
   }


}


Module dd_generic
{ 

  name = driftdiffusion
  plot = (RefEnergy, QFermi, Flux, ContactCurrents, Conductivity)

  Physics
  {

    carrier electron
    {
      density_of_states bulk_kp
      {
      }
      conductivity_model = constant
      conductivity = 1e-6
    }

  }   


  Contact anode
  {
    type = ohmic
    voltage = $Vb
  }

  Contact cathode
  {
    type = ohmic
    voltage = 0.0
  }

}  



Module sweep
{
  solve = driftdiffusion
  variable = $Vb
  start = 0.0
  stop = 1
  steps = 10
  plot_data = true
}



Simulation
{
  temperature = 300
  solve = sweep
  resultpath = output
}














