if [ $MPI == 'n' ]; then
  MPIFLAGS="--with-mpi=0"
else
  #MPI="--with-mpi-dir=${MPIDIR}  --known-mpi-shared-libraries=1"
  MPIFLAGS="--known-mpi-shared-libraries=1"
  if [ "${target_os}" = "win32" ]
  then
    MPIFLAGS="--with-mpi-compilers=0 --with-mpi-include=[${MPIDIR}/Include,${MPIDIR}/Include/x86] --with-mpi-lib=[-L,${MPIDIR}/Lib/x86,-Xlinker,-Bstatic,msmpifec,msmpi,quirk,-Xlinker,-Bdynamic] --known-mpi-shared-libraries=1"
  fi
fi
LAPACKLIBS=${LAPACKLIBS:-"--download-f-blas-lapack=1"}

petsc_host=
petsc_dll_name=${dll_prefix}petsc

if [ "${target_os}" = "win32" ]
then
  petsc_host="--with-host-vendor=w64 --with-host-os=mingw32"
fi


CONFIGOPTS="--with-matlab=0 $SHARED  $MPIFLAGS $COMPILERS --with-clanguage=cxx --with-batch=1 --with-x=0 ${petsc_host} --with-ssl=0"
#CONFIGOPTS="--with-matlab=0 $SHARED  $MPI $COMPILERS --with-clanguage=C++ ${LAPACKLIBS} --with-batch=1 --with-x=0 \
#  ${petsc_host} --download-mumps=yes  --download-parmetis=1 --download-scalapack=1 --download-blacs=1"

export FCFLAGS="-fno-range-check $FCFLAGS"
export FFLAGS=$FCFLAGS


export PETSC_DIR=${PWD}

export PETSC_ARCH=${TCHOST}
if [ "x$LINKONLY" == 'x' ]; then
  make_petsc real
fi
link_library real

export PETSC_ARCH=${TCHOST}-complex
if [ "x$LINKONLY" == 'x' ]; then
  make_petsc complex 
fi
link_library complex

