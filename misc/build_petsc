#COMPILERS="--CXXFLAGS=$CXXFLAGS --FCFLAGS=$FCFLAGS --CFLAGS=$CFLAGS --FFLAGS=$FFLAGS"
#COMPILERS="--with-cc=$CC --with-cxx=$CXX --with-fc=$FC --with-ranlib=$RANLIB --with-cpp=$CPP --with-shared-ld=$LD --with-ar=${AR}"
#COMPILERS="--with-cc=$CC --with-cxx=$CXX --with-fc=$FC --with-ranlib=$RANLIB \
