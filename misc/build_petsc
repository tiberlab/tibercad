#  COMPILERS="--with-cc=$CC --with-cxx=$CXX --with-fc=$FC"
#COMPILERS="--CXXFLAGS=$CXXFLAGS --FCFLAGS=$FCFLAGS --CFLAGS=$CFLAGS --FFLAGS=$FFLAGS"
