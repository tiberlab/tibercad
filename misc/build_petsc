#!/bin/bash

if [ ! -e common.sh ]; then
  echo "Need configuration file (common.sh)."
  exit 1
fi

. common.sh


# Does the actual build
# needs at least 1 argument ('real' or 'complex')
# second argument can be 0 or 1, 1 for creating debug version
make_petsc()
{

  datatype=$1
  debug=0
  if [ $# -ge 2 ]
  then
    debug=$2
  fi

  if [ -e  ${TOPDIR}/misc/reconfigure-${PETSC_ARCH}.py ]
  then
    cp ${TOPDIR}/misc/reconfigure-${PETSC_ARCH}.py .
  fi

  echo "Building with PETSC_ARCH=${PETSC_ARCH} ..."

  if [ ! -e  reconfigure-${PETSC_ARCH}.py ] && [ ! -e  conftest-${PETSC_ARCH} ]; then
    #./config/configure.py ${CONFIGOPTS} --with-debugging=${debug} --with-scalar-type=${datatype} \
    #  --CFLAGS="${CFLAGS}" --FFLAGS="-fno-range-check ${FFLAGS}" --CXXFLAGS="${CXXFLAGS}" --LDFLAGS="${LDFLAGS}"
    ./configure \
    --CC="$CC" --CXX="$CXX" --FC="$FC" --F77="$F77" --CPP="$CPP" \
    --CXXFLAGS="$CXXFLAGS" --FCFLAGS="$FCFLAGS" --CFLAGS="$CFLAGS" \
    --FFLAGS="$FFLAGS" --LDFLAGS="$LDFLAGS" \
    ${CONFIGOPTS} --with-debugging=${debug} --with-scalar-type=${datatype} \
    --with-blas-lapack-lib="${LAPACK_LIBS}"
    #cp conftest conftest-${PETSC_ARCH}

    if [ "$target_os" != "win32" ]; then
      mpirun ./conftest-${PETSC_ARCH}
      #cp reconfigure.py reconfigure-${PETSC_ARCH}.py
    fi
  fi

  if [ -e  reconfigure-${PETSC_ARCH}.py ]; then
    ./reconfigure-${PETSC_ARCH}.py

    if [ "$target_os" == "win32" ]; then
      cp ${PETSC_ARCH}/include/petscconf.h ${PETSC_ARCH}/include/petscconf.h.bkp
      sed "/PETSC_HAVE_GETPAGESIZE/,+2 d" ${PETSC_ARCH}/include/petscconf.h.bkp |
      sed "/PETSC_HAVE_SLEEP/,+2 d" > ${PETSC_ARCH}/include/petscconf.h 
    fi

    make
  fi
  rm conftest* reconfigure*
}

link_library()
{
  datatype=$1

    libname=${petsc_dll_name}_${datatype}
    #[ $debug -eq 1 ] && libname=${libname}_dbg

    # need to delete mpiuni, or we get troubles
    if [ "$MPI" = y ]; then
      echo "Remove libmpiuni.a"
      rm ${PETSC_DIR}/${PETSC_ARCH}/lib/libmpiuni.a
    fi

    ARCHIVES="-Wl,--whole-archive ${PETSC_DIR}/${PETSC_ARCH}/lib/*.a -Wl,--no-whole-archive"
    if [ "$target_os" = darwin ]
    then
      #ARCHIVES="-L${PETSC_DIR}/${PETSC_ARCH}/lib -Wl,-all_load"
      ARCHIVES=
      for l in $(ls ${PETSC_DIR}/${PETSC_ARCH}/lib/*.a)
      do
        #ARCHIVES="${ARCHIVES} -Wl,-reexport-l$(basename $l | sed 's/lib\(.*\)\.a/\1/')"
        #ARCHIVES="${ARCHIVES} -l$(basename $l | sed 's/lib\(.*\)\.a/\1/')"
        ARCHIVES="${ARCHIVES} -Wl,-force_load,$l"
      done

      petsc_linker_flags="-Wl,-install_name,@rpath/lib/${libname}${dll_libext}"
    fi


    #echo "Copy shared library to ${SDKDIR}/${TCHOST}/lib/${libname}${dll_libext} ..."
    #cp ${PETSC_DIR}/${PETSC_ARCH}/lib/libpetsc.so ${SDKDIR}/${TCHOST}/lib/${libname}${dll_libext}

    echo "Create shared library ${SDKDIR}/${TCHOST}/lib/${libname}${dll_libext} ..."
    echo "${CXX} -shared -o ${SDKDIR}/${TCHOST}/lib/${libname}${dll_libext} \
      ${petsc_linker_flags} \
      ${ARCHIVES} \
      -Wl,-rpath,\$ORIGIN \
      ${LDFLAGS} ${LAPACK_LIBS} ${FORTRAN_LIBS}"

    mkdir -p ${SDKDIR}/${TCHOST}/lib
    ${CXX} -shared -o ${SDKDIR}/${TCHOST}/lib/${libname}${dll_libext} \
      ${petsc_linker_flags} \
      ${ARCHIVES} \
      -Wl,-rpath,\$ORIGIN \
       ${MPI_LIBS} ${LDFLAGS} ${LAPACK_LIBS} ${FORTRAN_LIBS}

    mkdir -p ${TOPDIR}/${TCHOST}/lib
    cp ${SDKDIR}/${TCHOST}/lib/${libname}${dll_libext} ${TOPDIR}/${TCHOST}/lib/${libname}${dll_libext}


}



ARCHIVE="petsc-${PETSCVERSION}${PETSCPATCHLEVEL}.tar.gz"
PATCH=${PWD}/petsc.patch-${PETSCVERSION}

echo "Compiling PETSc version $PETSCVERSION in $BUILDDIR ..."

mkdir -p $BUILDDIR
if [ ! -d $BUILDDIR ]; then
  echo "Directory $BUILDDIR does not exist."
  exit 1
fi

cd $BUILDDIR
if [ ! -e ${ARCHIVE} ]; then
  wget ftp://ftp.mcs.anl.gov/pub/petsc/release-snapshots/${ARCHIVE}
fi

if [ ! -e ${ARCHIVE} ]; then
  echo "Could not download petsc."
  exit 1
fi

if [ ! -d petsc-${PETSCVERSION}${PETSCPATCHLEVEL} ]; then
  tar zxf ${ARCHIVE}

  if [ -e ${PATCH} ]; then
    patch -p0 -d petsc-${PETSCVERSION}${PETSCPATCHLEVEL} < ${PATCH}
  fi
fi

cd petsc-${PETSCVERSION}${PETSCPATCHLEVEL}



