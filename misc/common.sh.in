
# load variables
#[ -e variables ] && . variables

# top directory
TOPDIR=${TOPDIR:-"$(dirname `pwd`)"}

# build directory
BUILDDIR=${BUILDDIR:-"$(dirname `pwd`)/extern"}

# SDK directory
SDKDIR=${SDKDIR:-"$(dirname `pwd`)/SDK"}

# PETSc version
PETSCVERSION=${PETSCVERSION:-"3.6.2"}
PETSCPATCHLEVEL=${PETSCPATCHLEVEL:-""}
SLEPCVERSION=${SLEPCVERSION:-${PETSCVERSION}}
SLEPCPATCHLEVEL=${SLEPCPATCHLEVEL:-""}

# libMesh version
LIBMESHVERSION=${LIBMESHVERSION:-"1.0.0"}

# GMSH version
GMSHVERSION=${GMSHVERSION:-"2.14.0"}

# whether to compile debug mode or not (y/n)
DEBUG=${DEBUG:-'n'}



# build shared libs (yes/no)
shared_libs=${shared_libs:-'n'}

# use MKL (yes/no)
MKL=${MKL:-'n'}
MKLDIR=${MKLDIR:-"/usr/pack/intel_mkl-10.2-gp"}

# MPI
MPI=${MPI:-'n'}
MPIDIR=${MPIDIR:-"/usr/lib/openmpi/"}

target=@host_cpu@-@host_os@

# system
system=`uname -s`
case $system in
  CYGWIN_NT-* | MINGW*)
    SYSTEM=mingw
    ;;

  Linux)
    SYSTEM=linux-gnu
    ;;

  Darwin)
    SYSTEM=darwin
    ;;

  *)
    echo "$system is not supported"; exit 1 ;;
esac

# target system
case $target in
  *mingw* | *cygwin* )
    target_os=win32 ;;

  *darwin*)
    target_os=darwin ;;

  *linux* )
    target_os=linux ;;
esac

# architecture
march=`uname -m`

HOST=@host@
BUILD=@build@

TCBUILD=`${TOPDIR}/share/arch.sh`
TCHOST=`${TOPDIR}/share/arch.sh ${target}`
echo "*************************************************"
echo "* Host system :  $TCHOST"
echo "* Build system:  $TCBUILD"
echo "*************************************************"

if [ -d ${TOPDIR}/SDK/${TCHOST}/lib/gcc ]
then
  export PATH=${TOPDIR}/SDK/${TCHOST}/bin:${PATH}
  export LD_LIBRARY_PATH=${TOPDIR}/SDK/${TCHOST}/lib:${TOPDIR}/SDK/${TCHOST}/lib64
fi

#CC=${CC:-"${pre}gcc${gcc_version}"}
#CXX=${CXX:-"${pre}g++${gcc_version}"}
#F77=${F77:-"${pre}gfortran${gcc_version}"}
#F90=${F90:-$F77}
#FC=${FC:-$F77}
#AR=${AR:-"${pre}ar"}
#LD=${LD:-"${pre}ld"}
#RANLIB=${RANLIB:-"${pre}ranlib"}
#CPP=${CPP:-"${pre}cpp${gcc_version}"}
CPP="@CPP@"
CC="@CC@"
CXX="@CXX@"
FC="@FC@"
F90="${F90:-$FC}"
F77="${F77:-$FC}"
RANLIB="@RANLIB@"


#if [ "x$pre" != "x" ] || [ "x$gcc_version" != "x" ]
#then
  export CC CXX F77 FC F90 RANLIB LD AR CPP
#fi

# compiler flags
CFLAGS="${CFLAGS} -fexceptions"
FCFLAGS="${FCFLAGS} -fexceptions"
if [ "$march" == "x86_64" ] &&  [ "${target_os}" != "win32" ] ; then
  CXXFLAGS="-fPIC ${CXXFLAGS}"
  CFLAGS="-fPIC ${CFLAGS}"
  FCFLAGS="-fPIC ${FCFLAGS}"
fi
CXXFLAGS="${CXXFLAGS} -std=gnu++11"
FFLAGS=${FCFLAGS}
export CXXFLAGS CFLAGS FFLAGS FCFLAGS


FORTRAN_LIBS="@FCLIBS@"

if [ "x$FORTRANDIR" != "x" ]; then
  case $march in
    x86_64) FLIBDIR=${FORTRANDIR}/lib/intel64 ;;
    i?86)   FLIBDIR=${FORTRANDIR}/lib/ia32 ;;
    *)      echo "FORTRANDIR cannot be used on architecture $march"; exit 1 ;;
  esac
  LDFLAGS="${LDFLAGS} -Wl,-rpath,${FLIBDIR}"
  FORTRAN_LIBS="${FORTRAN_LIBS} -Wl,-rpath,${FLIBDIR}"
  export LD_LIBRARY_PATH="${FLIBDIR}:${LD_LIBRARY_PATH}"
fi


if [ "$MPI" = y ]; then
  export MPIDIR
  #if [ -x ${MPIDIR}/bin/mpicxx ]; then
  #  LDFLAGS="${LDFLAGS} `${MPIDIR}/bin/mpicxx -showme:link`"
  #fi
  if [ "${target_os}" = win32 ]
  then
    CXXFLAGS="${CXXFLAGS} -I${MPIDIR}/Include"
    CFLAGS="${CFLAGS} -I${MPIDIR}/Include"
    FCFLAGS="${FCFLAGS} -I${MPIDIR}/Include"
    LDFLAGS="-L${MPIDIR}/Lib/x86"
    MPI_LIBS="-L${MPIDIR}/Lib/x86 -lmsmpifec -lmsmpi"
  fi
fi

# BLAS/LAPACK
if [ "$MKL" = y ]; then
  if [ $march = x86_64 ]; then
#    LAPACKLIBS="--with-blas-lapack-lib=[-L${MKLDIR}/lib/em64t,-lmkl_intel_lp64,-lmkl_intel_thread,-lmkl_core,-liomp5,-lm,-lpthread]"
#    LDFLAGS="${LDFLAGS} -L${MKLDIR}/lib/em64t -Wl,-rpath-link,${MKLDIR}/lib/em64t"
#    LAPACK_LIBS="${LDFLAGS} -L${MKLDIR}/lib/em64t -Wl,-rpath,${MKLDIR}/lib/em64t"
    #LAPACKLIBS="--with-blas-lapack-lib=[-Xlinker,--no-as-needed,-Xlinker,-rpath,-Xlinker,${MKLDIR}/lib/intel64,-L${MKLDIR}/lib/intel64,-lmkl_intel_lp64,-lmkl_intel_thread,-lmkl_core,-liomp5,-lm,-lpthread]"
    LAPACKLIBS="--with-blas-lapack-lib=\"-Wl,--no-as-needed -Wl,-rpath,${MKLDIR}/lib/intel64 -L${MKLDIR}/lib/intel64 -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core -liomp5 -lm -lpthread\""
    LDFLAGS="${LDFLAGS} -L${MKLDIR}/lib/intel64 -Wl,-rpath,${MKLDIR}/lib/intel64"
    LAPACK_LIBS="${LDFLAGS} -L${MKLDIR}/lib/intel64 -Wl,-rpath,${MKLDIR}/lib/intel64 -Wl,--no-as-needed -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core -liomp5 -lm -lpthread"
 
  else
    LAPACKLIBS="--with-blas-lapack-lib=[-L${MKLDIR}/lib/32,-lmkl_intel,-lmkl_intel_thread,-lmkl_core,-liomp5,-lm,-lpthread]"
    LDFLAGS="${LDFLAGS} -L${MKLDIR}/lib/32 -Wl,-rpath,${MKLDIR}/lib/32"
    LAPACK_LIBS="${LDFLAGS} -L${MKLDIR}/lib/32 -Wl,-rpath,${MKLDIR}/lib/32"
  fi
else
  LAPACK_LIBS=$LAPACKLIBS
fi

export LAPACKLIBS LDFLAGS LAPACK_LIBS

dll_libext=.so
dll_prefix=lib
if [ "${target_os}" = win32 ]
then
  dll_libext=.dll
  dll_prefix=
elif [ "${target_os}" = darwin ]
then
  dll_libext=.dylib
fi

