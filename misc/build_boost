#!/bin/bash

if [ ! -e common.sh ]; then
  echo "Need configuration file (common.sh)."
  exit 1
fi

. common.sh

VERSION=${BOOSTVERSION:-"1_77_0"}
ARCHIVE=boost_${VERSION}.tar.bz2

echo "Compiling boost libraries"


mkdir -p $BUILDDIR
if [ ! -d $BUILDDIR ]; then
  echo "Directory $BUILDDIR does not exist."
  exit 1
fi



cd $BUILDDIR
if [ ! -e ${ARCHIVE} ]; then
  wget --no-check-certificate  http://sourceforge.net/projects/boost/files/boost/`echo $VERSION | sed 's/_/\./g'`/${ARCHIVE}
fi


if [ ! -e ${ARCHIVE} ]; then
  echo "Could not download ${ARCHIVE}."
  exit 1
fi



if [ ! -d boost_${VERSION} ]; then
  tar jxf ${ARCHIVE}
  cd boost_${VERSION}
  [ -e ${TOPDIR}/misc/boost.patch ] && patch -p0 < ${TOPDIR}/misc/boost.patch
  #cp tools/build/v2/user-config.jam tools/build/v2/user-config.jam.orig
  cd ..
fi

cd boost_${VERSION}
toolset=gcc
if [ "$target_os" = darwin ]
then
  toolset=darwin
fi

if [ "$target_os" = win32 ]; then
  echo "using gcc : : $CXX : <cxxflags>-std=gnu++17 <src>$(echo $CC | sed 's/gcc/windres/') <archiver>$AR ;" > tools/build/v2/user-config.jam
else
  #echo "using $toolset : : $CXX : <cxxflags>-std=gnu++11 <linkflags>-Wl,-rpath,'\$ORIGIN' ;" > tools/build/v2/user-config.jam
  echo "using $toolset : : $CXX : <cxxflags>-std=gnu++17 <linkflags>-Wl,-rpath,'\$ORIGIN' ;" > tools/build/src/user-config.jam
  echo "using mpi ;" >> tools/build/src/user-config.jam
  cp tools/build/src/user-config.jam .
#  if [ "$MPI" = y ]; then
#    echo "using mpi ;" >> tools/build/v2/user-config.jam
#  fi
#  echo "using $toolset : : $(which $CXX) : <cxxflags>-std=gnu++0x <linkflags>-Wl,-rpath,'\$ORIGIN' ;" > tools/build/v2/user-config.jam
fi

./bootstrap.sh --with-toolset=$toolset --without-icu
if [ "$target_os" = win32 ]; then
  bits=32
  [ "x$(echo $HOST | grep x86_64)" != "x" ] && bits=64

  ./b2 toolset=gcc variant=release threading=single link=shared runtime-link=shared target-os=windows --with-regex --with-filesystem --with-system --layout=tagged --prefix=${SDKDIR} --libdir=${SDKDIR}/${TCHOST}/lib address-model=$bits install
else
  ./b2 toolset=$toolset variant=release threading=multi link=shared runtime-link=shared --with-regex --with-filesystem --with-system --layout=tagged --prefix=${SDKDIR} --libdir=${SDKDIR}/${TCHOST}/lib install
  cp ${SDKDIR}/${TCHOST}/lib/libboost* ${TOPDIR}/${TCHOST}/lib
fi

if [ "$target_os" = darwin ]
then
  cd ${BUILDDIR}/$TCHOST/lib
  for lib in libboost_*.dylib
  do
    install_name_tool -id "@rpath/lib/$lib" "$lib"
    if [[ "$lib" =~ filesystem ]]
    then
      deplib="$(echo "$lib" | sed 's/file//')"
      install_name_tool -change "$deplib" "@rpath/lib/$deplib" "$lib"
    fi
  done
fi

# when cross compiling we need also the build system boost libraries
if [ "$TCHOST" != "$TCBUILD" ]
then
  rm user-config.jam
  ./b2 toolset=$toolset variant=release threading=single link=shared runtime-link=shared --with-regex --with-filesystem --with-system --layout=tagged --prefix=${BUILDDIR}/$TCBUILD install
fi
