#!/bin/bash

if [ ! -e common.sh ]; then
  echo "Need configuration file (common.sh)."
  exit 1
fi

. common.sh

VERSION=1_47_0
ARCHIVE=boost_${VERSION}.tar.bz2

echo "Compiling boost libraries"


mkdir -p $BUILDDIR
if [ ! -d $BUILDDIR ]; then
  echo "Directory $BUILDDIR does not exist."
  exit 1
fi



cd $BUILDDIR
if [ ! -e ${ARCHIVE} ]; then
  wget http://sourceforge.net/projects/boost/files/boost/`echo $VERSION | sed 's/_/\./g'`/${ARCHIVE}
fi


if [ ! -e ${ARCHIVE} ]; then
  echo "Could not download ${ARCHIVE}."
  exit 1
fi



if [ ! -d boost_${VERSION} ]; then
  tar jxf ${ARCHIVE}
  cd boost_${VERSION}
  [ -e ${TOPDIR}/misc/boost.patch ] && patch -p0 < ${TOPDIR}/misc/boost.patch
  cp tools/build/v2/user-config.jam tools/build/v2/user-config.jam.orig
  cd ..
fi

cd boost_${VERSION}
toolset=gcc
if [ "$target_os" = darwin ]
then
  toolset=darwin
fi

if [ "$target_os" = win32 ]; then
  echo "using gcc : : $CXX : <compileflags>-std=gnu++0x <src>$(echo $CC | sed 's/gcc/windres/') <archiver>$AR ;" > tools/build/v2/user-config.jam
else
  echo "using $toolset : : $CXX : <compileflags>-std=gnu++0x <linkflags>-Wl,-rpath,${BUILDDIR}/boost/lib ;" > tools/build/v2/user-config.jam
fi

./bootstrap.sh --with-toolset=$toolset --without-icu
if [ "$target_os" = win32 ]; then
  bits=32
  [ "x$(echo $HOST | grep x86_64)" != "x" ] && bits=64

  ./bjam toolset=gcc variant=release threading=single link=shared runtime-link=shared target-os=windows --with-regex --with-filesystem --with-system --layout=tagged --prefix=${BUILDDIR}/$TCHOST address-model=$bits install
else
  ./bjam toolset=$toolset variant=release threading=multi link=shared runtime-link=shared --with-regex --with-filesystem --with-system --layout=tagged --prefix=${BUILDDIR}/$TCHOST install
fi

if [ "$target_os" = darwin ]
then
  cd ${BUILDDIR}/$TCHOST/lib
  for lib in libboost_*.dylib
  do
    install_name_tool -id "@rpath/lib/$lib" "$lib"
    if [[ "$lib" =~ filesystem ]]
    then
      deplib="$(echo "$lib" | sed 's/file//')"
      install_name_tool -change "$deplib" "@rpath/lib/$deplib" "$lib"
    fi
  done
fi

