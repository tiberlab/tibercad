--- ./include/base/single_predicates.h.orig	2016-10-23 09:55:36.185779903 +0200
+++ ./include/base/single_predicates.h	2016-10-23 10:00:42.181561578 +0200
@@ -389,6 +389,24 @@
   const subdomain_id_type _subdomain;
 };
 
+// The subdomains predicate returns true if the pointers
+// subdomain id is contained in a set subdomain ids.
+template <typename T>
+struct subdomains : predicate<T>
+{
+  // Constructor
+  subdomains(const std::set<subdomain_id_type>& sid) : _subdomains(sid) {}
+  virtual ~subdomains() {}
+
+  // op()
+  virtual bool operator()(const T& it) const libmesh_override { return _subdomains.count((*it)->subdomain_id()); }
+
+protected:
+  virtual predicate<T>* clone() const libmesh_override { return new subdomains<T>(*this); }
+  const std::set<subdomain_id_type> _subdomains;
+};
+
+
 }
 
 
--- ./include/base/multi_predicates.h.orig	2016-10-23 14:28:58.781490873 +0200
+++ ./include/base/multi_predicates.h	2016-10-23 14:33:27.465230375 +0200
@@ -580,6 +580,25 @@
 };
 
 
+/**
+ * Used to iterate over non-NULL, active elements with a given PID on
+ * a given set of subdomains.
+ */
+template <typename T>
+struct ActiveLocalSubdomains : abstract_multi_predicate<T>
+{
+  ActiveLocalSubdomains(processor_id_type my_pid,
+                       const std::set<subdomain_id_type>& subdomain_ids)
+  {
+    this->_predicates.push_back(new not_null<T>);
+    this->_predicates.push_back(new active<T>);
+    this->_predicates.push_back(new pid<T>(my_pid));
+    this->_predicates.push_back(new subdomains<T>(subdomain_ids));
+  }
+};
+
+
+
 
