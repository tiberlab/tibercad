@@ -597,6 +616,23 @@
 };
 
 
+/**
+ * Used to iterate over non-NULL, active elements on a given
+ * set of subdomains.
+ */
+template <typename T>
+struct ActiveSubdomains : abstract_multi_predicate<T>
+{
+  ActiveSubdomains(const std::set<subdomain_id_type>& subdomain_ids)
+  {
+    this->_predicates.push_back(new not_null<T>);
+    this->_predicates.push_back(new active<T>);
+    this->_predicates.push_back(new subdomains<T>(subdomain_ids));
+  }
+};
+
+
