+
+    case 15:
+      return Point(-1.0, 1.0, 0.0);
+      break;
+
+    case 16:
+      return Point(0.0, -1.0, 1.0);
+      break;
+
+    case 17:
+      return Point(1.0, 0.0, 1.0);
+      break;
+
+    case 18:
+      return Point(0.0, 1.0, 1.0);
+      break;
+
+    case 19:
+      return Point(-1.0, 0.0, 1.0);
+      break;
