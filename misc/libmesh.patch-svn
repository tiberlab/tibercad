+
+    case 4:
+      return Point(0.5, 0.0, 0.0);
+      break;
+
+    case 5:
+      return Point(0.5, 0.5, 0.0);
+      break;
+
+    case 6:
+      return Point(0.0, 0.5, 0.0);
