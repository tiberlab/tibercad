+      return Point(0.0, -1.0, 0.0);
+      break;
+
+    case 5:
+      return Point(1.0, 0.0, 0.0);
+      break;
+
+    case 6:
+      return Point(0.0, 1.0, 0.0);
+      break;
+
+    case 7:
+      return Point(-1.0, 0.0, 0.0);
+      break;
+
+    case 8:
+      return Point(0.0, 0.0, 0.0);
+      break;
+
+    }
+
+    break;
+
+  case TET4:
+
+    libmesh_assert (n < 4);
+
+    switch (n){
+
+    case 0:
+      return Point(0.0, 0.0, 0.0);
+      break;
+
+    case 1:
+      return Point(1.0, 0.0, 0.0);
+      break;
+
+    case 2:
+      return Point(0.0, 1.0, 0.0);
+      break;
+
+    case 3:
+      return Point(0.0, 0.0, 1.0);
+      break;
+
+    }
+
+    break;
