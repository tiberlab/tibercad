@@ -620,6 +633,34 @@
 
 
 inline const std::string
+GetPot::__get_until_closing_brace(std::istream& istr)
+  // parse input until next matching )
+{
+  std::string str = ""; 
+  int    tmp = 0;
+  int    last_letter = 0;
+  int    braces = 1;
+  while(1 + 1 == 2) {
+    last_letter = tmp; tmp = istr.get();
+    if( tmp == EOF) return str;
+    else if( tmp == '(' && last_letter != '\\') braces += 1;
+    else if( tmp == ')' && last_letter != '\\') {
+      braces -= 1;
+      // un-backslashed brackets => it's the end of the string
+      if( braces == 0) return str + ')';
+      else if( tmp == '\\' && last_letter != '\\') 
+	continue;  // do not append an unbackslashed backslash
+    }
+    str += tmp;
+  }
+
+  return str;
+}
+
+
+
