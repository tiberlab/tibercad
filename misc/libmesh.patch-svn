+
+    case 13:
+      return Point(1.0, -1.0, 0.0);
+      break;
+
+    case 14:
+      return Point(1.0, 1.0, 0.0);
+      break;
+
+    case 15:
+      return Point(-1.0, 1.0, 0.0);
