+
+    }
+
+    break;
+
+  case HEX8:
+
+    libmesh_assert (n < 8);
+
+    switch (n){
+
+    case 0:
+      return Point(-1.0, -1.0, -1.0);
+      break;
+
+    case 1:
+      return Point(1.0, -1.0, -1.0);
+      break;
+
+    case 2:
+      return Point(1.0, 1.0, -1.0);
+      break;
+
+    case 3:
+      return Point(-1.0, 1.0, -1.0);
+      break;
+
+    case 4:
+      return Point(-1.0, -1.0, 1.0);
+      break;
+
+    case 5:
+      return Point(1.0, -1.0, 1.0);
+      break;
+
+    case 6:
+      return Point(1.0, 1.0, 1.0);
+      break;
+
+    case 7:
+      return Point(-1.0, 1.0, 1.0);
+      break;
+ 
+    }
+
+    break;
+
+  case HEX20:
+
+    libmesh_assert(n < 20);
+
+    switch (n){
+
+    case 0:
+      return Point(-1.0, -1.0, -1.0);
+      break;
+
+    case 1:
+      return Point(1.0, -1.0, -1.0);
+      break;
+
+    case 2:
+      return Point(1.0, 1.0, -1.0);
+      break;
+
+    case 3:
+      return Point(-1.0, 1.0, -1.0);
+      break;
+
+    case 4:
+      return Point(-1.0, -1.0, 1.0);
+      break;
+
+    case 5:
+      return Point(1.0, -1.0, 1.0);
+      break;
+
+    case 6:
+      return Point(1.0, 1.0, 1.0);
