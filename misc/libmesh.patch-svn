+Point Elem::local_node(ElemType e, int n){
+
+  //By G. Penazzi and G. Romano, University of Rome Tor Vergata
+  //2nd May 2007
+
+  libmesh_assert(n >= 0);
+
+  switch (e){
+
+  case EDGE2:
+
+    libmesh_assert(n < 2);
+
+    switch (n){
+
+    case 0:
+      return Point(-1.0, 0.0, 0.0);     
+      break;
+
+    case 1:
+      return Point(1.0, 0.0, 0.0);
+      break;
+
+    }
+
+    break;
+
+  case EDGE3:
+
+    libmesh_assert(n < 3);
+
+    switch (n){
+
+    case 0:
+      return Point(-1.0, 0.0, 0.0);
+      break;
+
+    case 1:
+      return Point(1.0, 0.0, 0.0);
+      break;
+
+    case 2:
+      return Point(0.0, 0.0, 0.0);
+      break;
+
+    }
+
+    break;
+
+  case EDGE4:
+
+    libmesh_assert (n < 4);
+
+    switch (n){
+
+    case 0:
+      return Point(-1.0, 0.0, 0.0);
+      break;
+
+    case 2:
+      return Point(1.0, 0.0, 0.0);
+      break;
+
+    case 3:
+      return Point(- 1.0 / 3.0, 0.0, 0.0);
+      break;
+
+    case 1:
+      return Point(1.0 / 3.0, 0.0, 0.0);
+      break;
+
+    }
+
+    break;
+
+  case TRI3:
+
+    libmesh_assert (n < 3);
+
+    switch (n){
+
+    case 0:
+      return Point(0.0, 0.0, 0.0);
+      break;
+
+    case 1:
+      return Point(1.0, 0.0, 0.0);
+      break;
+
+    case 2:
+      return Point(0.0, 1.0, 0.0);
+      break;
+
+    }
+
+    break;
+
+  case TRI6:
+
+    libmesh_assert (n < 6);
+
+    switch (n){
+
+    case 0:
+      return Point(0.0, 0.0, 0.0);
+      break;
+
+    case 1:
+      return Point(1.0, 0.0, 0.0);
+      break;
+
+    case 2:
+      return Point(0.0, 1.0, 0.0);
+      break;
+
+    case 3:
+      return Point(0.5, 0.0, 0.0);
+      break;
+
+    case 4:
+      return Point(0.5, 0.5, 0.0);
+      break;
+
+    case 5:
+      return Point(0.0, 0.5, 0.0);
+      break;
+
+    }
+
+    break;
+
+  case QUAD4:
+
+    libmesh_assert (n < 4);
+
+    switch (n){
+
+    case 0:
+      return Point(-1.0, -1.0, 0.0);
+      break;
+
+    case 1:
+      return Point(1.0, -1.0);
+      break;
+
+    case 2:
+      return Point(1.0, 1.0, 0.0);
+      break;
+
+    case 3:
+      return Point(-1.0, 1.0, 0.0);
+      break;
+
+    case 4:
+      return Point(-1.0, 1.0, 0.0);
+      break;
+
+  
+
+    }
+
+    break;
+
+  case QUAD8:
+
+    libmesh_assert ( n < 8);
+
+  
+    switch (n){
+
+    case 0:
+      return Point(-1.0, -1.0, 0.0);
+      break;
+
+    case 1:
+      return Point(1.0, -1.0, 0.0);
+      break;
+
+    case 2:
+      return Point(1.0, 1.0, 0.0);
+      break;
+
+    case 3:
+      return Point(-1.0, 1.0, 0.0);
+      break;
+
+    case 4:
+      return Point(0.0, -1.0, 0.0);
+      break;
+
+    case 5:
+      return Point(1.0, 0.0, 0.0);
+      break;
+
+    case 6:
+      return Point(0.0, 1.0, 0.0);
+      break;
+
+    case 7:
+      return Point(-1.0, 0.0, 0.0);
+      break;
+
+    }
+
+    break;
+
+  case QUAD9:
+
+    libmesh_assert (n < 9);
+
+    switch (n){
+
+    case 0:
+      return Point(-1.0, -1.0, 0.0);
+      break;
+
+    case 1:
