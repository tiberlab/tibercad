# build directory
BUILDDIR=`pwd`/../test

# PETSc version
#PETSCVERSION="2.3.3"
#PATCHLEVEL="p13"
PETSCVERSION="3.0.0"
PETSCPATCHLEVEL="-p10"
SLEPCPATCHLEVEL="-p7"

# libMesh version
#LIBMESHVERSION=0.6.1
LIBMESHVERSION="svn"

# GMSH version
GMSHVERSION=2.3.0

# whether to compile debug mode or not (y/n)
DEBUG=n

# build shared libs (yes/no)
shared_libs=y

# use MKL (yes/no)
MKL=y
MKLDIR=/usr/pack/intel_mkl-10.2-gp

# compilers
v=-4.3.2
CC=gcc$v
CXX=g++$v
F77=ifort-11.1
F90=$F77
FC=$F77
FORTRANDIR=/usr/pack/intel_fc-11.1-gp

TIBEROPTS="--enable-uptight --disable-license-check --disable-hetero"

# MPI
MPI=n
MPIDIR=/usr/pack/mpich2-1.0.8-gp


