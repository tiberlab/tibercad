#!/bin/bash
PACKAGER=ma
VERSION=4.8.1
PROD=gcc

topdir=$(dirname $(dirname $PWD))

ARCH=$(${topdir}/share/arch.sh)
# You can set these to any reasonable value
#INSTALLPREFIX=${topdir}/SDK/gcc-$VERSION
#INSTALLEPREFIX=${INSTALLPREFIX}/$(${topdir}/share/arch.sh)
INSTALLPREFIX=${topdir}/SDK
INSTALLEPREFIX=${topdir}/SDK/$ARCH
WORKDIR=${topdir}/extern/gcc-4.8.1


. `dirname $0`/INSTALL.lib

PREFIX=$INSTALLPREFIX
EPREFIX=$INSTALLEPREFIX

export LD_LIBRARY_PATH=${EPREFIX}/lib
#export LDFLAGS="-Wl,-rpath-link,${EPREFIX}/lib -Wl,-rpath,'\$\$ORIGIN/../../../../../lib' -Wl,-rpath,'\$\$ORIGIN/../lib'"
export LD_RUN_PATH='$ORIGIN:$ORIGIN/../lib:$ORIGIN/../../../../lib'
echo $INSTALLEPREFIX
echo "$LD_RUN_PATH"



#export CC=gcc-4.6.0
#export CXX=g++-4.6.0

GCCARCH=i686-pc-linux-gnu
LIBSWITCH=
if [ `uname -m` == "x86_64" ]
then
  GCCARCH=x86_64-unknown-linux-gnu
  LIBSWITCH='%{!m32:64}%{m32:32}'

#  cd ${EPREFIX}
#  if test ! -L lib64
#  then
#    ls
#    ln -s lib lib64
#  fi
#  cd ${WORKDIR}
fi

#cat <<PATCH >$WORKDIR/specs.patch
#--- ./${ARCH}/lib/gcc/${GCCARCH}/${VERSION}/specs~	2005-05-11 18:34:14.000000000 +0200
#+++ ./${ARCH}/lib/gcc/${GCCARCH}/${VERSION}/specs	2005-05-11 18:34:13.000000000 +0200
#@@ -93,7 +93,7 @@
# collect2
# 
# *link_libgcc:
#-%D
#+-rpath /usr/pack/gcc-${VERSION}-ma/${ARCH}/lib${LIBSWITCH} %D
# 
# *md_exec_prefix:
# 
#PATCH


PREFIX=${WORKDIR}/dep
EPREFIX=$PREFIX

simplebuild http://ftp.sunet.se/pub/gnu/gmp gmp-5.1.3.tar.bz2 --enable-cxx --enable-mpbsd
simplebuild http://www.mpfr.org/mpfr-current mpfr-3.1.2.tar.bz2 --with-gmp=${EPREFIX}
simplebuild http://www.multiprecision.org/mpc/download mpc-1.0.1.tar.gz --with-gmp-include=${EPREFIX}/include --with-gmp-lib=${EPREFIX}/lib --with-mpfr-include=${PREFIX}/include --with-mpfr-lib=${EPREFIX}/lib
#simplebuild http://www.cs.unipr.it/ppl/Download/ftp/releases/0.10.2/ ppl-0.10.2.tar.bz2 --with-libgmpxx-prefix=${EPREFIX} --with-cxxflags="-I ${PREFIX}/include"
export CXXFLAGS="-I ${PREFIX}/include -I ${EPREFIX}/include"
export CFLAGS="-I ${PREFIX}/include -I ${EPREFIX}/include"
export CPPLAGS="-I ${PREFIX}/include -I ${EPREFIX}/include"
simplebuild ftp://gcc.gnu.org/pub/gcc/infrastructure isl-0.11.1.tar.bz2 --with-gmp-prefix=${PREFIX} --with-gmp-exec-prefix=${EPREFIX}
simplebuild ftp://gcc.gnu.org/pub/gcc/infrastructure cloog-0.18.0.tar.gz  --with-gmp-exec-prefix=${EPREFIX} --with-gmp-prefix=${PREFIX} --with-isl=system --with-isl-prefix=${PREFIX} --with-isl-exec-prefix=${EPREFIX}


DEPPREFIX=$PREFIX
DEPEPREFIX=$EPREFIX
PREFIX=$INSTALLPREFIX
EPREFIX=$INSTALLEPREFIX

mkdir -p ${EPREFIX}/lib
cp -a ${DEPEPREFIX}/lib/*.so* ${EPREFIX}/lib


if prepare ftp://mirror.switch.ch/mirror/gnu/${PROD}/${PROD}-${VERSION} ${PROD}-${VERSION}.tar.bz2
then

  cd ..
  mkdir -p build
  cd build
  ../${PROD}-${VERSION}/configure --prefix=${PREFIX} --enable-languages=c,c++,f95 --enable-__cxa_atexit --enable-threads --exec-prefix=${EPREFIX} --with-gmp-include=${DEPEPREFIX}/include --with-gmp-lib="${DEPEPREFIX}/lib -Wl,-rpath,${DEPEPREFIX}/lib" --with-mpfr-include=${DEPPREFIX}/include --with-mpfr-lib="${DEPEPREFIX}/lib -Wl,-rpath,${DEPEPREFIX}/lib" --with-ppl="${DEPPREFIX}" --with-cloog="${DEPPREFIX}" --with-isl-lib="${DEPEPREFIX}/lib -Wl,-rpath,${DEPEPREFIX}/lib"  --with-isl-include="${DEPPREFIX}/include" --disable-libquadmath-support --disable-libquadmath --disable-multilib --disable-nls

  make bootstrap
  make install

  cd ${EPREFIX}
  #./${ARCH}/bin/gcc -dumpspecs > ./${ARCH}/lib/gcc/${GCCARCH}/${VERSION}/specs
  #patch -p0 -l <${WORKDIR}/specs.patch
  rm bin/${GCCARCH}*

  startfiledir=$(dirname "$(find /usr/lib -name crti.o)")
  cp ${startfiledir}/crt*.o ${EPREFIX}/lib

  cp ${EPREFIX}/lib64/libstdc++.so.6 ${topdir}/${ARCH}/lib
  cp ${EPREFIX}/lib64/libgfortran.so.3 ${topdir}/${ARCH}/lib
  cp ${EPREFIX}/lib64/libgcc_s.so.1 ${topdir}/${ARCH}/lib
fi
