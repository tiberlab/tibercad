#!/bin/bash
PACKAGER=ma
VERSION=4.6.0
PROD=gcc

# You can set these to any reasonable value
#PREFIX=${HOME}/Programs
#EPREFIX=${HOME}/Programs
PREFIX=`pwd`/../../SDK/compiler
EPREFIX=`pwd`/../../SDK/compiler
#WORKDIR=/tmp/gcc-4.6.0
WORKDIR=${HOME}/Downloads


. `dirname $0`/INSTALL.lib

export LD_LIBRARY_PATH=${EPREFIX}/lib
export LDFLAGS="-Wl,-rpath,${EPREFIX}/lib"

simplebuild http://ftp.sunet.se/pub/gnu/gmp gmp-5.0.2.tar.bz2 --enable-cxx --enable-mpbsd
simplebuild http://www.mpfr.org/mpfr-current mpfr-3.0.1.tar.bz2 --with-gmp=${EPREFIX}
simplebuild http://www.multiprecision.org/mpc/download mpc-0.9.tar.gz --with-gmp-include=${EPREFIX}/include --with-gmp-lib=${EPREFIX}/lib --with-mpfr-include=${PREFIX}/include --with-mpfr-lib=${EPREFIX}/lib
simplebuild http://www.cs.unipr.it/ppl/Download/ftp/releases/0.11.2/ ppl-0.11.2.tar.bz2 --with-libgmpxx-prefix=${EPREFIX} --with-cxxflags="-I ${PREFIX}/include"
export CXXFLAGS="-I ${PREFIX}/include"
export CFLAGS="-I ${PREFIX}/include"
export CPPLAGS="-I ${PREFIX}/include"
simplebuild ftp://gcc.gnu.org/pub/gcc/infrastructure cloog-ppl-0.15.11.tar.gz --with-ppl=${EPREFIX}/lib --with-gmp-library=${EPREFIX}/lib --with-gmp-include=${EPREFIX}/include


export PATH=${EPREFIX}/bin:$PATH

if prepare ftp://mirror.switch.ch/mirror/gnu/${PROD}/${PROD}-${VERSION} ${PROD}-${VERSION}.tar.bz2
then

  cd ..
  mkdir -p build
  cd build
  ../${PROD}-${VERSION}/configure --prefix=${PREFIX} --enable-languages=c,c++,fortran --enable-__cxa_atexit --enable-threads --exec-prefix=${EPREFIX} --with-gmp-include=${EPREFIX}/include --with-gmp-lib="${EPREFIX}/lib -Wl,-rpath,${EPREFIX}/lib" --with-mpfr-include=${PREFIX}/include --with-mpfr-lib="${EPREFIX}/lib -Wl,-rpath,${EPREFIX}/lib" --with-ppl-include=${PREFIX}/include --with-ppl-lib="${EPREFIX}/lib -Wl,-rpath,${EPREFIX}/lib"  --with-cloog-include=${PREFIX}/include --with-cloog-lib="${EPREFIX}/lib -Wl,-rpath,${EPREFIX}/lib" 

  make all
  make install
fi

echo "You might want to link ${EPREFIX}/bin to ${EPREFIX}/bin and add ${HOME}/bin to your PATH"
