#!/bin/bash
 
#export CC=mpicc
#export CXX=mpicxx

if [ ! -e common.sh ]; then
  echo "Need configuration file (common.sh)."
  exit 1
fi

. common.sh


echo "Compiling TiberCAD ..."

cd ../

./configure \
  --with-petsc-prefix=${BUILDDIR}/petsc-${PETSCVERSION}${PETSCPATCHLEVEL} \
  --with-petsc-arch=${ARCH}-complex \
  --with-slepc-prefix=${BUILDDIR}/slepc-${PETSCVERSION}${SLEPCPATCHLEVEL} \
  $TIBEROPTS \
  --with-libmesh-prefix=${BUILDDIR}/libmesh-${LIBMESHVERSION}-${march} \
  --with-boost-prefix=${BUILDDIR}/boost --with-boost-libdir=${BUILDDIR}/boost/lib


make
