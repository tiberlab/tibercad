
topdir := @abs_top_builddir@

# include common definitions
include $(topdir)/Make.defs


# libmesh can be found here
#libmesh_dir := @LIBMESH_PREFIX@
libmesh_config := @LIBMESH_CONFIG@


# the main TiberCAD library
TIBERLIBNAME := tibercad
export TIBERLIBNAME



# TIBERCAD includes
TIBER_INCLUDES := -I$(topdir)/include -I$(topdir)/src



ifeq ($(target_os), linux)
  LDFLAGS := -Wl,-rpath,'$$ORIGIN:$$ORIGIN/../lib' -Wl,-rpath-link,$(libdir)
endif
ifeq ($(target_os), darwin)
  LDFLAGS := -Wl,-rpath,@loader_path/.. -Wl,-rpath,@loader_path/../extern
endif
LDFLAGS += -L$(libdir) 


LIBMESH_PETSC_LIBS = @LIBMESH_PETSC_LIBS@
LDFLAGS += $(LIBMESH_PETSC_LIBS)

BOOST_LIBS = @BOOST_REGEX_LIB@ @BOOST_FILESYSTEM_LIB@
LDFLAGS += $(BOOST_LIBS)

LDFLAGS += @LDFLAGS@

TIBER_OBJECTS = $(shell find $(topdir)/src -name "*$(obj-suffix)" -a -path "*.${ARCH}/*" -a ! -path "*/src/apps/*"  -a ! -path "*/src/solver/slepc/*" )


INCLUDE  := $(shell export METHOD=$(LIBMESHMETHOD) && $(libmesh_config) --include) -I@LIBMESH_PREFIX@/include/libmesh -I@LIBMESH_PREFIX@/include  -I@LIBMESH_PREFIX@/contrib/eigen/eigen  -I@LIBMESH_PREFIX@/contrib/timpi/src/parallel/include  -I@LIBMESH_PREFIX@/contrib/timpi/src/utilities/include  -I@LIBMESH_PREFIX@/contrib/timpi/src/algorithms/include 

NON_TIBER_INCLUDES := @BOOST_CPPFLAGS@ $(INCLUDE) 

ifeq ($(have_mkl),yes)
 MKLROOT = @MKL_DIR@
 BLASLAPACK_LDFLAGS = @MKL_LIBS@
 BLASLAPACK_INCLUDE += -I@MKL_INCLUDEDIR@
endif

LDFLAGS += $(BLASLAPACK_LDFLAGS)
NON_TIBER_INCLUDES += $(BLASLAPACK_INCLUDE)

# TODO fortran compiler libraries
FORTRAN_LDFLAGS += @FCLIBS@
LDFLAGS += $(FORTRAN_LDFLAGS)


ifeq ($(have_cuda),yes)
 CUDA_LDFLAGS = @CUDA_LIBS@
 LDFLAGS += $(CUDA_LDFLAGS)
 CUDA_INCLUDE = -I@CUDA_INCLUDEDIR@
endif

ifeq ($(target_os), linux)
 LDFLAGS += -ldl
endif



# the machine architecture
CPPFLAGS += -DARCH=\"$(ARCH)\"

CPPFLAGS += -DMPICH_IGNORE_CXX_SEEK -DLIBMESH_REQUIRE_SEPARATE_NAMESPACE
CPPFLAGS += $(TIBER_INCLUDES)
CPPFLAGS += $(NON_TIBER_INCLUDES)

TC_GITREVISION='"$(shell test -f $(topdir)/VERSION && head -n 1 $(topdir)/VERSION || git describe --always --tags --dirty )"'
TC_GITMODIFIED='"$(shell test -f $(topdir)/VERSION && sed -n 2p $(topdir)/VERSION || git log -n 1 | grep Date | awk '{print $$3, $$4, $$5, $$6}' )"'
TC_COMPDATE='"$(shell date +'%F')"'
TC_COMPSYS='"$(shell uname -r -n -m  -o -v)"'


CPPFLAGS += -DTC_REVISION=$(TC_GITREVISION)
CPPFLAGS += -DTC_MODIFIED=$(TC_GITMODIFIED)
CPPFLAGS += -DTC_COMPDATE=$(TC_COMPDATE)
CPPFLAGS += -DTC_COMPSYS=$(TC_COMPSYS)



CXXFLAGS += $(shell METHOD=$(LIBMESHMETHOD) $(libmesh_config) --cxxflags) 

ifneq ($(target_os),win32)

  CXXFLAGS += -fPIC -pthread -fvisibility=default -fvisibility-inlines-hidden
  FCFLAGS  += -fPIC
  CFLAGS  += -fPIC

endif

vpath %.h $(include_dirs)


#
# source files
srcfiles := $(wildcard *.C)

#
# object files
objects	:= $(patsubst %.C, .$(ARCH)/%$(obj-suffix), $(srcfiles))
target := $(objects)


# for the following targets we set the target variable and go down
# into subdirectories (if defined)
.PHONY: all clean distclean 


# default target
all: all-recursive

