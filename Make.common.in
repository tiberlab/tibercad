# $Id$

# Common definitions for all Makefiles
topdir := @abs_top_builddir@
prefix := @prefix@
exec_prefix := @exec_prefix@
libdir := @libdir@

# The OS
hostos := @host_os@

# libmesh can be found here
#libmesh := @LIBMESH_PREFIX@
libmesh_config := @LIBMESH_CONFIG@

# use or not PARDISO
enable_pardiso = @ENABLE_PARDISO@

# do we have DFTB?
enable_dftb = @ENABLE_DFTB@

# do we have HETERO?
enable_hetero = @ENABLE_HETERO@

# do we have MKL?
have_mkl = @HAVE_MKL@


# the compilers
CXX = @CXX@
CC = @CC@
FC = @FC@


# the subversion revision number
SVNREVISION = $(shell svn info $(topdir) | awk '/^Last Changed Rev/ {print $$4}')

# the full TiberCAD version number
TIBERVERSION = $(shell echo "`cat $(topdir)/VERSION`.$(SVNREVISION)")


# gmsh
GMSH := @GMSH@

##
##
## definitions
##
##

# the default method is optimised
ifeq (x$(METHOD),x)
  METHOD := opt
endif

ifeq ($(METHOD),opt)
  mode := "optimized"
endif
ifeq ($(METHOD),dbg)
  mode := "debug"
endif


# some handy defaults
#DIM := 2
#ORDER := 1

# build modules or not
build_modules := @BUILD_TIBER_MODULES@

# The file extension for object files.
# foo.C is compiled to foo.$(obj-suffix)
obj-suffix := $(METHOD).o


# shared library extension
shared_libext := so
ifeq ($(findstring cygwin,$(hostos)),cygwin)
  shared_libext := dll
endif



# TIBERCAD includes
include_dirs := $(shell find $(topdir)/include -type d -a ! -path "*.svn*")
TIBER_INCLUDES := $(foreach dir,$(include_dirs),-I$(dir))


CXXFLAGS := $(shell export METHOD=$(METHOD) && $(libmesh_config) --cxxflags)
INCLUDE  := $(shell export METHOD=$(METHOD) && $(libmesh_config) --include)
LDFLAGS  := $(shell export METHOD=$(METHOD) && $(libmesh_config) --ldflags)
FCFLAGS   :=

# define subversion revision for C++
#CXXFLAGS += "-DSVNREVISION="$(SVNREVISION)

ifdef PROFILE
  CXXFLAGS += -pg
endif
ifeq ($(METHOD),dbg)
  FCFLAGS += -g
  CXXFLAGS += -Woverloaded-virtual
endif

#LDFLAGS += -Wl,-rpath,$(libdir)/lib -Wl,-rpath,$(topdir)/lib -L$(topdir)/lib
LDFLAGS += -Wl,-rpath,$(libdir)/lib -L$(topdir)/lib
ifeq ($(build_modules), yes)
 #LDFLAGS += -Wl,-rpath,$(libdir)/lib/tibermodels -Wl,-rpath,$(topdir)/lib/tibermodels -L$(topdir)/lib/tibermodels
 LDFLAGS += -Wl,-rpath,$(libdir)/lib/tibermodels -L$(topdir)/lib/tibermodels
endif
LDFLAGS += -ltensor -lnewmat

#LDFLAGS += @GSL_LIBS@

LDFLAGS += @BOOST_REGEX_LIB@ @BOOST_FILESYSTEM_LIB@

# TODO fortran compiler libraries
LDFLAGS += @FCLIBS@

ifeq ($(build_modules),yes)
  TIBER_OBJECTS = $(shell find $(topdir)/src -name "*.$(obj-suffix)" -a ! -path "*/src/tibercad/*" -a ! -path "*/src/utils/*" -a ! -path "*/src/core/modules/*")
  MODULE_CXXFLAGS = -fvisibility=hidden
else
  TIBER_OBJECTS = $(shell find $(topdir)/src -name "*.$(obj-suffix)" -a ! -path "*/src/tibercad/*" -a ! -path "*/src/utils/*")
  MODULE_CXXFLAGS =
endif


#NON_TIBER_INCLUDES := $(INCLUDE) @GSL_CFLAGS@ @BOOST_CPPFLAGS@ -I@MKL_INCLUDEDIR@

NON_TIBER_INCLUDES := $(INCLUDE) @BOOST_CPPFLAGS@ 

ifeq ($(have_mkl),yes)
 LDFLAGS += -L@MKL_LIBDIR@ -Wl,-rpath,@MKL_LIBDIR@
 NON_TIBER_INCLUDES +=  -I@MKL_INCLUDEDIR@
endif



NON_TIBER_INCLUDES := $(patsubst -I%,%,$(NON_TIBER_INCLUDES))

CPPFLAGS += -DMPICH_IGNORE_CXX_SEEK
CPPFLAGS += $(TIBER_INCLUDES)
CPPFLAGS += $(patsubst %,-isystem %,$(NON_TIBER_INCLUDES))

vpath %.h $(include_dirs)


# for the following targets we set the target variable and go down
# into subdirectories (if defined)
.PHONY: all clean distclean

# default target
all: all-recursive

clean: clean-recursive src-clean

distclean: distclean-recursive src-distclean


