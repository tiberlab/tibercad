# $Id$

# Common definitions for all Makefiles
topdir := @abs_top_builddir@

##
##
## Path to packages we need
##
##

# $(tibermodules) are the subdirectories in $(topdir)/include
tibermodules := base/common base/io utils/Tensor
tibermodules += base/io/Read_ISE_grid
tibermodules += base/database
#tibermodules += base/exception
tibermodules += pmi
tibermodules += core/drift-diffusion core/drift-diffusion/models
tibermodules += core/macrostrain core/semiconductormodels
tibermodules += core/quantumEFAmodels core/solver-interfaces/petsc
tibermodules += core/classical-transport/excitons
tibermodules += utils/SLEPC

# libmesh can be found here
libmesh := @LIBMESH_PREFIX@
include $(libmesh)/Make.common

# libmesh and petsc were not compiled with it, but it resolves a link
# problem if one links on a machine with debian `etch'
# CXX = g++-4.0.0

# the boost libraries
# boost := @BOOST_PREFIX@

# gmsh
GMSH := @GMSH@

##
##
## definitions
##
##

# some handy defaults
DIM := 2
ORDER := 1


# TIBERCAD includes
TIBER_INCLUDES := $(foreach module,$(tibermodules),-I$(topdir)/include/$(module))

ifdef DEBUG
  CXXFLAGS += -g
endif

ifdef PROFILE
  CXXFLAGS += -pg
endif

CXXFLAGS += $(TIBER_INCLUDES)

CXXFLAGS += @BOOST_CXXFLAGS@
LDFLAGS += @BOOST_REGEX_LIB@

CXXFLAGS += @GSL_CFLAGS@
LDFLAGS += @GSL_LIBS@

LDFLAGS += -Wl,-rpath,$(topdir)/lib -L$(topdir)/lib
LDFLAGS += -Wl,-rpath,$(topdir)/lib -L$(topdir)/lib -ltensor

TIBER_OBJECTS := $(shell find $(topdir)/src -name "*.$(obj-suffix)")


NON_TIBER_INCLUDES := $(INCLUDE) @GSL_CFLAGS@ @BOOST_CXXFLAGS@
NON_TIBER_INCLUDES := $(patsubst -I%,%,$(NON_TIBER_INCLUDES))


CPPFLAGS += $(TIBER_INCLUDES)
CPPFLAGS += $(patsubst %,-isystem %,$(NON_TIBER_INCLUDES))

vpath %.h $(foreach module,$(tibermodules), $(topdir)/include/$(module))

