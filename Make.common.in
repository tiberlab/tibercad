# $Id$

topdir := @abs_top_builddir@

# include common definitions
include $(topdir)/Make.defs


# libmesh can be found here
#libmesh_dir := @LIBMESH_PREFIX@
libmesh_config := @LIBMESH_CONFIG@

# gmsh
GMSH := @GMSH@


# TAO
TAO_DIR := @TAO_DIR@

# some handy defaults
#DIM := 2
#ORDER := 1


# the main TiberCAD library
TIBERLIBNAME := tibercad
export TIBERLIBNAME



# TIBERCAD includes
include_dirs := $(shell find $(topdir)/include -type d -a ! -path "*.svn*")
TIBER_INCLUDES := $(foreach dir,$(include_dirs),-I$(dir))



ifeq ($(target_os), linux)
  LDFLAGS := -Wl,-rpath,'$$ORIGIN:$$ORIGIN/../lib' -Wl,-rpath-link,$(libdir)
endif
ifeq ($(target_os), darwin)
  LDFLAGS := -Wl,-rpath,@loader_path/.. -Wl,-rpath,@loader_path/../extern
endif
LDFLAGS += -L$(libdir) 

TENSORLIB += -Wl,--whole-archive -L$(topdir)/src/utils/Tensor/$(ARCH) -ltensor -Wl,--no-whole-archive

LIBMESH_PETSC_LIBS = @LIBMESH_PETSC_LIBS@
LDFLAGS += $(LIBMESH_PETSC_LIBS)

BOOST_LIBS = @BOOST_REGEX_LIB@ @BOOST_FILESYSTEM_LIB@
LDFLAGS += $(BOOST_LIBS)

LDFLAGS += @LDFLAGS@

ifeq ($(build_modules),yes)
  TIBER_OBJECTS = $(shell find $(topdir)/src -name "*$(obj-suffix)" -a -path "*.${ARCH}/*" -a ! -path "*/src/tibercad/*" -a ! -path "*/src/utils/*" -a ! -path "*/src/core/modules/*" -a ! -path "*/src/SDK/*")
else
  TIBER_OBJECTS = $(shell find $(topdir)/src -name "*$(obj-suffix)" -a ! -path "*/src/tibercad/*" -a ! -path "*/src/utils/*" -a ! -path "*/src/SDK/*")
endif


INCLUDE  := $(shell export METHOD=$(LIBMESHMETHOD) && $(libmesh_config) --include) -I@LIBMESH_PREFIX@/include/libmesh -I@LIBMESH_PREFIX@/include
#INCLUDE  := -I@LIBMESH_PREFIX@/include/libmesh

NON_TIBER_INCLUDES := @BOOST_CPPFLAGS@ @TAO_INCLUDES@ $(INCLUDE) 

ifeq ($(have_mkl),yes)
 MKLROOT = @MKL_DIR@
 BLASLAPACK_LDFLAGS = @MKL_LIBS@
 BLASLAPACK_INCLUDE += -I@MKL_INCLUDEDIR@
endif

LDFLAGS += $(BLASLAPACK_LDFLAGS)
NON_TIBER_INCLUDES += $(BLASLAPACK_INCLUDE)

# TODO fortran compiler libraries
LDFLAGS += @FCLIBS@


ifeq ($(have_cuda),yes)
 LDFLAGS += @CUDA_LIBS@
 CUDA_INCLUDE = -I@CUDA_INCLUDEDIR@
endif

ifeq ($(target_os), linux)
 LDFLAGS += -ldl
endif


NON_TIBER_INCLUDES := $(patsubst -I%,%,$(NON_TIBER_INCLUDES))

# the machine architecture
CPPFLAGS += -DARCH=\"$(ARCH)\"

CPPFLAGS += -DMPICH_IGNORE_CXX_SEEK -DLIBMESH_REQUIRE_SEPARATE_NAMESPACE
CPPFLAGS += $(TIBER_INCLUDES)
CPPFLAGS += $(patsubst %,-isystem %,$(NON_TIBER_INCLUDES))

CXXFLAGS += $(shell METHOD=$(LIBMESHMETHOD) $(libmesh_config) --cxxflags) 
#LDFLAGS  += $(shell METHOD=$(LIBMESHMETHOD) $(libmesh_config) --ldflags) 

ifneq ($(target_os),win32)
  CXXFLAGS += -fPIC -pthread
  FCFLAGS  += -fPIC
  CFLAGS  += -fPIC

  ifeq ($(build_modules), yes)
    CXXFLAGS += -fvisibility=default -fvisibility-inlines-hidden
  endif
endif

vpath %.h $(include_dirs)


#
# source files
srcfiles := $(wildcard *.C)

#
# object files
objects	:= $(patsubst %.C, .$(ARCH)/%$(obj-suffix), $(srcfiles))
target := $(objects)


# for the following targets we set the target variable and go down
# into subdirectories (if defined)
.PHONY: all clean distclean 


# default target
all: all-recursive

