# $Id: Make.common.in 1207 2008-11-06 15:11:24Z gpenazzi $

#
# Common definitions for all Makefiles
#

topdir ?= @abs_top_builddir@

prefix := @prefix@
exec_prefix := @exec_prefix@
libdir := @libdir@

# use or not PARDISO
enable_pardiso := @ENABLE_PARDISO@

# do we have DFTB?
enable_dftb := @ENABLE_DFTB@

# do we have HETERO?
enable_hetero := @ENABLE_HETERO@

# do we have UPTIGHT?
enable_uptight := @ENABLE_UPTIGHT@

# do we have license checking?
enable_license_check := @LICENSE_CHECK@

# do we have MKL?
have_mkl := @HAVE_MKL@

# do we have CUDA toolkit
have_cuda := @HAVE_CUDA@


# The OS
hostos := @host_os@

# The architecture
hostcpu := @host_cpu@

target_os := linux
ifeq ($(findstring cygwin,$(hostos)),cygwin)
  target_os := win32
endif
ifeq ($(findstring mingw,$(hostos)),mingw)
  target_os := win32
endif
ifeq ($(findstring darwin,$(hostos)),darwin)
  target_os := darwin
endif

# we create an ARCH string which will be the same when calling
# arch.sh on the target system
ARCH := $(shell $(topdir)/share/arch.sh $(hostcpu)-$(hostos))
# the architecture of the build system (for cross compiling)
BUILD := $(shell $(topdir)/share/arch.sh)

# if we are cross compiling
cross_compiling := no
ifneq ($(ARCH), $(BUILD))
  cross_compiling := yes
endif

# the compilers
CXX := @CXX@
CC := @CC@
FC := @FC@
RANLIB := @RANLIB@

# the build_module tool: for cross compilation we need it compiled also
# for the BUILD architecture
BUILDMODULE := $(topdir)/bin/build_module -c $(topdir)/share/modules.conf
ifeq ($(cross_compiling), yes)
  BUILDMODULE := export TIBERCADROOT=$(topdir) && $(topdir)/bin/build_module-$(BUILD) -c $(topdir)/share/modules.conf
endif

SVN := @SVN@

# the subversion revision number
SVNREVISION = $(shell $(SVN) info $(topdir) | awk '/^Last Changed Rev/ {print $$4}')

# the full TiberCAD version number
TIBERVERSION = $(shell echo "`cat $(topdir)/VERSION`.$(SVNREVISION)")


# the default method is developer
ifeq (x$(METHOD),x)
  METHOD := dev
endif

LIBMESHMETHOD := $(METHOD)

ifeq ($(METHOD),dev)
  mode := "developer"
  LIBMESHMETHOD := opt
endif
ifeq ($(METHOD),opt)
  mode := "optimized"
endif
ifeq ($(METHOD),dbg)
  mode := "debug"
endif

# module library path
module_dir := $(topdir)/$(ARCH)/modules

# The file extension for object files.
# foo.C is compiled to foo.$(obj-suffix)
obj-suffix := .$(METHOD).o

# shared library directory
relative_libdir := lib
ifeq ($(METHOD),dbg)
  relative_libdir := $(relative_libdir)/debug
  module_dir := $(module_dir)/debug
endif
libdir := $(topdir)/$(ARCH)/$(relative_libdir)


# shared library extension
shared_libext := .so
dll_prefix := lib
ifeq ($(target_os),darwin)
  shared_libext := .dylib
else ifeq ($(target_os),win32)
  shared_libext := .dll
  dll_prefix := 
endif


CXXFLAGS = @CXXFLAGS@

ifdef PROFILE
  CXXFLAGS += -pg
endif

ifeq ($(METHOD),dev)
  FCFLAGS += -g
  CFLAGS += -g
  CXXFLAGS += -g
endif
ifeq ($(METHOD),dbg)
  FCFLAGS += -g
  CXXFLAGS += -Woverloaded-virtual
endif


CXXFLAGS += -DLIBMESH_REQUIRE_SEPARATE_NAMESPACE -std=gnu++17 -fopenmp
CFLAGS += -fopenmp
FCFLAGS += -fopenmp
#LDFLAGS += -fopenmp
