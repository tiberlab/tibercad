# $Id: Make.common.in 1207 2008-11-06 15:11:24Z gpenazzi $

#
# Common definitions for all Makefiles
#

topdir ?= @abs_top_builddir@

prefix := @prefix@
exec_prefix := @exec_prefix@
libdir := @libdir@

# The OS
hostos := @host_os@


# the compilers
CXX = @CXX@
CC = @CC@
FC = @FC@


# the subversion revision number
SVNREVISION = $(shell svn info $(topdir) | awk '/^Last Changed Rev/ {print $$4}')

# the full TiberCAD version number
TIBERVERSION = $(shell echo "`cat $(topdir)/VERSION`.$(SVNREVISION)")


# the default method is optimised
ifeq (x$(METHOD),x)
  METHOD := opt
endif

ifeq ($(METHOD),opt)
  mode := "optimized"
endif
ifeq ($(METHOD),dbg)
  mode := "debug"
endif

# build modules or not
build_modules := @BUILD_TIBER_MODULES@

# The file extension for object files.
# foo.C is compiled to foo.$(obj-suffix)
obj-suffix := .$(METHOD).o

# shared library directory
relative_libdir := lib
ifeq ($(METHOD),dbg)
  relative_libdir := $(relative_libdir)/debug
endif
libdir := $(topdir)/$(relative_libdir)


# shared library extension
shared_libext := .so
ifeq ($(findstring cygwin,$(hostos)),cygwin)
  shared_libext := .dll
endif

ifdef PROFILE
  CXXFLAGS += -pg
endif
ifeq ($(METHOD),dbg)
  FCFLAGS += -g
  CXXFLAGS += -Woverloaded-virtual
endif

