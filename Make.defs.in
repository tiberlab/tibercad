# $Id: Make.common.in 1207 2008-11-06 15:11:24Z gpenazzi $

#
# Common definitions for all Makefiles
#

topdir ?= @abs_top_builddir@

prefix := @prefix@
exec_prefix := @exec_prefix@
libdir := @libdir@

# The OS
hostos := @host_os@

# The architecture
hostcpu := @host_cpu@

target_os := linux
ifeq ($(findstring cygwin,$(hostos)),cygwin)
  target_os := win32
endif
ifeq ($(findstring mingw,$(hostos)),mingw)
  target_os := win32
endif
ifeq ($(findstring darwin,$(hostos)),darwin)
  target_os := darwin
endif

# we create an ARCH string which will be the same when calling
# arch.sh on the target system
ARCH := $(shell $(topdir)/share/arch.sh $(hostcpu)-$(hostos))
# the architecture of the build system (for cross compiling)
BUILD := $(shell $(topdir)/share/arch.sh)

# the compilers
CXX := @CXX@
CC := @CC@
FC := @FC@
RANLIB := @RANLIB@

SVN := @SVN@

# the subversion revision number
SVNREVISION = $(shell $(SVN) info $(topdir) | awk '/^Last Changed Rev/ {print $$4}')

# the full TiberCAD version number
TIBERVERSION = $(shell echo "`cat $(topdir)/VERSION`.$(SVNREVISION)")


# the default method is developer
ifeq (x$(METHOD),x)
  METHOD := dev
endif

LIBMESHMETHOD := $(METHOD)

ifeq ($(METHOD),dev)
  mode := "developer"
  LIBMESHMETHOD := opt
endif
ifeq ($(METHOD),opt)
  mode := "optimized"
endif
ifeq ($(METHOD),dbg)
  mode := "debug"
endif

# if we are cross compiling
cross_compiling := @cross_compiling@

# build modules or not
build_modules := @BUILD_TIBER_MODULES@
module_dir := $(topdir)/$(ARCH)/modules

# The file extension for object files.
# foo.C is compiled to foo.$(obj-suffix)
obj-suffix := .$(METHOD).o

# shared library directory
relative_libdir := lib
ifeq ($(METHOD),dbg)
  relative_libdir := $(relative_libdir)/debug
  module_dir := $(module_dir)/debug
endif
libdir := $(topdir)/$(ARCH)/$(relative_libdir)


# shared library extension
shared_libext := .so
dll_prefix := lib
ifeq ($(target_os),darwin)
  shared_libext := .dylib
else ifeq ($(target_os),win32)
  shared_libext := .dll
  dll_prefix := 
endif

ifdef PROFILE
  CXXFLAGS += -pg
endif

ifeq ($(METHOD),dev)
  FCFLAGS += -g
  CFLAGS += -g
  CXXFLAGS += -g
endif
ifeq ($(METHOD),dbg)
  FCFLAGS += -g
  CXXFLAGS += -Woverloaded-virtual
endif

