# Example 2: 1D Thermal simulation of a Si pn diode 

Device
{
  meshfile = tut_02.msh


  Region p_side 
  {
    material = Si

    Doping
    {
      Nd = 1e18
      type = acceptor
    }

    #   doping = 1e18 doping_type = acceptor
  }

  Region n_side 
  {
    material = Si

    Doping
    {
      Nd = 1e18
      type = donor
    }

    #   doping = 1e18 doping_type = donor
  }

}




Module driftdiffusion
{ 
  name = dd
  regions = all
      
  plot = (Ec, Ev, eQFermi, eDensity, eCurrentDensity, eMobility,
          hQFermi, hDensity, hCurrentDensity, hMobility,
          NetRecombination, ElField, ElPotential, ContactCurrents)

  Physics
  {

    particle_density
    {
      # use Fermi-Dirac statistics
      statistics = fermidirac
    }

    recombination srh {}

  }

  
  Contact  anode
  {
    type = ohmic
    voltage = $Vb[0.0]
  }

  Contact cathode
  {
    type = ohmic
    voltage = 0.0
  }
      
} 



Module thermal
{
 
  name = tt
  regions = all

  plot = (LatticeTemp, ThermalFlux, HeatSource, ThermCond,  MaxTemp)

  heat_source
  {

    model =  drift_diffusion_dissipation

    drift_diffusion_simulation = dd

  }


   
  Contact anode
  {
    type = heat_reservoir
    temperature = 300
  }
       
  Contact cathode
  {
    type = heat_reservoir
    temperature = 300
  }
     
}



Module sweep
{
  #  simulation = (dd, tt)
  solve = (dd, tt)
  variable = $Vb
  start = 0.0
  stop = 1.2
  steps = 12
}





Simulation
{
#  meshfile = tut_02.msh
  dimension = 1
  temperature = 300
  solve = sweep
  resultpath = output_tut2
  output_format = grace
#  plot = (Ec, Ev, QFermi_e, QFermi_h, eDensity, hDensity, eCurrent, hCurrent, CurrentDensity, eMob, hMob, ContactCurrents,NetRecombination,thermal)

}





