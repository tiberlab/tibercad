# Example 10: Quantum properties of a GaN conic Quantum Dot

Device
{
  meshfile = quantum_dot.msh 
  mesh_units = 1e-9

  structure = wz
 
  y-growth-direction = (-1,0,1,0)
  x-growth-direction = (-1,2,-1,0)   
  z-growth-direction = (0,0,0,1)

  Region qdot
  {

    material = GaN
  
    Doping
    {
      Nd = 1e15
      type = acceptor
      doping_level = 0.025

    }
   

  }

  Region  barrier #buffer
  {
  
    material = AlGaN
    x = 0.3


    Doping
    {
      Nd = 1e15
      type = acceptor
      doping_level = 0.025

    }
   
   
  }

  Region buffer1
  {
 
    material = AlGaN
    x = 0.3

    Doping
    {
      Nd = 1e15
      type = acceptor
      doping_level = 0.025

    }
 
   
  }
  
  Region  buffer2
  {

    material = AlGaN
    x = 0.3

   
    Doping
    {
      Nd = 1e15
      type = acceptor
      doping_level = 0.025

    }
      
  }


  Cluster Quantum_dot
  {
    regions = (qdot ,barrier )  
  }
  
}


  
Module macrostrain
{

         
  name = str
    
  substrate = substrate
  
  plot = (Strain, PiezoPolarization)
    
  Contact substrate
  {
    type = substrate
    material = AlGaN
    x = 0.3

    structure = wz

    y-growth-direction = (-1,0,1,0)
    x-growth-direction = (-1,2,-1,0)   
    z-growth-direction = (0,0,0,1)


  }
}

  




Module  driftdiffusion
{ 

  name = dd
  plot = (Polarization, Ec, Ev, eQFermi, hQFermi, ElField, eDensity, hDensity,
          CurrentDensity, ContactCurrent, eMobility, hMobility)
  coupling = poisson

  Solver
  {
    #nonlinear_solver = tiber
    nonlin_max_it = 15
    nonlin_rel_tol = 1e-12
 
    nonlin_step_tol = 1e-5
  
    ls_max_step = 4
  }
  



  Physics
  {
    strain_simulation = str
    
    recombination srh {}

    recombination direct
    { 
      
      C = 1.1e-8
   
    }  
   
    mobility doping_dependent {}
     
  }           




  Contact surface_states1
  {
     
    type = interface
    Ns = -1e10
 	
  }


  Contact    surface_states2
  {
   
    type = interface
    Ns = -1e10	
  }
 
   
 
}   





Module  efaschroedinger

{

   
  name = quantum_el
  regions = Quantum_dot 

  plot = (ProbabilityDensity, EigenEnergy, QuantumDensity)
   
  Dirichlet_bc_everywhere = true
  particle = el
  number_of_eigenstates = 5
  poisson_model_name = dd
  strain_model_name = macrostrain
#  convergent_density = true
  log_output = true
  
  solver = krylovshur 
   

   
  monitor = true
  ksp_type = bcgsl
  pc_type =  jacobi

  Physics
  {
    model = conduction_band    
  }


}



Module  efaschroedinger

{

   
  name = quantum_hl
  regions = Quantum_dot 

  plot = (ProbabilityDensity, EigenEnergy, QuantumDensity)

  Dirichlet_bc_everywhere = true
  particle = hl
  number_of_eigenstates = 8
  poisson_model_name = dd
  strain_model_name = macrostrain
  convergent_density = true
  log_output = true
  
  solver = krylovshur 
   

   
  monitor = true
  ksp_type = bcgsl
  pc_type =  jacobi

  Physics
  {

    particle = hl
    model = kp   #  k.p  for  valence  band
    kp_model = 6x6

   
  }


}




Simulation
{
 
  dimension = 3
  temperature = 300

  solve = (str, dd, quantum_el, quantum_hl )
 

  resultpath = output_2.0 #
  output_format = vtk
#  plot = (strain, polarization, Ec, Ev, QFermi_e, QFermi_h, EField , ElPotential,  EigenFunctions, EigenEnergy, EnergyLevels)
}
