# diode example

# Description of  the  device physical regions

#  n   n    i   p   p

#  2 - 3  - 1 - 4 - 5
$Device
{

  Region GaN_qdisc  # well
  {
  #  mesh_regions = 1
    material = GaN
  
    structure = wz
    x-growth-direction = (1,0,-1,0)
    y-growth-direction = (-1,2,-1,0)
    z-growth-direction = (0,0,0,1)	



   }
  

   Region  n_algan    # layer1
   {
#     mesh_regions = 2
     material = AlGaN
     x = 0.2
     structure = wz
     x-growth-direction = (1,0,-1,0)
     y-growth-direction = (-1,2,-1,0)
     z-growth-direction = (0,0,0,1)
     

     doping = 1e19 doping_type = donor doping_level = 0.025 g = 2
    
   
   }

  

   Region algan_barrier1  #barrier1
   {
  #   mesh_regions = 3
     material = AlGaN
     x = 0.2
     structure = wz
     x-growth-direction = (1,0,-1,0)
     y-growth-direction = (-1,2,-1,0)
     z-growth-direction = (0,0,0,1)


     doping = 1e15 doping_type = donor doping_level = 0.025 g = 2

   
   }


  

   Region algan_barrier2   # barrier2
   {
 #    mesh_regions = 4
     material = AlGaN
     x = 0.2
     structure = wz
     x-growth-direction = (1,0,-1,0)
     y-growth-direction = (-1,2,-1,0)
     z-growth-direction = (0,0,0,1)

   
     doping = 1e15 doping_type = donor doping_level = 0.025 g = 2

   }
   
   Region p_algan  #layer2
   {
  #   mesh_regions = 5
     material = AlGaN
     x = 0.2
     structure = wz

     x-growth-direction = (1,0,-1,0)
     y-growth-direction = (-1,2,-1,0)
     z-growth-direction = (0,0,0,1)

    
     doping = 1e19 doping_type = acceptor doping_level = 0.17 g = 4 

   }
   
   

}


# Definition of  Simulation Models  and associated Boundary Conditions 
$Models 
{#models 

  

  model macrostrain
  {

    options
    {          
      simulation_name = strain

      physical_regions = all
    }

    
    BC_Regions  
    {
      BC_Region ncontact   #subs # n_contact   #substrate
      {
   #     BC_reg_numb = ncontact  # 2
	type = substrate
	material = AlGaN
	x = 0.2
	structure = wz

	x-growth-direction = (1,0,-1,0)
	y-growth-direction = (-1,2,-1,0)
	z-growth-direction = (0,0,0,1)

      }
    }

  }


  model  driftdiffusion
  { 

    options
    {          
      simulation_name = dd
      
      physical_regions = all
    }

    physical_model recombination
    { 
      model = srh
     
    }                

    
    physical_model recombination
    { 
     model = direct
   
   
    }          
           
     

    physical_model electron_mobility
    { 
      model = field_dependent
      low_field_model = doping_dependent
     
    }                


    physical_model hole_mobility
    { 
      model = field_dependent
      low_field_model = doping_dependent
     
    }                


   BC_Regions  
    {

      BC_Region ncontact  # cathode
      {
     #   BC_reg_numb = 2


        type = ohmic

      }


      BC_Region p_contact  # anode
      {
#	BC_reg_numb = 1

	type = ohmic

	voltage = @bias
      }
 
    }   

  }


}  



# Definition of  Model-dependent Solver parameters
$Solver
{
 

 

  macrostrain
  {
    substrate = ncontact #substrate

 #   lin_rel_tol = 1e-5
    lin_rel_tol = 1e-6
    xmonitor = true
    
  }

 
  driftdiffusion
  {
#    nonlinear_solver = tiber
#    linear_solver = pardiso
    coupling = full
    nonlin_max_it = 15
    nonlin_rel_tol = 1e-12
    #nonlin_abs_tol = 1e-15
#    nonlin_step_tol = 1e-3
    nonlin_step_tol = 1e-6
  
    ls_max_step = 4
    integration_order = 5
  
  }


 sweep
 {
   simulation = dd
   variable = bias
   start = 0.0
   stop = 4.5 #5.0
   steps = 200 #20
   max_step = 0.5
   plotvariable = current
 #  plot_data = true
 }



  
}



# Definition of  Model dependent physical parameters
$Physics
{
  
  macrostrain
  {
  
  }

  driftdiffusion 
  {
#    strain_simulation = strain
    statistics = FD
  }
  

}


# Definition of  model-indipendent parameters of the Simulation
$Simulation
{
  searchpath = ../../materials  #../materials    
  meshfile = nanocolumn.msh # 
  mesh_units = 1e-9
  dimension = 3
  temperature = 300

  solve = (strain, sweep)
 #solve = (sweep)

  resultpath = output_nanocol_tecplot_tut_IV #   output_nanocol_tecplot
  output_format = ise # vtk
  plot = (strain, polarization,Ec, Ev, QFermi_e, QFermi_h, eMob, hMob, EigenFunctions, EigenEnergy, EnergyLevels, eDensity, hDensity, Current, eCurrent, hCurrent, ContactCurrents)
}





