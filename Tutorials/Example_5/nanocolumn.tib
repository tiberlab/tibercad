# Example 5: AlGaN nanocolumn with GaN quantum disk (3D simulation)


Device
{

  meshfile = nanocolumn.msh
  mesh_units = 1e-9
  dimension = 3

  structure = wz
  x-growth-direction = (1,0,-1,0)
  y-growth-direction = (-1,2,-1,0)
  z-growth-direction = (0,0,0,1)

 

  Region well
  {

    material = GaN
   
  }
  

  Region  layer1
  {
 
    material = AlGaN
    x = 0.2
   
    Doping
    {
      Nd = 1e19
      type = donor
      Ed = 0.025
      g=2
    }

      
  }

  

  Region barrier1
  {
 
    material = AlGaN
    x = 0.2

    Doping
    {
      Nd = 1e15
      type = donor
      Ed = 0.025
      g=2
    }
  
  }


  

  Region barrier2
  {

    material = AlGaN
    x = 0.2

    Doping
    {
      Nd = 1e15
      type = donor
      Ed = 0.025
      g=2
    }
 
  }
   
  Region layer2
  {

    material = AlGaN
    x = 0.2

    
    Doping
    {
      Nd = 1e19
      type = acceptor
      Ed = 0.17
      g=4
    }
    

  }
  
   

}



Module elasticity 
{

  name = strain
  regions = all

  plot = (Strain, StrainCell,Stress,Displacement )
  lin_rel_tol = 1e-6 

  Physics 
  {
    body_force lattice_mismatch 
    {
      reference_material = AlGaN
      x = 0.2
      structure = wz
      x-growth-direction = (1,0,-1,0)
      y-growth-direction = (-1,2,-1,0)
      z-growth-direction = (0,0,0,1)


     
    }
       
  }

  Contact substrate  
  {type = clamp}

}



Module   driftdiffusion
{ 
       
  name = dd

  plot = (ElPotential, ElField, Ec, Ev, eQFermi, hQFermi, eMobility, hMobility, eDensity, hDensity, CurrentDensity, eCurrentDensity, hCurrentDensity, ContactCurrents, NetRecombination, Polarization, Ec0, Ev0)

  Solver
  {

    nonlin_max_it = 15
    nonlin_rel_tol = 1e-12
    nonlin_step_tol = 1e-6
    ls_max_step = 4

  }

  Physics
  {

    strain_simulation = strain

    polarization (piezo, pyro) {}

    recombination srh {}

                 
    recombination direct {}
    
        
    mobility # for  both  el  and  hl
    {
      type = field_dependent
      low_field_model = doping_dependent
    }  

  }



  Contact  substrate  #cathode
  {
    type = ohmic
    rec_velocity_p = 1e9
  }


  Contact anode
  {

    type = ohmic

    voltage = $bias
    rec_velocity_n = 1e9
  }
  

}


Module  sweep
{
  solve = dd
  variable = $bias
  start = 0.0
  stop = 4.5 #5.0
  steps = 200 #20
  plot_data = true
}



  
Simulation
{
  temperature = 300
  verbose = 2

  solve = (strain, sweep)
  resultpath = output 
  output_format = vtk
}





