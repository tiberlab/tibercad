Device
{
  meshfile = testline.msh

   Region device
   {
     material = Air
     optical_epsilon = 4
   }

   Region pml
   {
     material = Air
     optical_epsilon = 1
     sPML = 12
   }

  mesh_units = 1
}

Module maxwell
{
  plot = (all)

  approxOrder = 2
  
  eigenCount = 40
  eigensOut = 10

  errorEstimate = 0
  
  Contact start {
    type = ElectricWall
  }
  
  Contact end {
    type = ElectricWall
  }
}

Simulation
{  
  temperature = 300
  solve = (maxwell)   
  resultpath = output
  output_format = vtk
}
