# nanocolumn LED example
Device nanocolumn
{
 
  meshfile = qdisk.msh 
  mesh_units = 1e-9

  material = AlGaN
  x = 0.28 
  x-growth-direction = (1,0,-1,0)
  y-growth-direction = (-1,2,-1,0)
  z-growth-direction = (0,0,0,1)


  Region well
  {
    material = GaN
  }
  

  Region n-side
  {
    Doping
    {
      density = 1e19
      type = donor
      level = 0.025
      g = 2
    }
  }

  Region barrier1
  {
  }

  Region barrier2
  {
  }
   
  Region p-side
  {
   Doping
   {
     density = 1e19
     type = acceptor
     level = 0.17
     g = 4
   }
  }


  Cluster quantum
  {
    regions=(well, barrier1, barrier2)
  }
   

}


# Definition of  Simulation Models

Module macrostrain
{

  name = strain
  substrate = cathode
  plot = (Strain, Stress)

  Boundary cathode
  {
    type = substrate
    material = AlGaN
    x = 0.28

    x-growth-direction = (1,0,-1,0)
    y-growth-direction = (-1,2,-1,0)
    z-growth-direction = (0,0,0,1)

  }
}


Module driftdiffusion
{ 

  name = dd
  plot = (Polarization, Ec, Ev, Eg, ElPotential, eQFermi, hQFermi,
          eMobility, hMobility, eDensity, hDensity,
          CurrentDensity, eCurrentDensity, hCurrentDensity,
          ContactCurrent)
      

  Physics
  {
    strain_simulation = strain

    polarization (piezo, pyro) {}

    particle_density
    {
      particle = electron
      # this is the default:
      # statistics = fermidirac

      # where to get the quantum density from
      quantum_density = quantum_el
    }

    particle_density
    {
      particle = hole
      # this is the default:
      # statistics = fermidirac

      # where to get the quantum density from
      quantum_density = quantum_hl  
    }

    recombination (srh, direct) {}

    
    mobility field_dependent
    { 
      low_field_model = doping_dependent
    }

  }               


  Contact cathode
  {
    type = ohmic
    rec_velocity_p = 1e9

    voltage = 0.0
  }


  Contact anode
  {
    type = ohmic
    rec_velocity_n = 1e9
	
    voltage = $bias
  }


}


Module efaschroedinger
{

  name = quantum_el
  regions = quantum 
  plot = (ProbabilityDensity, EigenEnergy, QuantumDensity)

  Dirichlet_bc_everywhere = true
  particle = el
  number_of_eigenstates = 10
  poisson_simulation = dd
  strain_simulation = macrostrain

  Physics 
  {
    model = conduction_band    
  }
}


Module efaschroedinger
{
  name = quantum_hl
  regions =  quantum
  plot = (ProbabilityDensity, EigenEnergy, QuantumDensity)

  particle = hl
  number_of_eigenstates = 80
  poisson_simulation = dd
  strain_simulation = macrostrain
    
  solver = arnoldi
  log_output = true
  
  Physics
  {
    particle = hl
    model = kp
    kp_model = 6x6
  }
}


Module opticskp
{
  name = optics
  regions =  quantum
  plot = (optical_spectrum_k_0)

  initial_state_model = quantum_el 
  final_state_model =   quantum_hl

  initial_eigenstates = (0, 9)
  final_eigenstates   = (0, 30)

  polarization =  (0, 0, 1)

  Emin = 3.0
  Emax  = 5.0
  dE = 0.001

}  




Module sweep
{
  solve = dd
  variable = $bias
  start = 0.0
  stop = 4.5
  steps = 90
  plot_data = true
}


  
# Definition of model-independent parameters of the Simulation
Simulation
{
  temperature = 300

  solve = (strain, sweep, quantum_el, quantum_hl, optics)

  resultpath = output 

  output_format = vtk
}





