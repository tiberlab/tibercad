# Example 7: Optical properties of AlGaN/GaN LED (1D)


# Description of  the  device physical regions
Device
{

  meshfile = led_spectrum.msh 
  mesh_units = 1e-9       #nm 


  y-growth-direction = (1,0,-1,0)
  z-growth-direction = (-1,2,-1,0)
  x-growth-direction = (0,0,0,1)


  Region n-algan  #n-AlGaN
  {
 

    material = AlGaN
    x=0.20

    Doping
    {
      density = 5e18
      type = donor
      level = 0.025
     
    }


  }

  Region alinn  # AlInN
  {
 
    material = AlInN
    x=0.78 

    Doping
    {
       density = 1e19 
       type = donor
       level = 0.025
     
    }
   
  }
   
 
  Region algan_barr1   # AlGaN_barrier1_no_quantum
  {

    material = AlGaN
    x = 0.2 
    
    Doping
    {
      density =   3e18
      type = donor
      level = 0.025
      
    }

    
  }


  Region AlGaN_barrier_quantum
  {
    
    mesh_regions = (algan_barr_quantum1, algan_barr_quantum2, algan_barr_quantum3)

    
    material = AlGaN
    x = 0.2 

    Doping
    {
      density =   3e18
      type = donor
      level = 0.025
     
    }

    
  }



  Region GaN_QWell
  {
    
    mesh_regions = (GaN_QW1, GaN_QW2, GaN_QW3)

    material = GaN

    Doping
    {
      density =   1e15  #  intrinsic 
      type = donor
      
    }
  
  }


  Region i_AlGaN1_quantum
  {
 
    material = AlGaN
    x = 0.2 

    Doping
    {
      density =   1e15  #  intrinsic 
      type = donor
       
    }

  }


  Region i_AlGaN2_noquantum
  {
 
    material = AlGaN
    x = 0.2 

    Doping
    {
      density =   1e15  #  intrinsic 
      type = donor
      
    }
    
  }


  Region p_AlGaN
  {
    material = AlGaN
    x = 0.250 

    Doping
    {
      density =  3e19
      type = acceptor
      level = 0.170     #p-doped Mg : Ea=170 meV   
      g = 4 

    }

  }
  

  Cluster Quantum_1
  {
    regions = (algan_barr_quantum1,GaN_QW1)       
  }

  Cluster Quantum_2
  {
    regions = (algan_barr_quantum2, GaN_QW2 )   
  }

  Cluster Quantum_3
  {
    regions = (algan_barr_quantum3,GaN_QW3, i_AlGaN1_quantum)  
  }


}





Module  driftdiffusion
{ 
 
  name = driftdiffusion

  regions = all


  plot = (Polarization, Ec, Ev, eQFermi, hQFermi, ElField, eDensity, hDensity,
          eCurrentDensity, hCurrentDensity, ContactCurrent, eMobility, hMobility)


  Physics
  {

    strain_simulation = strain

    polarization (piezo, pyro) {}

    recombination srh {}

    recombination direct 
    {
  
      C =  0.47e-10  #  GaN  

    }


  }

   
  Contact  n_contact
  {

    type = ohmic
    rec_velocity_p = 1e7
      
    voltage = 0.0

  }




  Contact  p_contact
  {

    type = ohmic
    rec_velocity_n = 1e7
      
    voltage = $Vb[0.0] 

  }


} 



Module elasticity 
{

  name = strain
  regions = all

  plot = (Strain, Stress, Displacement)

  Physics 
  {
    body_force lattice_mismatch 
    {
      reference_material = AlGaN
      x = 0.2
      y-growth-direction = (1,0,-1,0)
      z-growth-direction = (-1,2,-1,0)
      x-growth-direction = (0,0,0,1)
    }
       
  }

  Contact  n_contact  #substrate  
  {type = clamp}

}





# quantum simulations are done only on the third quantum well

Module efaschroedinger
{

  name = QW3_electrons
  regions = Quantum_3
  plot = (ProbabilityDensity, EigenEnergy)

  number_of_eigenstates = 20 

  particle = el

  poisson_simulation = driftdiffusion  #  potential from driftdiffusion 
  strain_simulation = strain

  Physics
  {
    model = conduction_band    
  }

}


Module efaschroedinger
{

  name = QW3_holes 
  regions = Quantum_3
  plot = (ProbabilityDensity, EigenEnergy)

  number_of_eigenstates = 20 

  particle = hl

  poisson_simulation = driftdiffusion  #  potential from driftdiffusion 
  strain_simulation = strain

  Physics
  {
    model = kp   #  k.p  for  valence  band
    kp_model = 6x6
  }

}





Module opticskp
{

  name = optics 

  regions = Quantum_3

  plot = optical_spectrum_k_0 


  initial_state_model = QW1_electrons
  final_state_model =   QW1_holes


  initial_eigenstates = (0, 19)
  final_eigenstates   = (0, 19)

  optical_matr_elem_model=optics

  polarization =  (0, 0, 1)

  Emin = 3.0
  Emax  = 5.0
  dE = 0.001



}


Module  opticalspectrum 
{

  name = spectrum 
  plot = optical_spectrum

  regions = Quantum_3

  k_space_dimension = 2
  k-space_basis = true
  k1 = (0, 0, 0.1)
  k2 = (0, 0.1, 0)

  refine_fraction =  0.30 #    1.0 for  uniform refinement 
  relative_accuracy =  0.05  #
  refine_k_space = true

  number_of_nodes = (4,4)  #  numb. of  elememts in k mesh, along x and y
  wedge = quarter
 
  optical_matr_elem_model=optics

  polarization =  (0, 0, 1)

  Emin = 3.0
  Emax  = 5.0
  dE = 0.001

 
}






Module sweep
{
  name = sweep
  solve = driftdiffusion

  variable = $Vb
  start = 0.0
  stop =  3.5 
  steps = 14
  max_step = 0.05
  plot_data = true
}

 


Simulation
{

  verbose = 3    
 
  temperature = 300 

  solve = (strain, sweep, QW1_electrons,QW1_holes, optics, spectrum)


  resultpath =   output
  output_format = grace

}





