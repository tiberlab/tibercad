#
# Example 19: Si pn solar cell 
#


Device solarcell
{
  meshfile = solarcell.msh 
  material = Si

  # mesh_units = 1e-9
 
  tRegion bulk
  {
    material = Si
  }

  Region n_side 
  {
    Doping
    {
    density = 1e18
     type = donor
    }
  }

  Region p_side 
  {
    Doping
    {
     density = 1e18
     type = acceptor
    }
  }

  tRegion p_contactlayer 
  {
    Doping
    {
     density = 1e19
     type = acceptor
    }
  }

}


# Definition of  Simulation Models  and associated Boundary Conditions 
Module driftdiffusion
{ 
  name = dd

  plot = (Ec, Ev, Eg, ElField, ElPotential, eQFermi, hQFermi, eDensity, hDensity,
          NetRecombination, eCurrentDensity, hCurrentDensity, CurrentDensity,
          ContactCurrent, eMobility, hMobility, IonizedDonors, IonizedAcceptors)

  #plot = (NetRecombination, eDensity, hDensity)

  Physics
  {
    # use a field dependent mobility model with the
    # gradient of the electrochem. potential as field
    # parameter
    tmobility field_dependent
    {
      low_field_model = doping_dependent 
    }

    mobility constant
    {
    }


    # use SRH and Auger recombination
    recombination srh
    {
      tau_n = 1e-6
      tau_p = 1e-6
    }

    tgeneration optical
    {
      generation = $gen
    }
  
  }

  Contact anode
  {
    type = ohmic
    #barrier = 0.2
    
    voltage = $Vb[0.0]
    #rec_velocity_n = 0
  }

  Contact cathode
  {
    type = ohmic
    #barrier = 0.2
    #band = v

    voltage = 0.0
    #rec_velocity_p = 0
  }

  
}


Module sweep
{
  name = generation
  variable = $gen
  solve = dd

  values = (0, 1e6, 1e9, 1e12, 1e15, 1e18, 1e21)
}

Module sweep
{
  name = for
  variable = $Vb
  solve = dd

  start = 0.0
  stop = 1.2
  steps = 60

  plot_data = true  # to write data for each step
}

Module sweep
{
  name = rev
  variable = $Vb
  solve = dd

  start = 1.2
  stop = 0.0
  steps = 60

  plot_data = true  # to write data for each step
}


Simulation
{
  verbose = 2

  temperature = 300

  solve = (for) #, generation, rev)

  resultpath = output
  output_format = grace

}





