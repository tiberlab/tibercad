# diode example

$Device
{
   

   Region p_side 
   {
     mesh_regions = 1
     material = Si
     doping = 1e18 doping_type = acceptor
   }

   Region n_side 
   {
     mesh_regions = 2
     material = Si
     doping = 1e18 doping_type = donor
   }

}


# Definition of  Simulation Models  and associated Boundary Conditions 
$Models
{ 
  model driftdiffusion
  { 
              
    options
    {
      simulation_name = dd
      physical_regions = all
    }

    
    physical_model electron_mobility
    {

      model = field_dependent

      low_field_model = doping_dependent   

    }

    physical_model hole_mobility
    {

      model = field_dependent

      low_field_model = doping_dependent

    } 

     physical_model recombination
     { 
       model  =  srh
     }               
 

    BC_Regions  
    {
      BC_Region anode
      {
        BC_reg_numb = 1
        type = ohmic
        voltage = @Vb[0.0]
      }

      BC_Region cathode
      {
        BC_reg_numb = 2
        type = ohmic
        voltage = 0.0
      }
 
    }   
  } 


  model thermal
  {

     options
    { 
      simulation_name = tt
      physical_regions = all
    }

    physical_model heat_source
    {

      model =  drift_diffusion_dissipation

      drift_diffusion_simulation = dd

    }

    BC_Regions
    {
        BC_Region reservoir_1
   	{
         type = heat_reservoir
         BC_reg_numb = 1
         temperature = 300
   	}
       
        BC_Region reservoir_2
   	{
	 type = heat_reservoir
         BC_reg_numb = 2
         temperature = 300
	}
     }
  
    
 

   }

}


# Definition of  Model-dependent Solver parameters
$Solver

{
  driftdiffusion
  {
    nonlin_rel_tol = 1e-12
    nonlin_step_tol = 1e-6
    nonlin_max_it = 30
    ls_max_step = 1
  }

  sweep
  {
    simulation = (dd,tt)
    variable = Vb
    start = 0.0
    stop = 1.2  
    steps = 20
    plot_data = true  
  }
}



# Definition of  Model dependent physical parameters
$Physics
{
  driftdiffusion 
  {
    model = unstrained

    statistics =  FD
  }


}


# Definition of  model-indipendent parameters of the Simulation


$Simulation
{
  searchpath = ../../materials/ 
  meshfile = tut_02.msh
  dimension = 1
  temperature = 300
  solve = sweep
  resultpath = output_tut_02
  output_format = grace

  plot = (Ec, Ev, QFermi_e, QFermi_h, eDensity, hDensity, eCurrent, hCurrent, Current, eMob, hMob, current,eSource,hSource,RecSource,ContactCurrents,NetRecombination,HeatSource,T)

}





