# Example 9: 3D thermal - drift-diffusion self-consistent simulation with cylindrical symmetry



Device
{
  
  meshfile = tut_09.msh
  dimension = 2
  

  Region n_side 
  {
    material  = Si

    Doping
    {
      Nd = 1e18
      type = donor 
     
    }
   
  }

  Region p_side 
  {
    material = Si

    Doping
    {
      Nd = 1e19
      type = acceptor 
    }

  }

  Region air
  {
    material = Air
  }
  
}



  
Module driftdiffusion
{ 
              
   
  name = dd
  regions = (n_side,p_side)

  #    statistics = FD
  thermal_simulation = tt

  plot = (Ec, Ev, eQFermi, hQFermi, eDensity, hDensity, eMobility, hMobility, NetRecombination, Pn, Pp, RecombHeat, ePeltier, hPeltier, eJoule, hJoule, ePowerFlux, hPowerFlux, ContactCurrents)

  Solver
  {
    nonlin_max_it = 25
    nonlin_step_tol = 1e-5
    ls_max_step = 2
  }
  
  Physics
  {

    recombination srh {}

    thermal_simulation = tt  


    mobility
    {
      model = doping_dependent
    }

  }
    

# thermoelectric_power   diffusivity_model {}
     
  Contact anode
  {
    type = ohmic
    voltage = $Vb[0.0]
  }

  Contact cathode
  {
    type = ohmic
    voltage = 0.0
  }
 
     
}  
  

Module thermal
{
  
  name = tt
  regions = all
  plot = (  LatticeTemp, ThermalFlux, HeatSource,ThermCond,MaxTemp)  #          all # (thermal)

    
  Physics
  {

    HeatSource joule

    {
      DD_simulation = dd
    }

     
  }

 
  Contact  reservoir
  {
    type = heat_reservoir 
    temperature = 300
  }
 
  Contact dissipator
  {
    r_surf = 0.5
    type = surface_resistance
    temperature = 300
  }
}



Module selfconsistent
{
  solve =(dd,tt)

  abs_tolerance = 1e-5
  monitor = true
}



Module  sweep
{
  solve = selfconsistent
  variable = $Vb
  start = 0.0
  stop = 1.2
  steps = 12
}



Simulation
{
  temperature = 300
  solve = sweep
  resultpath = output_tut9_2.0
  symmetry = cylindrical
  output_format = vtk
}





