# Example 9: 3D thermal - drift-diffusion self-consistent simulation with cylindrical symmetry



Device
{
  
  meshfile = tut_09.msh
  symmetry = cylindrical
  

  Region n_side 
  {
    material  = Si

    Doping
    {
      density = 1e18
      type = donor 
     
    }
   
  }

  Region p_side 
  {
    material = Si

    Doping
    {
      density = 1e19
      type = acceptor 
    }

  }

  Region air
  {
    material = Air
  }
  
}



  
Module driftdiffusion
{ 
              
   
  name = dd
  regions = (n_side, p_side)


  plot = (Ec, Ev, eQFermi, hQFermi, eDensity, hDensity,
          eMobility, hMobility, NetRecombination, Pn, Pp,
          RecombHeat, ePeltier, hPeltier, eJoule, hJoule,
          ePowerFlux, hPowerFlux, ContactCurrents)


  
  Physics
  {

    thermal_simulation = tt  

    recombination srh {}

    mobility
    {
      model = doping_dependent
    }
 
    thermoelectric_power diffusivity_model {}

  }
    

     
  Contact anode
  {
    type = ohmic
    voltage = $Vb[0.0]
  }

  Contact cathode
  {
    type = ohmic
    voltage = 0.0
  }
 
     
}  
  

Module thermal
{
  
  name = tt
  plot = (  LatticeTemp, ThermalFlux, HeatSource,ThermCond,MaxTemp)

    
  Physics
  {

    heat_source joule
    {
      transport_simulation = dd
    }

     
  }

 
  Contact  reservoir
  {
    type = heat_reservoir 
    temperature = 300
  }
 
  Contact dissipator
  {
    r_surf = 0.5
    type = surface_resistance
    temperature = 300
  }
}



Module selfconsistent
{
  solve = (dd,tt)

  absolute_tolerance = 0.5
  monitor = true
}



Module  sweep
{
  solve = selfconsistent
  variable = $Vb
  start = 0.0
  stop = 1.2
  steps = 12
}



Simulation
{
  temperature = 300
  solve = sweep
  resultpath = output
  output_format = vtk
}





