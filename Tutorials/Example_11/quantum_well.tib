Device
{

  meshfile = quantum_well.msh
  mesh_units = 1e-9

  material = AlGaAs
  x = 0.3


  Region well
  {
    material = GaAs

    Doping
    {
      Nd = 1e15
      type = donor
      Ed = 0.025
    }
  }

  Region  nside
  {
    Doping
    {
      Nd  = 1e18
      type = donor
      Ed = 0.025
    }
  }

  Region  pside
  {
    Doping
    {
      Nd  = 1e18
      type = acceptor
      Ed = 0.025
    }
  }
   
  

  Region  buffer
  {
    mesh_regions = (buffer_classical, buffer_quantum)

    Doping
    {
      Nd = 1e15
      type = donor
      Ed = 0.025
    }
  }


  Cluster quantum
  {
    regions = (well, buffer_quantum)
  }

  

}





Module macrostrain
{

  name = str
  substrate = cathode

  plot = (Strain, PiezoPolarization)

  Contact cathode
  {
    type = substrate
    material = GaAs
  }

} 


Module driftdiffusion
{ 

  name = dd

  plot = (Polarization, Ec, Ev, eQFermi, hQFermi, ElField, eDensity, hDensity,
          CurrentDensity, ContactCurrent, eMobility, hMobility)


  Physics
  {
    strain_simulation = str

    # we us a predictor corrector scheme for the selfconsistent loop
    use_density_predictor = true


    recombination srh {}

  
    particle_density
    { 
      particle = electron
      statistics = fermidirac

      # where to get the quantum density from
      quantum_density = dens_el

      # we use an embracing region to get a continuous transition from 
      # classical to quantum density
      embracing
      {
        embracing_length = 8e-9
        plot_embracing_regions = true
      }
    }

   
    particle_density
    { 
      particle = hole
      statistics = fermidirac

      # where to get the quantum density from
      quantum_density = dens_hl

      # we use an embracing region to get a continuous transition from 
      # classical to quantum density
      embracing
      {
        embracing_length = 8e-9
        plot_embracing_regions = true
      }
    }

  

    mobility doping_dependent {}

  }



  Contact cathode
  {
    rec_velocity_p = 1e7
  }


  Contact anode
  {
    rec_velocity_n = 1e7
    voltage = $Vb
  }
 
}


 


Module efaschroedinger
{

  name = quantum_el
  regions = quantum

  plot = (EigenFunctions, EigenEnergy, EnergyLevels)

  Dirichlet_bc_everywhere = true
  particle = el
  number_of_eigenstates = 22
  poisson_model_name = dd
  strain_model_name = macrostrain
  convergent_density = true
  #log_output = true
  #solve_problem_twice = true
  #solver = lapack
  #k_vector = (0,   0.00985844,    0.0223584)

  Physics
  {
    model = conduction_band    
  }

}


Module efaschroedinger
{

  name = quantum_hl
  regions = quantum

  plot = (EigenFunctions, EigenEnergy, EnergyLevels)

  Dirichlet_bc_everywhere = true
  particle = hl
  number_of_eigenstates = 22
  poisson_model_name = dd
  strain_model_name = macrostrain
  convergent_density = true
  #solver = lapack
  #log_output = true
  
  Physics
  {
    model = kp   #  k.p  for  valence  band
    kp_model = 6x6
  }

}
  

Module quantumdensity
{
  
  name = dens_el
  regions = quantum

  plot = quantum_density

  k_space_dimension = 2
  k-space_basis = true
  k1 = (0, 0, 0.1)
  k2 = (0, 0.1, 0)

  number_of_nodes = (4,4)
  wedge = quarter

  quantum_simulation = quantum_el

  degeneracy = 2
  refine_fraction = 0.20
  relative_accuracy = 0.01
  refine_k_space = true
  output_density_in_k_space = true
  uniform_refinement = false
  mesh_order = FIRST

  initial_eigenstates_number = 20
  analytic = true
}


Module quantumdensity
{

  name = dens_hl
  regions = quantum

  plot = quantum_density

  k_space_dimension = 2
  k-space_basis = true
  k1 = (0, 0, 0.1)
  k2 = (0, 0.1, 0)

  number_of_nodes = (4,4)
  wedge = quarter

  quantum_simulation = quantum_hl

  degeneracy = 1
  refine_fraction = 0.20
  relative_accuracy = 0.01
  refine_k_space = true
  output_density_in_k_space = true
  uniform_refinement = false
  mesh_order = FIRST

  initial_eigenstates_number = 20
  analytic = true
}

  


Module sweep
{
  solve = dd
  variable = $Vb
  start = 0.0
  stop =  1.8
  steps = 18
  plot_data = true
}



Module selfconsistent
{
  solve = (dens_el, dens_hl, dd)
  # we do not use relaxation, but a predictor-corrector scheme
  #relaxation_factor = 0.5
  max_iterations = 10
  abs_tolerance = 1e-4
  rel_tolerance = 1e-8
  monitor = true
  #xmonitor = true
}




Simulation
{
  verbose = 3

  #solve = (str, dd, quantum_el, quantum_hl, dens_el, dens_hl)
  solve = (str, sweep, selfconsistent)

  resultpath = output
  output_format = grace

}
