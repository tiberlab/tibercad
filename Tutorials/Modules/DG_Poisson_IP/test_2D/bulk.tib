
# Description of  the  device physical regions
Device
{
   meshfile = bulk2D.msh #bulk2D_ex.msh
   mesh_units = 1e-6

   Region bulk 
   {
     material = Si
     Doping {
       density = 1e16
       type = donor
     }
   }

}


Module poisson_example
{ 

  name = poisson
              
  plot = (Potential, ChargeDensity, ElField, Displacement)


  Physics
  {
  
    charge_density constant
    {
      charge_density = 0
    }

  }  

  Contact anode
  {
    type = dirichlet
    potential = $Va[1]
  }

  Contact cathode
  {
    type = dirichlet
    potential = 0.0
  }

 # Contact no_contact
 # {
  #  type = neumann
   # field = 1e2
 # }
}


Simulation
{
  verbose = 2

  # look here first for modules
  modellibpath = ..

  temperature = 300
  
  solve = poisson
  
  resultpath = output2D #output2D_ex
  output_format = vtk
}














