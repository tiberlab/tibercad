
# Description of  the  device physical regions
$Device
{
  Options
  {
    meshfile = bulk.msh
  }

   Region bulk 
   {
     material = Si
     doping = 1e16 doping_type = donor
   }

}


# Definition of  Simulation Models  and associated Boundary Conditions 
$Models
{ 

  model mypoisson
  { 
              
    options
    {
      plot = (Potential, Field, Displacement)
    }

    physical_model charge_density
    {
      type = constant
      charge_density = 1e19
    }


    BC_Regions  
    {
      BC_Region anode
      {
        type = dirichlet
        potential = @Va[0.1]
      }

      BC_Region cathode
      {
        type = dirichlet
        potential = 0.0
      }
    }

  }  

}

$Solver
{
}

# Definition of  model-indipendent parameters of the Simulation
$Simulation
{
  verbose = 2
  temperature = 300
  solve = mypoisson
  resultpath = output
  output_format = dat
}














