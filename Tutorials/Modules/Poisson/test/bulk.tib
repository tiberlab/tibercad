
# Description of  the  device physical regions
Device
{
   meshfile = bulk.msh

   Region bulk 
   {
     material = Si
     Doping {
       density = 1e16
       type = donor
     }
   }

}


Module poisson_example
{ 

  name = poisson
              
  plot = (Potential, ElField, Displacement)


  Physics
  {
  
    charge_density constant
    {
      charge_density = 0e19
    }

  }
  

  Contact anode
  {
    type = dirichlet
    potential = $Va[1]
  }

  Contact cathode
  {
    type = dirichlet
    potential = 0.0
  }
}


Simulation
{
  verbose = 2

  # look here first for modules
  modellibpath = ..

  temperature = 300
  
  solve = poisson
  
  resultpath = output
  output_format = dat
}














