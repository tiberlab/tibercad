#Example 8: 1D  Schroedinger-Poisson

Device
{

  meshfile = quantum_poisson.msh
  mesh_units = 1e-9

  Region well
  {
    material = GaAs

    Doping
    {
      Nd = 1e15
      type = donor
      Ed = 0.025
     
    }

  }

  Region  buffer1
  {
    mesh_regions  = ( barrier1_a,barrier1_q)
    material = AlGaAs
    x = 0.3

    Doping
    {
      Nd = 1e17
      type = donor
      Ed = 0.025
     
    }
 
  }
  
  

  Region  buffer2
  {
    mesh_regions  = (barrier2_a, barrier2_q  )
    material = AlGaAs
    x = 0.3

    Doping
    {
      Nd = 1e17
      type = donor
      Ed = 0.025
     
    }
 
  }

  Cluster Quantum_1
  {
    regions = (well ,barrier1_q, barrier2_q   )
  }

}





Module  macrostrain
{
           
  name = str

  regions = all

  substrate = substrate

  plot = (Strain, PiezoPolarization)


  Contact  substrate
  {

    type = substrate
    material = GaAs

  }
  
} 



Module  driftdiffusion
{ 
 
  name = dd

  regions = all
  coupling = poisson


  plot = (Polarization, Ec, Ev, eQFermi, hQFermi, ElField, eDensity, hDensity,
          CurrentDensity, ContactCurrent, eMobility, hMobility)

  Physics
  {
    strain_simulation = str

    # we us a predictor corrector scheme for the selfconsistent loop
    use_density_predictor = true


    recombination srh {}

    particle_density
    { 

      particle = electron
      statistics = fermidirac

      # where to get the quantum density from
      quantum_density =  quantum_el #   ex  dens_el
      #   statistics = FD
      barrier_regions = (buffer1,buffer2)
      
    }

  
    mobility doping_dependent {}

  }

}




Module efaschroedinger
{

  name = quantum_el
  regions = Quantum_1

  plot = (ProbabilityDensity, EigenEnergy, QuantumDensity)

  particle = el
  number_of_eigenstates = 22
  poisson_model_name = dd
  strain_model_name = macrostrain
  #solver = lapack


  Physics
  {
    model = conduction_band    
  }

}



Module selfconsistent
{

  name =  poisson_schroedinger
  solve = (quantum_el, dd)
  # we do not use relaxation, but a predictor-corrector scheme
  #relaxation_factor = 0.5
  max_iterations = 10
  absolute_tolerance = 1e-3  # 1e-4
  relative_tolerance = 1e-8  #  1e-6
  monitor = true
  #xmonitor = true
}


Simulation
{
  
  dimension = 1
  temperature = 300
  solve = (str, dd, poisson_schroedinger)
  resultpath = output_2.0
  output_format = grace

  #  plot = (strain, polarization, Ec, Ev, QFermi_e, QFermi_h, EField , eDensity, hDensity, EigenFunctions, EigenEnergy, EnergyLevels,quantum_density)

}
