
# Example 6: Quantized states in a Gan/AlGaN quantum  well (1D)

Device
{
  
  meshfile = quantum_well.msh
  mesh_units = 1e-9

  structure = wz
  y-growth-direction = (1,0,-1,0)
  z-growth-direction = (-1,2,-1,0)
  x-growth-direction = (0,0,0,1)


  Region well
  {
    material = GaN
    
    Doping
    {
      Nd = 1e18
      type = acceptor
      Ed = 0.025
     
    }
  
  }

  Region  buffer1
  {
    material = AlGaN
    x = 0.3

 
    Doping
    {
      Nd = 5e16
      type = acceptor
      Ed = 0.025
     
    }
   
     
  }
  
  

  Region  buffer2
  {
    material = AlGaN
    x = 0.3

   
    Doping
    {
      Nd = 5e16
      type = acceptor
      Ed = 0.025
     
    }
  
  }

}




Module  macrostrain
{
            
  name = str

  regions = all

  plot = (Strain, PiezoPolarization)
      
  substrate = substrate
   
  Contact substrate  #ALGANsubstrate
  {
    type = substrate
    material = AlGaN
    x = 0.3
    structure = wz
    y-growth-direction = (1,0,-1,0)
    z-growth-direction = (-1,2,-1,0)
    x-growth-direction = (0,0,0,1)

	
  }
    

} 


Module  driftdiffusion
{ 
        
  name = dd
      
  strain_simulation = str

  # we solve only Poisson equation
  coupling = poisson
     
  plot = (Ec, Ev, eQFermi, eDensity, eCurrentDensity, eMobility,
          hQFermi, hDensity, hCurrentDensity, hMobility,
          NetRecombination, ElField, ElPotential, ContactCurrents)

  Solver
  {

    nonlin_max_it = 70
    nonlin_rel_tol = 1e-10
    nonlin_abs_tol = 1e-10
    nonlin_step_tol = 1e-9
    ls_max_step = 4
    
    ksp_type = bcgs


  }

}


Module  efaschroedinger

{
  
  name = quantum_el
  regions = all

  plot = (ProbabilityDensity, EigenEnergy)

  Dirichlet_bc_everywhere = true
  particle = el
  number_of_eigenstates = 10
  poisson_simulation = dd
  strain_simulation  = macrostrain
 
  solution_method = general
  solver = krylovshur 


  Physics
  {
 model = conduction_band  

  #  model = kp  
 #   kp_model = 8x8
  }
  

}


Module  efaschroedinger

{
  name = quantum_hl
  regions = all

  plot = (ProbabilityDensity, EigenEnergy)

  
  Dirichlet_bc_everywhere = true
  particle = hl
  number_of_eigenstates = 15
  poisson_simulation  = dd
  strain_simulation = macrostrain

  solver = krylovshur
  solution_method = general

  Physics
  { 
    model = kp  
    kp_model = 6x6 # 8x8
  }

}
  

Module  quantumdispersion
{
   
  name = dispersion1D_el
  regions = all

  plot = ( k-space_dispersion)
   
  quantum_simulation = quantum_el
  wedge = half
  k_space_dimension = 1
  k1 = (0, 0.1, 0)
  number_of_nodes = (10)
  min_eigenvalue_number = 0
  max_eigenvalue_number = 1
    
}


Module quantumdispersion
{
   
  name = dispersion1D_hl
  regions = all

  plot = ( k-space_dispersion)

  quantum_simulation = quantum_hl
  wedge = half
  k_space_dimension = 1
  k1 = (0, 0.1, 0)
  number_of_nodes = (10)
  min_eigenvalue_number = 0
  max_eigenvalue_number = 1

    
}



Module quantumdispersion
{
   
  name = dispersion2D_el
  regions = all

  plot = ( k-space_dispersion)
  output_format = vtk

  quantum_simulation = quantum_el
  wedge = quarter
  k_space_dimension = 2
  k1 = (0,  0.1, 0)
  k2 = (0,  0, 0.1)
  number_of_nodes = (8,8)
  min_eigenvalue_number = 0
  max_eigenvalue_number = 1
    
    
}


Module quantumdispersion
{
   
  name = dispersion2D_hl
  regions = all

  plot = ( k-space_dispersion)

  output_format = vtk

  quantum_simulation = quantum_hl
  wedge = quarter
  k_space_dimension = 2
  k1 = (0, 0.1, 0)
  k2 = (0,  0, 0.1)
  number_of_nodes = (8,8)
  min_eigenvalue_number = 0
  max_eigenvalue_number = 3
   
    
}


 

Simulation
{  
  #searchpath =    ../../materials 
 
 
  dimension = 1
  temperature = 300
  solve = (str, dd, quantum_el, quantum_hl,  dispersion1D_el, dispersion1D_hl, dispersion2D_el, dispersion2D_hl )   
  resultpath = output_new
  output_format = grace
#  plot = (strain, polarization, Ec, Ev, EField , EigenEnergy, EnergyLevels, EigenFunctions, k-space_dispersion)
}
