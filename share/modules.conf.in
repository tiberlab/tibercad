Compiler
{

  path = @ROOT/SDK/@ARCH/bin:@ROOT/SDK/bin

  linker_flags = "-pthread -shared -Wl,-rpath,'$ORIGIN' -Wl,-rpath,'$ORIGIN/../lib'"

  C++
  {
    executable = mpicxx
    compiler_flags = "-g -O3 -std=gnu++0x -pthread -fPIC -c"
    # -fvisibility=hidden
  }

  C
  {
    executable = mpicc
  }

  Fortran
  {
    executable = mpif90
  }
}

Library tibercad
{
  # path relative to TIBERCADROOT,
  includes = (
    include/base/common,
    include/base/atomistic,
    include/base/common,
    include/base/database,
    include/base/io,
    include/base/math,
    include/base/simulations,
    include/pmi,
    include/core/models,
    include/core/tightbinding,
    include/core/semiconductormodels,
    include/core/macrostrain,
    include/core/embracing,
    include/core/solver-interfaces,
    include/core/solver-interfaces/petsc,
    include/core/quantumEFAmodels,
    include/core/optics,
    include/core/kintegrations,
    include/core/eigenvalue,
    include/utils/Tensor,
    include/utils/SLEPC
  )
  libpath = @ARCH/lib
  linker_flags = -ltibercad
}


Library boost
{
  includes = SDK/include
}


Library libmesh
{
  path = @ROOT/SDK
  includes = (include, include/libmesh, include/libmesh/@ARCH)
  libpath = @ROOT/SDK/@ARCH/lib
  linker_flags = -lmesh
}


Library petsc
{ 
  path = @ROOT/SDK
  includes = (include/petsc-3.6.2, include/petsc-3.6.2/@ARCH)
  libpath = @ROOT/SDK/@ARCH/lib
  linker_flags = -lpetsc_real
}

Library slepc
{
  path = @ROOT/SDK
  includes = (include/slepc-3.6.2, include/slepc-3.6.2/@ARCH)
  libpath = @ROOT/SDK/@ARCH/lib
  linker_flags = -lslepc_real
}

		
