Compiler
{

  linker_flags = "-pthread -shared -Wl,-rpath,'$ORIGIN' -Wl,-rpath,'$ORIGIN/../lib'"

  C++
  {
    executable = @CXX@
    compiler_flags = "-g -O3 -std=gnu++17 -pthread -fPIC -c"
    # -fvisibility=hidden
  }

  C
  {
    executable = @CC@
  }

  Fortran
  {
    executable = @FC@
  }
}

Library tibercad
{
  path = @ROOT
  includes = (@ROOT/tibercad-core/include,
    @ROOT/third-party/FADBAD++
  )
  libpath = @ARCH/lib
  linker_flags = -ltibercad
}




Library boost
{
  includes = @BOOST_PREFIX@/include
}


Library libmesh
{
  path = @LIBMESH_PREFIX@
  includes = (., libmesh, ../contrib/eigen/eigen, ../contrib/timpi/src/parallel/include, ../contrib/timpi/src/utilities/include, ../contrib/timpi/src/algorithms/include )
  libpath = @LIBMESH_PETSC_LIBDIR@
  linker_flags = -lmesh_@METHOD
}


Library petsc
{ 
  path = @PETSC_DIR@
  includes = (.,../@ARCH/include)
  libpath = @LIBMESH_PETSC_LIBDIR@
  linker_flags = -lpetsc_real
}

Library slepc
{
  path = @SLEPC_DIR@
  includes = (.)
  libpath = @LIBMESH_PETSC_LIBDIR@
  linker_flags = -lslepc_real
}


