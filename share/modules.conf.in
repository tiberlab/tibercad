Compiler
{

  linker_flags = "-pthread -shared -Wl,-rpath,'$ORIGIN' -Wl,-rpath,'$ORIGIN/../lib'"

  C++
  {
    executable = @CXX@
    compiler_flags = "-g -O3 -std=gnu++0x -pthread -fPIC -c"
    # -fvisibility=hidden
  }

  C
  {
    executable = SDK/compiler/@ARCH/bin/gcc
  }

  Fortran
  {
    executable = SDK/compiler/@ARCH/bin/gfortran
  }
}

Library tibercad
{
  # path relative to TIBERCADROOT,
  includes = (
    include/base/common,
    include/base/atomistic,
    include/base/common,
    include/base/database,
    include/base/io,
    include/base/math,
    include/base/simulations,
    include/pmi,
    include/core/models,
    include/core/tightbinding,
    include/core/semiconductormodels,
    include/core/macrostrain,
    include/core/embracing,
    include/core/solver-interfaces,
    include/core/solver-interfaces/petsc,
    include/core/quantumEFAmodels,
    include/core/optics,
    include/core/kintegrations,
    include/core/eigenvalue,
    include/utils/Tensor,
    include/utils/SLEPC,
    include/utils/FADBAD++
  )
  libpath = @ARCH/lib
  linker_flags = -ltibercad
}


Library boost
{
  includes = @LIBMESH_PETSC_LIBDIR@/../../include
}


Library libmesh
{
  path = @LIBMESH_PREFIX@
  includes = (include/base, include/error_estimation,
              include/geom, include/numerics, include/partitioning,
              include/solvers, include/utils, include/enums,
              include/fe, include/mesh, include/parallel,
              include/quadrature, include/systems)
  libpath = @LIBMESH_PETSC_LIBDIR@
  linker_flags = -lmesh
}


Library petsc
{ 
  path = @LIBMESH_PREFIX@/../petsc-3.0.0-p12
  includes = (include, include/mpiuni, @ARCH/include)
  libpath = @LIBMESH_PETSC_LIBDIR@
  linker_flags = -lpetsc_real
}

Library slepc
{
  path = @LIBMESH_PREFIX@/../slepc-3.0.0-p7
  includes = (include, @ARCH/include)
  libpath = @LIBMESH_PETSC_LIBDIR@
  linker_flags = -lslepc_real
}

		
